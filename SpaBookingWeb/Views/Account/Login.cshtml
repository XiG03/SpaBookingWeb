@model SpaBookingWeb.ViewModels.LoginViewModels
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - Spa &amp; Salon</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <style>
        /* Sửa lại @@import */
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap');
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#ff94c2",
                        "background-light": "#fff5f7",
                        "background-dark": "#1f1014",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    },
                    borderRadius: {"DEFAULT": "0.5rem", "lg": "1rem", "xl": "1.5rem", "full": "9999px"},
                },
            },
        }
    </script>
    <style type="text/tailwindcss">
        /* CSS cho Tab active */
        .tab-btn.active {
            @@apply bg-white text-[#29181d] shadow-sm dark:bg-[#4a2c35] dark:text-white;
        }
        /* Ẩn hiện form */
        .form-container.hidden {
            display: none;
        }
        .form-container.block {
            display: block;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark font-display flex flex-col min-h-screen">

    <header class="w-full border-b border-[#fceef5] dark:border-[#331d23] bg-white dark:bg-[#1f1014] px-6 py-4 md:px-10 lg:px-40 sticky top-0 z-50">
        <div class="flex items-center justify-between">
            <a class="flex items-center gap-3 text-[#29181d] dark:text-white group" href="/">
                <div class="size-8 flex items-center justify-center text-primary group-hover:scale-110 transition-transform">
                    <span class="material-symbols-outlined text-3xl">spa</span>
                </div>
                <h2 class="text-xl font-bold leading-tight tracking-[-0.015em]">Spa &amp; Salon</h2>
            </a>
            <div class="flex items-center gap-6">
                <span class="hidden md:block text-sm font-medium text-[#8a6d75]">Don't have an account?</span>
                <a class="flex min-w-[84px] cursor-pointer items-center justify-center overflow-hidden rounded-xl h-10 px-4 bg-transparent border border-[#ebdbe0] dark:border-[#4a2c35] hover:bg-[#fceef5] dark:hover:bg-[#331d23] text-[#29181d] dark:text-white text-sm font-bold leading-normal transition-colors" asp-action="Register">
                    <span class="truncate">Register</span>
                </a>
            </div>
        </div>
    </header>

    <main class="flex-grow flex items-center justify-center p-4 md:p-8">
        <div class="w-full max-w-[1100px] bg-white dark:bg-[#1f1014] rounded-3xl shadow-xl overflow-hidden border border-[#fceef5] dark:border-[#331d23] flex flex-col md:flex-row min-h-[650px]">
            <!-- Left Banner -->
            <div class="hidden md:flex w-1/2 relative flex-col justify-end p-10 bg-cover bg-center" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCGapK66eFEzrPZFJQVXP_l0i9qGHfLXsaozxcuFLcS92GmMcjuNisWaEs29JkdzCMaMKfP53ojgA8PhKxN8C5_1mvENekb0RWh6ixB__U5YtVecKUNNy1pPokxopxcFQRF-_IQvLz5c3yCReH7jYLwrCspn5lJA08ZGdtVZohv4ak9Wq4MCBZ1NC1QCLPmXp-tbBhH0fxyySzuYnyiHtGTPmA1IXU0xQl-SJDJEpPDM_4cWjuFgcrW0BKwMw21O_YcPfvFgHvKvUc');">
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
                <div class="relative z-10 text-white">
                    <h2 class="text-3xl font-black mb-3">Natural Beauty & Absolute Relaxation</h2>
                    <p class="text-white/90 text-sm font-medium leading-relaxed max-w-sm">
                        Book today to experience our exclusive beauty combos and premium care products.
                    </p>
                </div>
            </div>

            <!-- Right Content -->
            <div class="w-full md:w-1/2 flex flex-col justify-center p-8 md:p-12 lg:p-16">
                <div class="max-w-[400px] mx-auto w-full relative">
                    
                    <div class="mb-6">
                        <h1 class="text-[#29181d] dark:text-white text-3xl font-black leading-tight tracking-[-0.033em] mb-2">
                            Login
                        </h1>
                        <p class="text-[#8a6d75] text-sm font-medium">
                            Welcome to Spa & Salon
                        </p>
                    </div>

                    <!-- Hiển thị lỗi chung -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="mb-4 p-3 rounded-lg bg-red-50 text-red-500 text-sm font-medium border border-red-100">
                            @Html.ValidationSummary(false)
                        </div>
                    }

                    <!-- SINGLE LOGIN FORM -->
                    <div id="login-form" class="form-container block">
                        <form asp-action="Login" method="post" class="flex flex-col gap-5">
                            <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />

                            <div class="flex flex-col gap-2">
                                <label class="text-[#29181d] dark:text-white text-sm font-bold leading-normal" asp-for="Email">Email</label>
                                <div class="relative flex items-center">
                                    <span class="material-symbols-outlined absolute left-4 text-[#8a6d75] pointer-events-none" style="font-size: 20px;">mail</span>
                                    <input asp-for="Email" class="form-input flex w-full rounded-xl border border-[#ebdbe0] dark:border-[#4a2c35] bg-[#fffbfd] dark:bg-[#331d23] h-12 pl-11 pr-4 text-base text-[#29181d] dark:text-white placeholder:text-[#8a6d75]/70 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="name@example.com" />
                                </div>
                            </div>

                            <div class="flex flex-col gap-2">
                                <div class="flex justify-between items-center">
                                    <label class="text-[#29181d] dark:text-white text-sm font-bold leading-normal" asp-for="Password">Password</label>
                                    <a class="text-xs font-bold text-primary hover:text-[#d63384] transition-colors" asp-action="ForgotPassword">Forgot Password?</a>
                                </div>
                                <div class="relative flex items-center">
                                    <span class="material-symbols-outlined absolute left-4 text-[#8a6d75] pointer-events-none" style="font-size: 20px;">lock</span>
                                    <input asp-for="Password" type="password" class="form-input flex w-full rounded-xl border border-[#ebdbe0] dark:border-[#4a2c35] bg-[#fffbfd] dark:bg-[#331d23] h-12 pl-11 pr-11 text-base text-[#29181d] dark:text-white placeholder:text-[#8a6d75]/70 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="Enter password" />
                                    <button class="absolute right-0 top-0 h-full px-3 flex items-center justify-center text-[#8a6d75] hover:text-[#29181d] dark:hover:text-white transition-colors" type="button" onclick="togglePassword(this)">
                                        <span class="material-symbols-outlined" style="font-size: 20px;">visibility</span>
                                    </button>
                                </div>
                            </div>

                            <button type="submit" class="mt-4 flex w-full cursor-pointer items-center justify-center overflow-hidden rounded-xl h-12 px-5 bg-primary hover:bg-[#ff7eb5] active:bg-[#ff69a9] text-[#29181d] text-base font-bold leading-normal tracking-[0.015em] transition-all shadow-sm hover:shadow-md">
                                <span class="truncate">Login</span>
                            </button>
                        </form>
                    </div>

                    <!-- Social Section -->
                    <div id="social-section" class="social-section block">
                        <div class="relative flex items-center py-6">
                            <div class="flex-grow border-t border-[#ebdbe0] dark:border-[#4a2c35]"></div>
                            <span class="flex-shrink-0 mx-4 text-xs font-medium text-[#8a6d75]">Or login with</span>
                            <div class="flex-grow border-t border-[#ebdbe0] dark:border-[#4a2c35]"></div>
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <form asp-action="ExternalLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="contents">
                                @Html.AntiForgeryToken()
                                <button type="submit" name="provider" value="Google" class="flex items-center justify-center gap-2 h-11 px-4 border border-[#ebdbe0] dark:border-[#4a2c35] rounded-xl bg-white dark:bg-[#331d23] hover:bg-gray-50 dark:hover:bg-[#3d242a] transition-colors">
                                    <svg class="w-5 h-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
                                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
                                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"></path>
                                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path>
                                    </svg>
                                    <span class="text-sm font-semibold text-[#29181d] dark:text-white">Google</span>
                                </button>
                                <button type="submit" name="provider" value="Facebook" class="flex items-center justify-center gap-2 h-11 px-4 border border-[#ebdbe0] dark:border-[#4a2c35] rounded-xl bg-white dark:bg-[#331d23] hover:bg-gray-50 dark:hover:bg-[#3d242a] transition-colors">
                                    <svg class="w-5 h-5 text-[#1877F2]" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
                                    </svg>
                                    <span class="text-sm font-semibold text-[#29181d] dark:text-white">Facebook</span>
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="mt-8 text-center md:hidden">
                        <span class="text-sm text-[#8a6d75]">Don't have an account? </span>
                        <a class="text-sm font-bold text-primary" asp-action="Register">Register now</a>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <footer class="py-6 text-center text-[#8a6d75] text-xs">
        <p>© 2024 Spa &amp; Salon. All rights reserved.</p>
    </footer>

    <script>
                staffForm.classList.add('hidden');
                socialSection.style.display = 'block';

                // Update trạng thái nút
                tabCustomer.classList.add('active');
                tabStaff.classList.remove('active');
            } else {
                // Hiển thị form nhân viên
                staffForm.classList.remove('hidden');
                staffForm.classList.add('block');
                customerForm.classList.remove('block');
                customerForm.classList.add('hidden');
                socialSection.style.display = 'none';

                // Update trạng thái nút
                tabStaff.classList.add('active');
                tabCustomer.classList.remove('active');
            }
        }

        // Logic toggle password
        function togglePassword(btn) {
            const input = btn.previousElementSibling;
            if (input.type === "password") {
                input.type = "text";
                btn.querySelector('span').innerText = "visibility_off";
            } else {
                input.type = "password";
                btn.querySelector('span').innerText = "visibility";
            }
        }

        // Set tab mặc định dựa trên Model (để giữ trạng thái nếu có lỗi server trả về)
        document.addEventListener('DOMContentLoaded', () => {
            const isStaff = '@(Model?.LoginType == "Staff" ? "true" : "false")' === 'true';
            if (isStaff) {
                switchTab('Staff');
            } else {
                switchTab('Customer');
            }
        });
    </script>
</body>
</html>