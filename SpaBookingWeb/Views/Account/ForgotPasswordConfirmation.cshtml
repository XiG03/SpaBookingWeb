
@{
    ViewData["Title"] = "Xác nhận gửi email";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="flex items-center justify-center min-h-[600px] py-10 px-4">
    <div class="w-full max-w-md bg-white dark:bg-[#1f1014] rounded-3xl shadow-xl border border-pink-100 dark:border-pink-900 overflow-hidden p-8">
        <div class="text-center mb-6">
            <div class="mx-auto w-16 h-16 bg-pink-100 dark:bg-pink-900 rounded-full flex items-center justify-center mb-4">
                <span class="material-symbols-outlined text-primary text-3xl">mark_email_read</span>
            </div>
            <h1 class="text-2xl font-black text-gray-900 dark:text-white mb-4">Vui lòng kiểm tra Email!</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed text-justify mb-6">
                Nếu địa chỉ email bạn nhập tồn tại trong hệ thống, chúng tôi đã gửi một mật khẩu tạm thời đến đó.
                <br><br>
                Vui lòng kiểm tra hộp thư của bạn (bao gồm cả thư mục Spam hoặc Quảng cáo) để lấy mật khẩu.
            </p>
            
            <a asp-action="Login" class="flex w-full items-center justify-center rounded-xl h-12 px-6 bg-primary hover:bg-primary-dark text-white text-base font-bold transition-all shadow-md shadow-pink-200 dark:shadow-none">
                Quay lại trang Đăng nhập
            </a>
        </div>
    </div>
</div>

