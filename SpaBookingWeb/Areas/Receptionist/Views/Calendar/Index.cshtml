    // === LOGIC HỦY & DỜI LỊCH (24H RULE) ===

    // Hàm tiện ích: Tính số giờ còn lại đến lúc hẹn
    function getHoursUntilAppt(dateStr) {
        // dateStr dạng "yyyy-MM-dd HH:mm:ss" từ C# trả về
        // Chuyển đổi chuỗi thành Date object
        // Lưu ý: Safari trên iOS kén định dạng này, nên thay ' ' thành 'T' cho chuẩn ISO
        const isoStr = dateStr.replace(' ', 'T');
        const apptDate = new Date(isoStr);
        const now = new Date();

        const diffMs = apptDate - now; // Miliseconds
        return diffMs / (1000 * 60 * 60); // Đổi sang giờ
    }

    // 1. XỬ LÝ HỦY LỊCH
    async function checkCancelRule(id, dateStr) {
        const hours = getHoursUntilAppt(dateStr);
        const isViolation = hours < 24;

        // Nội dung cảnh báo động
        let confirmMsg = "";
        if (isViolation) {
            confirmMsg = "⚠️ CẢNH BÁO VI PHẠM (Dưới 24h)\n\nKhách hủy quá sát giờ. Theo quy định, tiền cọc (nếu có) sẽ KHÔNG được hoàn lại.\n\nBạn có chắc chắn muốn HỦY lịch hẹn này không?";
        } else {
            confirmMsg = "✅ HỦY HỢP LỆ (Trên 24h)\n\nBạn có thể hoàn lại tiền cọc cho khách theo quy định.\n\nXác nhận hủy lịch hẹn?";
        }

		// [THAY ĐỔI] confirm -> showConfirm sweetalert
        if (!await showConfirm(confirmMsg)) return;

		// [THAY ĐỔI] prompt -> showPrompt sweetalert
        const reason = await showPrompt("Nhập lý do hủy (Bắt buộc):");
        if (reason === null) return; // Người dùng ấn Hủy
        if (!reason.trim()) {
            await showWarning("Phải nhập lý do mới được hủy!"); // [THAY ĐỔI]
            return;
        }

        try {
            // Gọi API
            const res = await fetch(`/Receptionist/Calendar/CancelAppointment?id=${id}&reason=${encodeURIComponent(reason)}`, { method: 'POST' });
            const data = await res.json();
            if(data.success) {
				await showSuccess("Đã hủy lịch thành công!"); // [THAY ĐỔI] dùng sweetalert
                window.location.reload();
            } else {
				await showError(data.message); // [THAY ĐỔI] dùng sweetalert
            }
        } catch(e) { await showError(data.message); } // [THAY ĐỔI] dùng sweetalert
    }

    // 2. XỬ LÝ DỜI LỊCH
    // [THAY ĐỔI] Thêm async
    async function checkRescheduleRule(id, dateStr, duration) {
        const hours = getHoursUntilAppt(dateStr);

        // Code nghiệp vụ thật đây: Chặn nếu dưới 24h
        if (hours < 24) {
			// [THAY ĐỔI] alert -> showWarning (hoặc showError) sweetalert
            await showError("⛔ KHÔNG THỂ DỜI LỊCH!\n\nLịch hẹn chỉ còn " + hours.toFixed(1) + " giờ nữa là bắt đầu (Dưới 24h).\n\nHệ thống không cho phép dời lịch để tránh trống lịch KTV.\nVui lòng chọn HỦY (Mất cọc) nếu khách không thể đến.");
            return;
        }

        // Nếu hợp lệ (> 24h) -> Mở modal
        openRescheduleModal(id, duration);
    }

