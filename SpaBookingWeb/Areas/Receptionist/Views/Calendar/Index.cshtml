    // === HÀM CỐT LÕI: TÍNH TOÁN & LỌC (V3) ===
    function updateRescheduleAvailability() {
        const dateVal = document.getElementById('reschDate').value;
        const timeVal = document.getElementById('reschTime').value;

        const errorDiv = document.getElementById('reschTimeError');
        const saveBtn = document.querySelector('#rescheduleModal button.bg-orange-600'); // Nút Lưu thay đổi

        if (!dateVal || !timeVal) return;

        // GỌI HÀM KIỂM TRA
        const check = validateDateTimeRule(dateVal, timeVal);

        if (!check.valid) {
            // A. Nếu lỗi: Hiện thông báo & Khóa nút
            errorDiv.innerText = check.msg;
            errorDiv.classList.remove('hidden');
            saveBtn.disabled = true;
            saveBtn.classList.add('opacity-50', 'cursor-not-allowed');

            // Xóa danh sách KTV để không cho chọn
            document.querySelectorAll('.resch-tech-select').forEach(s => s.innerHTML = '<option>⛔ Giờ không hợp lệ</option>');
            return; // DỪNG LUÔN, KHÔNG CHẠY TÍNH TOÁN DƯỚI NỮA
        } else {
            // B. Nếu đúng: Ẩn lỗi & Mở nút
            errorDiv.classList.add('hidden');
            saveBtn.disabled = false;
            saveBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        }

        // 1. TÍNH TOÁN GIỜ TUẦN TỰ (Sequential Time Logic)
        // Gom nhóm theo khách để tính giờ nối tiếp
        let guestCursors = {}; // Map: "Tên khách" -> Thời gian kết thúc dịch vụ trước đó

        // Thời gian bắt đầu chung (Global)
        const [h, m] = timeVal.split(':').map(Number);
        const globalStart = new Date(`${dateVal}T${timeVal}:00`);

        const rows = document.querySelectorAll('.resch-row');

        // Mảng lưu tạm các KTV đã được gán "tạm" trong phiên tính toán này (để tránh trùng cục bộ)
        let assignedTechsLocal = []; // [{techId, start, end}]

        rows.forEach((row, idx) => {
            const item = currentRescheduleItems[idx];
            const guestKey = item.guestName || "Main";

            // Xác định giờ bắt đầu cho dịch vụ này
            let myStart = new Date(globalStart); // Mặc định là giờ chung

            // Nếu khách này đã có dịch vụ trước đó -> Nối tiếp đuôi
            if (guestCursors[guestKey]) {
                myStart = new Date(guestCursors[guestKey]);
            }

            // Tính giờ kết thúc
            let myEnd = new Date(myStart.getTime() + item.duration * 60000);

            // Cập nhật con trỏ thời gian cho khách này
            guestCursors[guestKey] = myEnd;

            // Hiển thị ra UI (Cột Thời lượng)
            const timeStr = `${formatTime(myStart)} - ${formatTime(myEnd)}`;
            row.querySelector('.time-range').innerText = timeStr;

            // --- 2. LỌC KTV (3 LỚP) ---
            const select = row.querySelector('.resch-tech-select');
            const originalTechId = parseInt(select.dataset.originalTech);
            const serviceId = parseInt(select.dataset.serviceId); // ID dịch vụ để check skill

            let optionsHtml = "";
            let autoSelectId = null;

            // Duyệt danh sách tất cả KTV
            (currentRescheduleTechs || []).forEach(tech => {
                let isDisabled = false;
                let note = "";

                // LỚP 1: CHECK KỸ NĂNG (Skill)
                // Nếu KTV có danh sách kỹ năng và KHÔNG chứa serviceId này -> Ẩn
                if (tech.AllowedServiceIds && tech.AllowedServiceIds.length > 0) {
                     // Lưu ý: serviceId có thể null nếu là Combo, ta tạm bỏ qua check nếu null
                     if (serviceId && !tech.AllowedServiceIds.includes(serviceId)) {
                         return; // Bỏ qua, không render người này luôn
                     }
                }

                // LỚP 2: CHECK LỊCH DATABASE (Shift & Events)
                // Convert time sang phút trong ngày để so sánh Shift
                const startMin = myStart.getHours()*60 + myStart.getMinutes();
                const endMin = myEnd.getHours()*60 + myEnd.getMinutes();

                if (tech.ShiftStartMinutes === 0) { isDisabled = true; note = "(Nghỉ)"; }
                else if (startMin < tech.ShiftStartMinutes || endMin > tech.ShiftEndMinutes) { isDisabled = true; note = "(Hết ca)"; }

                // [THÊM MỚI] CHECK GIỜ NGHỈ (EARLY BREAK)
                // Nếu chưa bị disable bởi Shift thì mới check tiếp Break
                if (!isDisabled && tech.IsOnBreak && tech.BreakStartMinutes > 0) {
                     if (endMin > tech.BreakStartMinutes) {
                         isDisabled = true;
                         // Tính giờ nghỉ ra chuỗi để hiển thị cho rõ (VD: 14:30)
                         const h = Math.floor(tech.BreakStartMinutes / 60);
                         const m = tech.BreakStartMinutes % 60;
                         const timeStr = `${h.toString().padStart(2,'0')}:${m.toString().padStart(2,'0')}`;

                         note = `(Nghỉ từ ${timeStr})`;
                     }
                }

                if (!isDisabled) {
                    const currentApptId = parseInt(document.getElementById('reschApptId').value);
                    const isBusyDB = (currentRescheduleEvents || []).some(evt => {
                        if (evt.TechnicianId !== tech.Id) return false;
                        const evtApptId = evt.AppointmentId || evt.appointmentId;
                        if (evtApptId === currentApptId) return false; // Trừ lịch cũ của chính nó
                        // 2. BỎ QUA NẾU ĐÃ HOÀN THÀNH (Cho phép đè lên lịch sử)
                        // (Lưu ý: evt.Status có thể viết hoa hoặc thường tùy API, nên check cả 2 hoặc log ra xem)
                        const status = evt.Status || evt.status;
                        if (status === 'Completed') return false;
                        const evtStart = new Date(evt.StartTime);
                        const evtEnd = new Date(evt.EndTime);
                        return (myStart < evtEnd && evtStart < myEnd); // Check overlap
                    });
                    if (isBusyDB) { isDisabled = true; note = "(Bận lịch)"; }
                }

                // LỚP 3: CHECK TRÙNG CỤC BỘ (Local Conflict)
                // Kiểm tra xem KTV này đã được gán cho dòng nào bên trên mà bị trùng giờ không?
                if (!isDisabled) {
                    const isBusyLocal = assignedTechsLocal.some(assign =>
                        assign.techId === tech.Id &&
                        (myStart < assign.end && assign.start < myEnd) // Có trùng giờ
                    );
                    if (isBusyLocal) { isDisabled = true; note = "(Trùng dòng trên)"; }
                }

                // Render Option
                const isOriginal = (tech.Id === originalTechId);
                let selectedAttr = "";

                // Logic Auto-Select:
                // Ưu tiên chọn KTV gốc NẾU họ không bị disable
                if (isOriginal && !isDisabled) {
                    selectedAttr = "selected";
                    autoSelectId = tech.Id;
                }

                if (isDisabled) {
                    // Nếu là gốc nhưng bận -> Vẫn hiện nhưng disable
                    if(isOriginal) optionsHtml += `<option disabled class="bg-gray-200 text-gray-400" selected>${tech.Name} ${note}</option>`;
                    // Người lạ bận -> Không hiện để đỡ rối (hoặc hiện tùy bạn)
                } else {
                    optionsHtml += `<option value="${tech.Id}" ${selectedAttr}>${tech.Name}</option>`;
                }
            });

            select.innerHTML = optionsHtml;

            // Fallback: Nếu không chọn được KTV gốc (do bận), chọn người rảnh đầu tiên
            if (!autoSelectId) {
                const firstAvail = select.querySelector('option:not([disabled])');
                if (firstAvail) {
                    firstAvail.selected = true;
                    autoSelectId = parseInt(firstAvail.value);
                } else {
                    select.insertAdjacentHTML('afterbegin', `<option value="">⚠️ Không có KTV rảnh</option>`);
                    select.value = "";
                }
            }

            // --- LƯU TRẠNG THÁI ĐỂ CHECK CHO DÒNG SAU ---
            if (autoSelectId) {
                assignedTechsLocal.push({
                    techId: autoSelectId,
                    start: myStart,
                    end: myEnd
                });
            }
        });
    }

    // Helper format giờ
    function formatTime(date) {
        return date.getHours().toString().padStart(2,'0') + ':' + date.getMinutes().toString().padStart(2,'0');
    }

    // 4. SUBMIT DỜI LỊCH (Gửi List chi tiết)
    async function submitReschedule() {
        const dateVal = document.getElementById('reschDate').value;
        const timeVal = document.getElementById('reschTime').value;

        // Lấy ID từ hidden field và parse sang số
        const apptIdStr = document.getElementById('reschApptId').value;
        const apptId = parseInt(apptIdStr);

		if(!dateVal || !timeVal) { await showWarning("Vui lòng chọn ngày giờ mới!"); return; } // [THAY ĐỔI] dùng sweetalert
		if(!apptId || isNaN(apptId)) { await showError("Lỗi: Không tìm thấy ID lịch hẹn! Vui lòng tải lại trang."); return; } // [THAY ĐỔI] dùng sweetalert

        // Gom dữ liệu từ bảng
        const details = [];
        const rows = document.querySelectorAll('.resch-row');

        // === [LOGIC MỚI] CHECK XUNG ĐỘT THỜI GIAN (Time Collision) ===
        // Mảng chứa các slot đã chọn: { techId: 1, start: 600, end: 630 } (Phút)
        const assignedSlots = [];
        let collisionError = null;

        let isValid = true;

        rows.forEach(row => {
            const detailId = parseInt(row.dataset.detailId || row.dataset.index); // Fallback nếu thiếu
            const select = row.querySelector('.resch-tech-select');

            // Check kỹ detailId
            if (isNaN(detailId)) return;
            const techId = parseInt(select.value);

            if (!techId || isNaN(techId)) {
                isValid = false;
            } else {
                // 1. Lấy khung giờ của dòng này (Từ cột "Thời lượng")
                // Giả định cột thời lượng là cột thứ 2 (index 1) và có dạng "10:00 - 10:30"
                const timeText = row.cells[1].innerText.trim().split('\n')[0]; // Lấy dòng đầu (bỏ qua '30 phút' bên dưới)
                const [startStr, endStr] = timeText.split('-').map(s => s.trim());

                // Đổi sang số phút để so sánh (VD: 10:00 -> 600)
                const startMin = parseTime(startStr);
                const endMin = parseTime(endStr);

                // 2. Kiểm tra xem ông KTV này có bị trùng giờ với slot nào đã chọn trước đó không?
                const isConflict = assignedSlots.some(slot =>
                    slot.techId === techId &&       // Cùng một người
                    startMin < slot.end && slot.start < endMin // Giao nhau về thời gian (Overlap)
                );

                if (isConflict) {
                    collisionError = `KTV đang bị trùng giờ làm việc (${startStr} - ${endStr})!`;
                }

                // Lưu lại slot này để check cho dòng sau
                assignedSlots.push({ techId, start: startMin, end: endMin });
            }

            details.push({
                DetailId: detailId,
                TechnicianId: parseInt(techId)
            });
        });

        // Hàm phụ: Đổi "10:30" -> 630 phút
        function parseTime(t) {
            if(!t) return 0;
            const parts = t.split(':');
            return parseInt(parts[0]) * 60 + parseInt(parts[1]);
        }

        if (!isValid) {
			await showWarning("Vui lòng chọn KTV cho tất cả các dịch vụ!"); // [THAY ĐỔI] dùng sweetalert
            return;
        }

        // === [THÊM MỚI] CHẶN NẾU TRÙNG ===
        if (collisionError) {
            await showError("⛔ XUNG ĐỘT LỊCH TRÌNH!\n\n" + collisionError + "\n\nMột KTV không thể làm 2 việc CÙNG LÚC.\n(Nhưng làm tuần tự việc này xong đến việc kia thì được).");
            return;
        }
        // =================================

        // Payload mới
        const payload = {
            AppointmentId: parseInt(document.getElementById('reschApptId').value),
            NewDate: dateVal,
            NewTime: timeVal,
            Details: details // <--- Gửi list thay vì 1 ID
        };

        console.log("Sending payload:", payload); // <--- Bật F12 xem log này

        try {
            const res = await fetch('/Receptionist/Calendar/ProcessReschedule', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(payload)
            });
            // Đọc response text trước để debug nếu lỗi
            const text = await res.text();
            try {
                const data = JSON.parse(text);
                if(data.success) {
					await showSuccess("✅ Dời lịch và phân công lại thành công!"); // [THAY ĐỔI] dùng sweetalert
                    window.location.reload();
                } else {
					await showError("Lỗi server trả về: " + data.message); // [THAY ĐỔI] dùng sweetalert
                }
            } catch {
                console.error("Server error raw:", text);
                await showError("Lỗi hệ thống (Xem console để biết chi tiết)"); // [THAY ĐỔI] dùng sweetalert
            }
		} catch(e) { await showError("Lỗi kết nối server"); } // [THAY ĐỔI] dùng sweetalert
    }

    // Hàm mở cửa sổ in (Popup)
    function printInvoice(invoiceId) {
        if (!invoiceId) { alert("Chưa có ID hóa đơn!"); return; }

        // Mở cửa sổ popup kích thước nhỏ
        const url = `/Receptionist/Calendar/PrintInvoice?id=${invoiceId}`;
        const w = 400;
        const h = 600;
        const left = (screen.width/2)-(w/2);
        const top = (screen.height/2)-(h/2);

        window.open(url, 'PrintInvoice', `toolbar=no, location=no, directories=no, status=no, menubar=no, scrollbars=yes, resizable=no, copyhistory=no, width=${w}, height=${h}, top=${top}, left=${left}`);
    }

    // HÀM XỬ LÝ CHẾ ĐỘ WALK-IN
    function toggleWalkInMode() {
        const isWalkIn = document.getElementById('chkWalkIn').checked;
        const dateInput = document.getElementById('inputBookingDate');
        const timeInput = document.getElementById('inputBookingTime');

        if (isWalkIn) {
            // 1. Tự động set Ngày & Giờ hiện tại
            const now = new Date();
            const yyyy = now.getFullYear();
            const mm = String(now.getMonth() + 1).padStart(2, '0');
            const dd = String(now.getDate()).padStart(2, '0');
            const hh = String(now.getHours()).padStart(2, '0');
            const min = String(now.getMinutes()).padStart(2, '0');

            dateInput.value = `${yyyy}-${mm}-${dd}`;
            timeInput.value = `${hh}:${min}`;

            // SỬA: Gọi onBookingDateChange thay vì updateBookingTime
            // Để nó tải dữ liệu ca làm của "Hôm nay" về
            onBookingDateChange(dateInput.value);
        }

        // 2. Tính lại tiền (để ẩn/hiện phần Cọc)
        calculateTotal();
    }

    // HÀM XỬ LÝ KHI ĐỔI NGÀY TRONG MODAL
    async function onBookingDateChange(newDateStr) {
        if (!newDateStr) return;

        // Hiện loading trong bảng
        document.getElementById('assignmentTableBody').innerHTML = '<tr><td colspan="4" class="p-4 text-center text-gray-500"><span class="material-symbols-outlined animate-spin align-middle">sync</span> Đang tải lịch làm việc...</td></tr>';

        try {
            // Gọi API lấy dữ liệu ngày mới
            const res = await fetch(`/Receptionist/Calendar/GetTechsAvailability?date=${newDateStr}`);
            const data = await res.json();

            if (data.success) {
                // Cập nhật biến dữ liệu động
                currentModalTechs = data.techs;
                currentModalEvents = data.events;

                // Render lại bảng với dữ liệu mới
                updateBookingTime();
            } else {
                alert('Lỗi tải dữ liệu: ' + data.message);
            }
        } catch (e) {
            console.error(e);
            alert('Lỗi kết nối server khi tải lịch làm việc!');
        }
    }

    // HÀM XỬ LÝ KHI ĐỔI NGÀY TRONG MODAL DỜI LỊCH
    async function onRescheduleDateChange(newDateStr) {
        if (!newDateStr) return;

        // Thông báo đang tải trong các ô Select KTV
        const selects = document.querySelectorAll('.resch-tech-select');
        selects.forEach(s => s.innerHTML = '<option>Đang tải dữ liệu...</option>');

        try {
            // Gọi lại chính API GetTechsAvailability (đã sửa PascalCase)
            const res = await fetch(`/Receptionist/Calendar/GetTechsAvailability?date=${newDateStr}`);
            const data = await res.json();

            if (data.success) {
                // Cập nhật biến dữ liệu động riêng cho Dời lịch
                currentRescheduleTechs = data.techs;
                currentRescheduleEvents = data.events;

                // Tính toán lại danh sách KTV
                updateRescheduleAvailability();
            } else {
                alert('Lỗi tải dữ liệu: ' + data.message);
            }
        } catch (e) {
            console.error(e);
            alert('Lỗi kết nối server khi tải lịch làm việc!');
        }
    }

    // HÀM KIỂM TRA HỢP LỆ NGÀY GIỜ (Dùng chung cho cả 2 modal)
    function validateDateTimeRule(dateStr, timeStr) {
        if (!dateStr || !timeStr) return { valid: true, msg: "" }; // Chưa chọn thì chưa lỗi

        // 1. KIỂM TRA KHUNG GIỜ LÀM VIỆC (08:00 - 20:00)
        const [h, m] = timeStr.split(':').map(Number);
        // Nếu nhỏ hơn 8h hoặc lớn hơn 20h (hoặc đúng 20h mà có phút lẻ)
        if (h < 8 || h > 20 || (h === 20 && m > 0)) {
            return { valid: false, msg: "⛔ Vui lòng chọn trong khung giờ 08:00 - 20:00" };
        }

        // 2. KIỂM TRA QUÁ KHỨ (Ngày đã chọn so với Hiện tại)
        // Cách 1: Nếu đang tích "Làm ngay" thì KHÔNG cần check quá khứ
        const chkWalkIn = document.getElementById('chkWalkIn');
        if (chkWalkIn && chkWalkIn.checked) {
             return { valid: true, msg: "" };
        }

        // Cách 2: Làm tròn thời gian hiện tại về 0 giây để so sánh công bằng
        const selectedDate = new Date(`${dateStr}T${timeStr}`);
        const now = new Date();
        now.setSeconds(0, 0); // <--- QUAN TRỌNG: Reset giây về 0

        // So sánh timestamp.
        // Lưu ý: Nếu là Walk-in (Làm ngay) thì code tự điền giờ hiện tại -> Sẽ hợp lệ.
        // Nếu chọn tay: Phải lớn hơn hoặc bằng hiện tại (cho phép sai số 1 phút để dễ chọn)
        if (selectedDate < now) {
            // Check kỹ hơn: Nếu là ngày quá khứ hẳn
            const selectedDayOnly = new Date(dateStr);
            const todayOnly = new Date(now.toDateString()); // Reset giờ về 00:00

            if (selectedDayOnly < todayOnly) {
                return { valid: false, msg: "⛔ Không thể chọn ngày trong quá khứ!" };
            }
            // Nếu là hôm nay nhưng giờ cũ
            return { valid: false, msg: "⛔ Không thể chọn giờ trong quá khứ!" };
        }

        return { valid: true, msg: "" };
    }
</script>