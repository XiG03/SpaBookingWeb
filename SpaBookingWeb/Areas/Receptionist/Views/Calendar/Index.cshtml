            const originalText = btn.innerHTML; // Lưu lại nội dung cũ (MOMO QR)
            try{
                btn.innerHTML = '<span class="material-symbols-outlined animate-spin">sync</span> Đang chuyển hướng Momo...';
                btn.disabled = true;

                const res = await fetch('/Receptionist/Calendar/CreateMomoPayment', {
                    method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload)
                });
                const data = await res.json();

                if(data.success) {
                    // CHUYỂN HƯỚNG TRANG WEB SANG MOMO LUÔN
                    window.location.href = data.payUrl;
                } else {
					await showError('Lỗi tạo Momo: ' + data.message); // [THAY ĐỔI] dùng sweetalert
                    btn.innerHTML = 'MOMO QR';
                    btn.disabled = false;
                }
            } catch(e) {
                console.error(e);
				await showError('Lỗi kết nối server!'); // [THAY ĐỔI] dùng sweetalert
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }
    }

    // 6. POLLING (Hỏi server liên tục)
    function startPolling(apptId) {
        if(pollingInterval) clearInterval(pollingInterval);

        pollingInterval = setInterval(async () => {
            try {
                const res = await fetch(`/Receptionist/Calendar/CheckPaymentStatus?appointmentId=${apptId}`);
                const data = await res.json();

                if (data.success) {
                    clearInterval(pollingInterval);
                    // [THAY ĐỔI] Dùng SweetAlert thay vì alert thường
                    await showSuccess('Momo báo tin: Thanh toán THÀNH CÔNG!');
                    window.location.reload();
                }
            } catch (e) {
                console.log("Polling error", e);
            }
        }, 3000); // 3 giây hỏi 1 lần
    }

