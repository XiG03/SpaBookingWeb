    // --- HÀM GỌI API CHUYỂN TRẠNG THÁI ---
    async function updateAppointmentStatus(apptId, newStatus) {
        // [THAY ĐỔI] Thêm await showConfirm sweetalert
        const msg = newStatus === 'InProgress' ? 'Xác nhận khách đã đến cửa hàng?' : 'Xác nhận khách đã thanh toán và ra về?';
        if (!await showConfirm(msg)) return;

        // Hiệu ứng loading
        const btn = document.querySelector('#detailActions button');
        const oldText = btn.innerHTML;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin">sync</span> Đang xử lý...';
        btn.disabled = true;

        try {
            const formData = new FormData();
            formData.append('id', apptId);
            formData.append('status', newStatus);

            const res = await fetch('/Receptionist/Calendar/UpdateAppointmentStatus', {
                method: 'POST',
                body: formData
            });

            const result = await res.json();
            if (result.success) {
                // Thành công -> Tắt modal và reload lại lịch
                closeDetailModal();
                window.location.reload();
            } else {
				await showError('Lỗi: ' + result.message); // [THAY ĐỔI] dùng sweetalert
                btn.innerHTML = oldText; // Khôi phục nút
                btn.disabled = false;
            }
        } catch (e) {
			await showError('Lỗi kết nối server!'); // [THAY ĐỔI] dùng sweetalert
            btn.innerHTML = oldText;
            btn.disabled = false;
        }
    }

