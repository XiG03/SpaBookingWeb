@using Newtonsoft.Json
@model SpaBookingWeb.ViewModels.Receptionist.CalendarVM
@{
    ViewData["Title"] = "Lịch hẹn Spa";
    Layout = "~/Areas/Receptionist/Views/Shared/_Layout.cshtml";

    // Cấu hình khung giờ hiển thị (8h - 19h)
    int startHour = 8;
    int endHour = 20;
    int totalHours = endHour - startHour;
}
<link href="https://cdn.jsdelivr.net/npm/@@sweetalert2/theme-bootstrap-4/bootstrap-4.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const MASTER_DATA = {
        services: @Html.Raw(JsonConvert.SerializeObject(Model.Services)),
        combos: @Html.Raw(JsonConvert.SerializeObject(Model.Combos)),
        techs: @Html.Raw(JsonConvert.SerializeObject(Model.TechnicianGroups.SelectMany(g => g.Technicians))),
        depositRules: @Html.Raw(JsonConvert.SerializeObject(Model.DepositRules)),
        events: @Html.Raw(JsonConvert.SerializeObject(Model.Events))
    };

    // --- [NEW] BỘ UI THÔNG BÁO MỚI (SweetAlert2) ---
    const Toast = Swal.mixin({
        toast: true, position: 'top-end', showConfirmButton: false, timer: 3000, timerProgressBar: true
    });

    // 1. Thay thế Alert Thành công
    const showSuccess = async (msg) => {
        return Swal.fire({
            icon: 'success', title: 'Thành công', text: msg,
            confirmButtonColor: '#2563EB', confirmButtonText: 'Đóng'
        });
    };

    // 2. Thay thế Alert Lỗi
    const showError = async (msg) => {
        return Swal.fire({
            icon: 'error', title: 'Đã có lỗi', text: msg,
            confirmButtonColor: '#DC2626', confirmButtonText: 'Đóng'
        });
    };

    // 3. Thay thế Alert Cảnh báo (Dạng Info)
    const showWarning = async (msg) => {
        return Swal.fire({
            icon: 'warning', title: 'Lưu ý', text: msg,
            confirmButtonColor: '#D97706', confirmButtonText: 'Đã hiểu'
        });
    };

    // 4. Thay thế Confirm (Trả về true/false y hệt native confirm)
    const showConfirm = async (msg) => {
        const result = await Swal.fire({
            title: 'Xác nhận',
            text: msg, // Giữ nguyên nội dung bạn truyền vào
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#2563EB', cancelButtonColor: '#6B7280',
            confirmButtonText: 'Đồng ý', cancelButtonText: 'Hủy bỏ'
        });
        return result.isConfirmed;
    };

    // 5. Thay thế Prompt (Trả về text hoặc null y hệt native prompt)
    const showPrompt = async (msg) => {
        const { value: text } = await Swal.fire({
            title: msg,
            input: 'text',
            inputPlaceholder: 'Nhập nội dung...',
            showCancelButton: true,
            confirmButtonText: 'Gửi', cancelButtonText: 'Hủy'
        });
        return text;
    };
    // -----------------------------------------------------
</script>
<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: #cbd5e1;
        border-radius: 3px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background-color: #94a3b8;
        }
</style>

<div class="h-[calc(100vh-80px)] flex flex-col bg-white dark:bg-gray-900">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
        <h1 class="text-xl font-bold text-gray-800 flex items-center gap-2">
            <span class="material-symbols-outlined text-blue-600">calendar_month</span>
            Lịch hẹn
        </h1>
        <div class="flex items-center bg-gray-100 rounded-lg p-1">
            <a href="?date=@Model.SelectedDate.AddDays(-1).ToString("yyyy-MM-dd")" class="p-2 hover:bg-white rounded shadow-sm"><span class="material-symbols-outlined text-sm">chevron_left</span></a>
            <input type="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" onchange="window.location.href='?date='+this.value" class="bg-transparent border-none font-bold text-gray-700 focus:ring-0 cursor-pointer mx-2">
            <a href="?date=@Model.SelectedDate.AddDays(1).ToString("yyyy-MM-dd")" class="p-2 hover:bg-white rounded shadow-sm"><span class="material-symbols-outlined text-sm">chevron_right</span></a>
        </div>
        <button onclick="openBookingModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-bold shadow-md flex items-center gap-2">
            <span class="material-symbols-outlined">add</span> Đặt lịch mới
        </button>
    </div>

    <div class="flex-1 overflow-hidden flex flex-col relative bg-white">

        <div class="flex border-b border-gray-200 bg-gray-50 h-10 mr-[6px] z-20 shadow-sm text-gray-500 font-bold text-xs select-none">
            <div class="w-60 flex-shrink-0 border-r border-gray-200 p-3 text-center uppercase bg-gray-50 sticky left-0 z-30">
                Kỹ thuật viên
            </div>

            <div class="flex-1 relative h-full">
                @for (int i = 0; i <= totalHours; i++)
                {
                    // Tính phần trăm vị trí
                    double percent = (double)i / totalHours * 100;

                    // LOGIC CĂN CHỈNH:
                    // - Đầu tiên (i==0): translate-x-0 (Căn trái)
                    // - Cuối cùng (i==totalHours): -translate-x-full (Căn phải - kéo ngược lại vào trong)
                    // - Ở giữa: -translate-x-1/2 (Căn giữa chuẩn)
                    string alignClass = "-translate-x-1/2";
                    if (i == 0)
                    {
                        alignClass = "translate-x-0 pl-1"; // Thêm chút padding trái cho đẹp
                    }
                    else if (i == totalHours)
                    {
                        alignClass = "-translate-x-full pr-1"; // Thêm chút padding phải
                    }

                    <div class="absolute top-0 bottom-0 border-l border-gray-200 pt-3 text-[10px] text-gray-500 @alignClass"
                         style="left: @percent%">
                        @((startHour + i).ToString("00")):00
                    </div>
                }
            </div>
        </div>

        <div class="flex-1 overflow-y-auto relative custom-scrollbar" id="timelineContainer">

            <div class="absolute top-0 bottom-0 left-0 right-0 pointer-events-none flex ml-60 z-0">
                @for (int i = 0; i < totalHours; i++)
                {
                    <div class="h-full border-l border-dashed border-gray-100" style="width: @(100.0 / totalHours)%"></div>
                }
            </div>

            @foreach (var group in Model.TechnicianGroups)
            {
                @foreach (var tech in group.Technicians)
                {
                    <div class="flex border-b border-gray-100 h-20 group hover:bg-gray-50 transition relative">

                        <div class="w-60 flex-shrink-0 border-r border-gray-100 p-3 flex items-center gap-3 sticky left-0 bg-white group-hover:bg-gray-50 z-10 transition shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)]">
                            <div class="w-10 h-10 rounded-full bg-gray-200 overflow-hidden ring-2 ring-gray-100">
                                <img src="https://via.placeholder.com/150" class="w-full h-full object-cover" onerror="this.src='https://ui-avatars.com/api/?name=@tech.Name&background=random'" />
                            </div>
                            <div class="overflow-hidden">
                                <p class="text-sm font-bold truncate w-36 text-gray-800">@tech.Name</p>
                                <p class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded inline-block font-semibold border border-blue-100">
                                    @tech.SkillLevel
                                </p>
                            </div>
                        </div>

                        <div class="flex-1 relative">
                            @foreach (var evt in Model.Events.Where(e => e.TechnicianId == tech.Id))
                            {
                                double left = ((evt.StartTime.Hour + evt.StartTime.Minute / 60.0 - startHour) / totalHours) * 100;
                                double width = ((evt.EndTime - evt.StartTime).TotalHours / totalHours) * 100;

                                <div class="absolute top-2 bottom-2 rounded border-l-4 p-2 text-xs shadow-sm hover:shadow-md cursor-pointer z-10 @evt.ColorClass transition hover:-translate-y-0.5 select-none"
                                     style="left: @left%; width: @width%;"
                                     onclick="openDetailModal(@evt.AppointmentId)">

                                    <div class="font-bold truncate flex items-center gap-1">
                                        @evt.CustomerName
                                    </div>
                                    @if (!string.IsNullOrEmpty(evt.GuestName))
                                    {
                                        <div class="text-[10px] text-pink-700 font-bold truncate"> + @evt.GuestName</div>
                                    }
                                    <div class="text-[10px] truncate opacity-75 mt-0.5">@evt.ServiceName</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            <div class="h-10 w-full"></div>
        </div>
    </div>
</div>

