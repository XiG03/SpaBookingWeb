    // 3. CÁC HÀM THAO TÁC (Tự động tính lại tiền sau khi sửa)
    function toggleBillItem(index) {
        currentBillData.items[index].isSelected = !currentBillData.items[index].isSelected;
        renderBillItems(); // Re-render để mờ/sáng
        calculateBill();
    }

    function updateTip(index, value) {
        currentBillData.items[index].tipAmount = parseInt(value) || 0;
        calculateBill(); // Tính lại tổng tip
    }

    // 4. GỌI SERVER TÍNH TIỀN (Debounce could be added here)
    async function calculateBill() {
        const payload = {
            AppointmentId: currentApptId,
            VoucherCode: document.getElementById('voucherCode').value,
            Items: currentBillData.items
        };

        const res = await fetch('/Receptionist/Calendar/CalculateBill', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(payload)
        });
        const result = await res.json();

        // Update UI Calculator
        const fmt = (n) => n.toLocaleString();
        document.getElementById('lblSubTotal').innerText = fmt(result.subTotal);
        document.getElementById('lblMemberDisc').innerText = fmt(result.memberDiscount);
        document.getElementById('lblVoucherDisc').innerText = fmt(result.voucherDiscount);
        document.getElementById('lblVoucherMsg').innerText = result.voucherMessage ? `(${result.voucherMessage})` : '';
        document.getElementById('lblTipTotal').innerText = fmt(result.totalTip);
        document.getElementById('lblDeposit').innerText = fmt(result.deposit);
        document.getElementById('lblFinal').innerText = fmt(result.finalAmount) + ' đ';
    }

