    // --- SUPPORT FUNCTIONS ---
    function formatTime(d) { return `${d.getHours().toString().padStart(2,'0')}:${d.getMinutes().toString().padStart(2,'0')}`; }

    function calculateTotal() {
        let total = 0, count = 0;
        bookingState.guests.forEach(g => {
            g.selectedItems.forEach(i => {
                count++;
                if(i.type==='SERVICE') total += MASTER_DATA.services.find(s=>s.Id===i.id).Price;
                if(i.type==='COMBO') total += MASTER_DATA.combos.find(c=>c.Id===i.id).Price;
            });
        });
        document.getElementById('totalPriceDisplay').innerText = new Intl.NumberFormat('vi-VN', {style:'currency',currency:'VND'}).format(total);
        document.getElementById('totalItems').innerText = count;

        // === [LOGIC MỚI] ===
        const isWalkIn = document.getElementById('chkWalkIn').checked; // Check trạng thái
        const depSec = document.getElementById('depositSection');
        // Logic Cọc
        let req = 0;
        if (!isWalkIn){
            const rule = MASTER_DATA.depositRules.find(r => total >= r.MinOrderValue);
            if(rule) req = rule.DepositType === 'Percent' ? total * (rule.DepositValue/100) : rule.DepositValue;
        }

        if(req > 0) {
            depSec.classList.remove('hidden');
            document.getElementById('depositAmountDisplay').innerText = new Intl.NumberFormat('vi-VN', {style:'currency',currency:'VND'}).format(req);
            depSec.dataset.req = req;
            // Nếu hiện lại cọc, bỏ tick "Đã thu" để tránh nhầm lẫn
            document.getElementById('depositPaid').checked = false;
        } else {
            depSec.classList.add('hidden');
            depSec.dataset.req = 0;
        }
        validateSubmitButton();
    }

    function validateSubmitButton() {
        const btn = document.getElementById('btnSubmit');
        const req = parseFloat(document.getElementById('depositSection').dataset.req || 0);
        const paid = document.getElementById('depositPaid').checked;
        const selects = document.querySelectorAll('#assignmentTableBody select');

        // Nếu div lỗi không có class 'hidden' nghĩa là đang có lỗi hiển thị -> Chặn
        const isTimeInvalid = !document.getElementById('bookingTimeError').classList.contains('hidden');

        // Điều kiện 1: Đã chọn KTV hết chưa?
        let allTechSelected = selects.length > 0 && Array.from(selects).every(s => s.value !== "");
        // Điều kiện 2: Cọc đủ chưa?
        let depositOk = req === 0 || paid;
        
        // 2. Kiểm tra thông tin Khách hàng (LOGIC MỚI)
        let customerOk = false;

        if (isCustomerVerified) {
            // Kiểm tra xem đang là chế độ Khách Cũ hay Mới dựa vào thuộc tính readOnly của ô tên
            const isNewCustomer = !document.getElementById('inputName').readOnly;

            if (isNewCustomer) {
                // KHÁCH MỚI: Phải nhập đủ Tên & Email
                const nameVal = document.getElementById('inputName').value.trim();
                const emailVal = document.getElementById('inputEmail').value.trim();
                
                // (Tùy chọn) Kiểm tra định dạng email cơ bản có chứa
                const isEmailValid = emailVal.length > 0 && emailVal.includes('@@');

                customerOk = (nameVal.length > 0 && isEmailValid);
            } else {
                // KHÁCH CŨ: Đã tìm thấy là OK (Thông tin đã có sẵn trong DB)
                customerOk = true;
            }
        }

        // Tổng hợp điều kiện
        btn.disabled = !(allTechSelected && depositOk && customerOk && !isTimeInvalid);

        // Visual Feedback
        if (btn.disabled) {
            btn.classList.add('opacity-50', 'cursor-not-allowed');
            // Thêm tooltip báo lỗi thời gian
            if (isTimeInvalid) btn.title = "Thời gian chọn không hợp lệ!";
            else if (!isCustomerVerified) btn.title = "Vui lòng tìm kiếm khách hàng trước";
            // Cập nhật tooltip để nhắc nhở
            if (!isCustomerVerified) btn.title = "Vui lòng tìm kiếm khách hàng trước";
            else if (!customerOk) btn.title = "Vui lòng nhập đầy đủ Tên và Email hợp lệ";
            else btn.title = "Vui lòng chọn KTV cho tất cả dịch vụ";
        } else {
            btn.classList.remove('opacity-50', 'cursor-not-allowed');
            btn.title = "";
        }
    }

    // --- SUBMIT DỮ LIỆU ---
    async function submitBooking() {
        // Gom dữ liệu từ bookingState và các dòng trong Bảng
        const guestsData = [];

        // Chúng ta phải gom theo group guest, nhưng dữ liệu chi tiết (TechId, Time) lại nằm trong DOM table
        // Cách hay nhất: Loop qua Table Rows để lấy data
        const rows = document.querySelectorAll('#assignmentTableBody tr');
        let currentGuestName = "";
        let currentGuestItems = [];

        // Vì cấu trúc bảng phẳng (Flat List), ta cần map lại vào Guest Object
        // Để đơn giản hóa cho Controller: Gửi 1 list items phẳng kèm GuestName là được!
        // Nhưng ViewModel yêu cầu List<BookingGuestVM>. Ta sẽ gom lại.

        // Map tạm:
        let mapGuest = {}; // "GuestName" -> [Items]

        rows.forEach(tr => {
            const guestNameCell = tr.cells[0].innerText.trim();
            if(guestNameCell) currentGuestName = guestNameCell; // Lấy tên từ dòng đầu tiên của block

            const select = tr.querySelector('select');
            const hidden = tr.querySelector('.task-data');

            if (!mapGuest[currentGuestName]) mapGuest[currentGuestName] = [];

            mapGuest[currentGuestName].push({
                ServiceId: parseInt(hidden.dataset.sid),
                ComboId: hidden.dataset.cid ? parseInt(hidden.dataset.cid) : null,
                TechnicianId: parseInt(select.value),
                StartTime: hidden.dataset.start,
                EndTime: hidden.dataset.end
            });
        });

        // Convert to Array for VM
        const payloadGuests = Object.keys(mapGuest).map(key => ({
            GuestName: key,
            Items: mapGuest[key]
        }));

        const payload = {
            CustomerPhone: document.getElementById('inputPhone').value,
            CustomerName: document.getElementById('inputName').value,
            CustomerEmail: document.getElementById('inputEmail').value,
            BookingDate: document.getElementById('inputBookingDate').value,
            StartTime: document.getElementById('inputBookingTime').value, // Giờ tổng
            Notes: document.getElementById('inputNotes').value, // <--- Lấy value thật,
            IsWalkIn: document.getElementById('chkWalkIn').checked,
            IsDepositPaid: document.getElementById('depositPaid').checked,
            Guests: payloadGuests
        };

        // Gửi AJAX
        try {
            const res = await fetch('/Receptionist/Calendar/SaveBooking', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(payload)
            });
            if(res.ok) {
                // [THAY ĐỔI] Dùng showSuccess và await để chờ người dùng đọc xong mới reload
                await showSuccess('Đặt lịch thành công!');
                window.location.reload();
            } else {
                // [THAY ĐỔI] sweetalert
                await showError('Lỗi: ' + await res.text());
            }
        } catch(e) { alert('Lỗi kết nối'); }
    }

