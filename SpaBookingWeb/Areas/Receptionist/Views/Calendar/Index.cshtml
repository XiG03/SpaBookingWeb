    function renderBillItems() {
        const container = document.getElementById('paymentItemsContainer');
        container.innerHTML = '';

        currentBillData.items.forEach((item, index) => {
            const html = `
            <div class="bg-white p-4 rounded-lg border border-gray-200 shadow-sm flex items-center justify-between gap-4 transition ${!item.isSelected ? 'opacity-50 grayscale' : ''}">
