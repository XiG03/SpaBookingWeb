                        </div>
                        <div class="flex justify-between text-red-500 border-b pb-2">
                            <span>Đã cọc:</span>
                            <span>- <span id="lblDeposit">0</span></span>
                        </div>
                        <div class="flex justify-between text-xl font-bold text-gray-900 pt-2">
                            <span>CẦN THU:</span>
                            <span class="text-blue-600" id="lblFinal">0</span>
                        </div>
                    </div>

                    <div class="mt-6 space-y-3">
                        <p class="text-xs text-gray-500 font-bold uppercase">Phương thức thanh toán:</p>
                        <div class="grid grid-cols-2 gap-3">
                            <button onclick="processPayment('Cash')" class="flex items-center justify-center gap-2 py-3 border-2 border-green-500 bg-green-50 text-green-700 rounded-lg font-bold hover:bg-green-100 transition">
                                <span class="material-symbols-outlined">payments</span> TIỀN MẶT
                            </button>
                            <button onclick="processPayment('Momo')" class="flex items-center justify-center gap-2 py-3 border-2 border-pink-500 bg-pink-50 text-pink-700 rounded-lg font-bold hover:bg-pink-100 transition">
                                <span class="material-symbols-outlined">qr_code_scanner</span> MOMO QR
                            </button>
