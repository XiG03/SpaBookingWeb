<script>
    let bookingState = { guests: [] };
    let selectedTechMap = {}; // <--- THÊM DÒNG QUAN TRỌNG NÀY

    // === [THÊM MỚI] BIẾN DỮ LIỆU ĐỘNG CHO MODAL ===
    // Mặc định ban đầu lấy từ MASTER_DATA (ngày hiện tại của trang)
    let currentModalTechs = MASTER_DATA.techs;
    let currentModalEvents = MASTER_DATA.events;
    // ==============================================

    // === [THÊM MỚI] BIẾN DỮ LIỆU ĐỘNG CHO DỜI LỊCH ===
    let currentRescheduleTechs = [];
    let currentRescheduleEvents = [];
    // =================================================

    // === [THÊM MỚI] BIẾN TRẠNG THÁI KHÁCH HÀNG ===
    let isCustomerVerified = false; // Mặc định là chưa tìm kiếm
    // ==============================================

    // Hàm Reset khi người dùng sửa số điện thoại
    function resetCustomerStatus() {
        isCustomerVerified = false;
        document.getElementById('customerInfoFields').classList.add('hidden'); // Ẩn khung nhập tên
        document.getElementById('customerStatus').innerHTML = ''; // Xóa trạng thái cũ
        document.getElementById('inputName').value = ''; // Xóa tên cũ
        validateSubmitButton(); // Khóa nút xác nhận ngay lập tức
    }

    function openBookingModal(timeArg = null) {
        // Init State
        bookingState = { guests: [{ id: 1, type: 'MAIN', selectedItems: [] }] };
        selectedTechMap = {}; // <--- THÊM DÒNG NÀY ĐỂ RESET KHI MỞ MỚI

        // Setup Date/Time
        const todayStr = '@Model.SelectedDate.ToString("yyyy-MM-dd")'; // Mặc định ngày đang xem
        document.getElementById('inputBookingDate').value = todayStr;
        // Lấy ngày hôm nay (YYYY-MM-DD) và gán vào thuộc tính min
        document.getElementById('inputBookingDate').min = new Date().toISOString().split('T')[0];

        // === [THÊM] RESET DỮ LIỆU VỀ NGÀY HIỆN TẠI CỦA TRANG ===
        currentModalTechs = MASTER_DATA.techs;
        currentModalEvents = MASTER_DATA.events;
        // ========================================================
        // === [THÊM] RESET TRẠNG THÁI ===
        isCustomerVerified = false;
        // ==============================

        if (timeArg) {
            document.getElementById('inputBookingTime').value = timeArg;
        } else {
            const now = new Date();
            let h = now.getHours();
            let m = Math.ceil(now.getMinutes() / 15) * 15;
            if(m===60){h++; m=0;}
            document.getElementById('inputBookingTime').value = `${h.toString().padStart(2,'0')}:${m.toString().padStart(2,'0')}`;
        }

        // Reset UI
        document.getElementById('bookingModal').classList.remove('hidden');
        document.getElementById('inputPhone').value = '';
        document.getElementById('customerStatus').innerHTML = '';
        document.getElementById('inputNotes').value = '';
        document.getElementById('chkWalkIn').checked = false;

        // --- CODE MỚI: ẨN KHUNG THÔNG TIN & RESET VALUE ---
        const infoFields = document.getElementById('customerInfoFields');
        infoFields.classList.add('hidden'); // Ẩn đi
        document.getElementById('inputName').value = '';
        document.getElementById('inputEmail').value = '';
        document.getElementById('inputName').readOnly = false; // Mặc định cho nhập
        document.getElementById('inputEmail').readOnly = false;
        // --------------------------------------------------

        renderGuestList();
        renderAssignmentTable();
        calculateTotal();
    }

    function closeModal() { document.getElementById('bookingModal').classList.add('hidden'); }

    // --- FIX 2: HIỆN COMBO & DỊCH VỤ ---
    function renderGuestList() {
        const container = document.getElementById('guestListContainer');
        container.innerHTML = '';

        // Merge Services và Combos vào 1 list để chọn
        const allServices = MASTER_DATA.services.map(s => ({...s, type: 'SERVICE'}));
        const allCombos = MASTER_DATA.combos.map(c => ({Id: c.Id, Name: `[Combo] ${c.Name}`, Price: c.Price, Duration: 'Combo', type: 'COMBO'}));
        const displayItems = [...allCombos, ...allServices];

        bookingState.guests.forEach((guest, index) => {
            const isMain = guest.type === 'MAIN';
            let listHtml = displayItems.map(item => {
                // Check xem item này đã chọn chưa
                const isChecked = guest.selectedItems.some(i => i.id === item.Id && i.type === item.type) ? 'checked' : '';
                return `
                <label class="flex items-center gap-2 p-1 hover:bg-gray-50 rounded w-full cursor-pointer">
                    <input type="checkbox" ${isChecked} onchange="toggleItem(${guest.id}, '${item.type}', ${item.Id})" class="rounded border-gray-300 text-blue-600">
                    <span class="text-sm ${item.type==='COMBO'?'font-bold text-blue-700':'text-gray-700'}">${item.Name} <span class="text-xs text-gray-400">(${item.type==='COMBO'?'Nhiều bước':item.Duration+'p'})</span></span>
                </label>`;
            }).join('');

            const html = `
            <div class="border rounded-lg p-3 bg-white relative mb-2">
                ${!isMain ? `<button onclick="removeGuest(${guest.id})" class="absolute top-2 right-2 text-red-500 material-symbols-outlined text-sm">delete</button>` : ''}
                <div class="grid grid-cols-12 gap-4">
                    <div class="col-span-4 border-r pr-2">
                        <div class="font-bold text-xs text-blue-600 uppercase mb-1">${isMain ? 'KHÁCH CHÍNH' : `KHÁCH #${index}`}</div>
                        ${!isMain ? `<input type="text" placeholder="Tên khách..." onchange="updateGuestName(${guest.id}, this.value)" class="w-full text-sm border-b border-gray-300 p-0">` : ''}
                    </div>
                    <div class="col-span-8 h-32 overflow-y-auto grid grid-cols-2 gap-2 content-start">${listHtml}</div>
                </div>
            </div>`;
            container.insertAdjacentHTML('beforeend', html);
        });
    }

    function toggleItem(guestId, type, itemId) {
        const guest = bookingState.guests.find(g => g.id === guestId);
        const existsIdx = guest.selectedItems.findIndex(i => i.id === itemId && i.type === type);

        if (existsIdx > -1) guest.selectedItems.splice(existsIdx, 1); // Bỏ chọn
        else guest.selectedItems.push({ id: itemId, type: type }); // Chọn mới

        renderAssignmentTable();
        calculateTotal();
    }

    function addGuest() { bookingState.guests.push({ id: Date.now(), type: 'GUEST', selectedItems: [] }); renderGuestList(); }
    function removeGuest(id) { bookingState.guests = bookingState.guests.filter(g => g.id !== id); renderGuestList(); renderAssignmentTable(); calculateTotal(); }
    function updateGuestName(id, val) { bookingState.guests.find(g=>g.id===id).name = val; renderAssignmentTable(); }
    function updateBookingTime() {
        const dateStr = document.getElementById('inputBookingDate').value;
        const timeStr = document.getElementById('inputBookingTime').value;
        const errorDiv = document.getElementById('bookingTimeError');

        // 1. GỌI HÀM KIỂM TRA
        const check = validateDateTimeRule(dateStr, timeStr);

        if (!check.valid) {
            // A. Nếu lỗi: Hiện thông báo
            errorDiv.innerText = check.msg;
            errorDiv.classList.remove('hidden');

            // Xóa bảng phân công KTV để tránh chọn nhầm khi giờ sai
            document.getElementById('assignmentTableBody').innerHTML = '';
            document.getElementById('assignmentSection').classList.add('hidden');
        } else {
            // B. Nếu đúng: Ẩn lỗi và chạy tiếp logic cũ
            errorDiv.classList.add('hidden');
            renderAssignmentTable(); // Logic cũ
        }

        // Luôn gọi validate nút submit cuối cùng
        validateSubmitButton();
    }

    // --- BỘ LỌC 4 LỚP (ĐÃ FIX LỖI) ---
    function renderAssignmentTable() {
        const tbody = document.getElementById('assignmentTableBody');
        const section = document.getElementById('assignmentSection');
        tbody.innerHTML = '';

        const dateStr = document.getElementById('inputBookingDate').value;
        const timeStr = document.getElementById('inputBookingTime').value;
        if(!dateStr || !timeStr) return;

        let baseTime = new Date(`${dateStr}T${timeStr}:00`);

        // 1. CHUẨN BỊ TASKS
        let allTasks = [];
        bookingState.guests.forEach(guest => {
            let cursor = new Date(baseTime);
            guest.selectedItems.forEach(item => {
                let servicesToRun = [];
                if (item.type === 'COMBO') {
                    const combo = MASTER_DATA.combos.find(c => c.Id === item.id);
                    if(combo && combo.ServiceIds) {
                         combo.ServiceIds.forEach(sid => {
                             const s = MASTER_DATA.services.find(x => x.Id === sid);
                             if(s) servicesToRun.push({...s, fromCombo: combo.Id});
                         });
                    }
                } else {
                    const s = MASTER_DATA.services.find(x => x.Id === item.id);
                    if(s) servicesToRun.push(s);
                }
                servicesToRun.forEach(svc => {
                    let end = new Date(cursor.getTime() + (svc.Duration || 60)*60000);
                    allTasks.push({
                        guestId: guest.id,
                        guestName: guest.type==='MAIN' ? (document.getElementById('inputName').value||'Khách chính') : (guest.name||'Khách đi cùng'),
                        serviceName: svc.Name,
                        serviceId: svc.Id,
                        comboId: svc.fromCombo || null,
                        startTime: new Date(cursor),
                        endTime: new Date(end)
                    });
                    cursor = end;
                });
            });
        });

        if (allTasks.length === 0) { section.classList.add('hidden'); return; }
        section.classList.remove('hidden');

        // 2. RENDER VÀ CHECK
        allTasks.forEach((task, idx) => {
            const taskStartMin = task.startTime.getHours()*60 + task.startTime.getMinutes();
            const taskEndMin = task.endTime.getHours()*60 + task.endTime.getMinutes();
            const timeRangeStr = `${formatTime(task.startTime)} - ${formatTime(task.endTime)}`;

            // Lấy KTV đang được chọn ở dòng này (nếu có)
            const currentSelectedTechId = selectedTechMap[idx] ? parseInt(selectedTechMap[idx]) : "";

            let options = `<option value="">-- Chọn KTV --</option>`;

            currentModalTechs.forEach(tech => {
                // --- DEBUG: Bỏ comment dòng dưới để xem tại sao KTV bị ẩn ---
                // console.log(`Check ${tech.Name}: Skill=${tech.AllowedServiceIds?.includes(task.serviceId)}, Shift=${tech.ShiftStartMinutes}`);

                // LỚP 1: CHECK KỸ NĂNG (SKILL)
                // Fix an toàn: Nếu AllowedServiceIds tồn tại và KHÔNG chứa serviceId thì mới ẩn.
                // Nếu AllowedServiceIds null (backend chưa gửi), tạm thời cho hiện để không lỗi.
                if (tech.AllowedServiceIds && tech.AllowedServiceIds.length > 0 && !tech.AllowedServiceIds.includes(task.serviceId)) {
                    return;
                }

                // LỚP 2: CHECK CA LÀM (SHIFT)
                // Nếu KTV không có ca làm (ShiftStartMinutes == 0), ẩn luôn.
                if (tech.ShiftStartMinutes === 0 || taskStartMin < tech.ShiftStartMinutes || taskEndMin > tech.ShiftEndMinutes) {
                    return;
                }

                // [THÊM MỚI] LỚP 2.4: CHECK GIỜ NGHỈ (EARLY BREAK)
                // Logic: Nếu KTV có báo nghỉ (IsOnBreak) VÀ giờ kết thúc dịch vụ (taskEndMin) lớn hơn giờ bắt đầu nghỉ
                // -> Tức là làm chưa xong thì đã đến giờ nghỉ -> Ẩn (return)
                if (tech.IsOnBreak && tech.BreakStartMinutes > 0) {
                    if (taskEndMin > tech.BreakStartMinutes) {
                        // Debug: console.log(`Ẩn ${tech.Name}: Xong lúc ${taskEndMin} nhưng nghỉ lúc ${tech.BreakStartMinutes}`);
                        return;
                    }
                }

                // === LỚP 2.5: CHECK BẬN TRONG DB (DB BUSY) ===
                const isBusyInDb = (currentModalEvents || []).some(evt => {
                    if (evt.TechnicianId !== tech.Id) return false;
                    const evtStart = new Date(evt.StartTime);
                    const evtEnd = new Date(evt.EndTime);
                    return checkOverlap(task.startTime, task.endTime, evtStart, evtEnd);
                });

                if (isBusyInDb) return; // <--- ĐÃ BỎ COMMENT DÒNG NÀY ĐỂ CHẶN LỊCH CŨ

                // LỚP 3: CHECK TRÙNG CỤC BỘ (LOCAL CONFLICT)
                let isBusyLocal = false;
                for (let otherIdx in selectedTechMap) {
                    if (parseInt(otherIdx) === idx) continue;
                    // Fix an toàn: Kiểm tra task tồn tại trước khi lấy giờ
                    const otherTask = allTasks[otherIdx];
                    if (!otherTask) continue;

                    if (parseInt(selectedTechMap[otherIdx]) === tech.Id) {
                        if (checkOverlap(task.startTime, task.endTime, otherTask.startTime, otherTask.endTime)) {
                            isBusyLocal = true; break;
                        }
                    }
                }

                if (!isBusyLocal) {
                    const selected = (tech.Id === currentSelectedTechId) ? "selected" : "";
                    options += `<option value="${tech.Id}" ${selected}>${tech.Name}</option>`;
                }
            });

            // Nếu KTV đã chọn trước đó giờ bị ẩn (do trùng giờ), bỏ chọn
            if (currentSelectedTechId && !options.includes(`value="${currentSelectedTechId}"`)) {
                 delete selectedTechMap[idx]; options = options.replace("selected", "");
            }

            const html = `
            <tr class="border-b">
                <td class="px-4 py-2 font-bold">${idx===0 || task.guestId !== allTasks[idx-1].guestId ? task.guestName : ''}</td>
                <td class="px-4 py-2 text-gray-600 text-sm">${task.serviceName}</td>
                <td class="px-4 py-2 text-blue-600 text-sm font-medium">${timeRangeStr}</td>
                <td class="px-4 py-2">
                    <select onchange="onSelectTech(${idx}, this.value)" class="w-full rounded border-gray-300 py-1 text-sm shadow-sm focus:border-blue-500">
                        ${options}
                    </select>
                    <input type="hidden" class="task-data" data-sid="${task.serviceId}" data-cid="${task.comboId || ''}" data-start="${formatTime(task.startTime)}" data-end="${formatTime(task.endTime)}">
                </td>
            </tr>`;
            tbody.insertAdjacentHTML('beforeend', html);
        });

        validateSubmitButton();
    }

    function onSelectTech(rowIdx, techId) {
        if (techId) selectedTechMap[rowIdx] = techId; else delete selectedTechMap[rowIdx];
        renderAssignmentTable();
    }

    function checkOverlap(startA, endA, startB, endB) { return (startA < endB && startB < endA); }

    // Cập nhật hàm Tìm kiếm (Xử lý Hiện/Ẩn và Điền dữ liệu)
    async function searchCustomer() {
        const phone = document.getElementById('inputPhone').value;
        const statusDiv = document.getElementById('customerStatus');
        const infoFields = document.getElementById('customerInfoFields'); // Khung chứa Tên & Email
        const nameInput = document.getElementById('inputName');
        const emailInput = document.getElementById('inputEmail');

        if (!phone) {
            statusDiv.innerHTML = '<span class="text-red-500">Vui lòng nhập SĐT!</span>';
            return;
        }

        statusDiv.innerHTML = '<span class="text-gray-500 flex items-center gap-1"><span class="material-symbols-outlined text-xs animate-spin">sync</span> Đang tìm kiếm...</span>';

        try {
            const res = await fetch(`/Receptionist/Calendar/GetCustomerByPhone?phone=${phone}`);
            const data = await res.json();

            // HIỆN KHUNG NHẬP LIỆU RA
            infoFields.classList.remove('hidden');

            // === [THÊM] ĐÁNH DẤU ĐÃ TÌM KIẾM THÀNH CÔNG ===
            isCustomerVerified = true;
            // ==============================================

            let statusHtml = "";

            if (data.success && !data.isNew) {
                // TRƯỜNG HỢP: KHÁCH CŨ (Đã có TK)
                statusHtml = `<span class="text-green-600 font-bold flex items-center gap-1"><span class="material-symbols-outlined text-sm">check_circle</span> Khách cũ: ${data.data.membership}</span>`;

                // === [LOGIC MỚI] CHECK TRÙNG LỊCH TRÊN GIAO DIỆN (Frontend Warning) ===
                // Quét trong MASTER_DATA.events xem hôm nay khách này có lịch chưa?
                // Lưu ý: data.data.fullName là tên chuẩn từ DB.
                const customerName = data.data.fullName;

                // Tìm các event của khách này (Status != Cancelled)
                // MASTER_DATA.events chứa lịch của ngày đang xem
                const existingAppts = (MASTER_DATA.events || []).filter(e =>
                    e.CustomerName.toLowerCase() === customerName.toLowerCase()
                );

                if (existingAppts.length > 0) {
                    // Lấy giờ của lịch đầu tiên tìm thấy để cảnh báo
                    const firstEvt = existingAppts[0];
                    const timeStr = new Date(firstEvt.StartTime).toTimeString().substring(0,5);

                    statusHtml += `
                    <div class="mt-2 p-2 bg-orange-100 border border-orange-300 rounded text-orange-800 text-xs flex items-start gap-2">
                        <span class="material-symbols-outlined text-sm mt-0.5">warning</span>
                        <div>
                            <strong>Cảnh báo:</strong> Khách <b>${customerName}</b> đã có lịch hôm nay lúc <b>${timeStr}</b>.<br>
                            Vui lòng kiểm tra kỹ trước khi đặt thêm.
                        </div>
                    </div>`;
                }
                // ======================================================================

                // Điền dữ liệu tự động
                nameInput.value = data.data.fullName;
                emailInput.value = data.data.email || ""; // Điền email nếu có

                // Có thể khóa lại không cho sửa nếu muốn (Optional)
                nameInput.readOnly = true;
                emailInput.readOnly = true;
                nameInput.classList.add('bg-gray-100');
                emailInput.classList.add('bg-gray-100');

            } else {
                // TRƯỜNG HỢP: KHÁCH MỚI
                statusHtml = `<span class="text-blue-600 font-bold flex items-center gap-1"><span class="material-symbols-outlined text-sm">person_add</span> Khách mới - Vui lòng tạo thông tin</span>`;

                // Reset trắng để nhập mới
                nameInput.value = '';
                emailInput.value = '';
                nameInput.readOnly = false;
                emailInput.readOnly = false;
                nameInput.classList.remove('bg-gray-100');
                emailInput.classList.remove('bg-gray-100');

                // Focus vào ô tên để nhập cho nhanh
                nameInput.focus();
            }
            statusDiv.innerHTML = statusHtml;

            // === [THÊM] GỌI CHECK LẠI NÚT SUBMIT ===
            validateSubmitButton();
            // =======================================
        } catch (e) {
            console.error(e);
            statusDiv.innerHTML = '<span class="text-red-500">Lỗi kết nối server</span>';
