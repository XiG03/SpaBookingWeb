@model dynamic
@{
    Layout = null; 
}

<!DOCTYPE html>
<html>
<head>
    <title>In Hóa Đơn #@Model.InvoiceId</title>
    <style>
        body {
            font-family: 'Courier New', Courier, monospace;
            font-size: 12px;
            color: #000;
            margin: 0;
            padding: 10px;
            background: #fff;
            width: 300px;
            margin: 0 auto;
        }
        
        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .font-bold { font-weight: bold; }
        .uppercase { text-transform: uppercase; }
        
        .dashed-line {
            border-top: 1px dashed #000;
            margin: 10px 0;
        }

        table { width: 100%; border-collapse: collapse; }
        td, th { padding: 4px 0; vertical-align: top; }
        
        @@media print {
            body { 
                width: 100%;
                margin: 0; 
                padding: 0;
            }
            .no-print { display: none; }
            
            @@page { margin: 0; }
        }
    </style>
</head>
<body>

    <div class="text-center">
        <h2 class="uppercase" style="margin: 5px 0;">SPA BOOKING</h2>
        <div>Add: 123 ABC Street, Dist 1, HCMC</div>
        <div>Hotline: 0909.123.456</div>
    </div>

    <div class="dashed-line"></div>

    <div>
        <div>Invoice: <strong>#@Model.InvoiceId</strong></div>
        <div>Date: @Model.CreatedDate</div>
        <div>Customer: @Model.CustomerName</div>
        @if(!string.IsNullOrEmpty(Model.CustomerPhone))
        {
            <div>Phone: @Model.CustomerPhone</div>
        }
    </div>

    <div class="dashed-line"></div>

    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="text-align:left; border-bottom: 1px dashed #000;">
                <th style="padding: 5px 0; width:45%">Service</th>
                <th style="padding: 5px 0; width:30%">Tech/Tip</th>
                <th style="padding: 5px 0; width:25%" class="text-right">Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                // Logic kiểm tra loại Item (Header, Child, Normal)
                bool isHeader = false;
                bool isChild = false;

                // Dùng try-catch để tránh lỗi nếu Model cũ chưa cập nhật Property
                try { isHeader = item.IsHeader; } catch { }
                try { isChild = item.IsChild; } catch { }

                if (isHeader)
                {
                    // === TRƯỜNG HỢP 1: TÊN COMBO (HIỆN GIÁ TỔNG) ===
                    <tr style="border-bottom: 1px dotted #ccc;">
                        <td colspan="2" style="padding: 5px 0; vertical-align: top;">
                            <div class="font-bold uppercase">@item.Name</div>
                        </td>
                        <td class="text-right" style="padding: 5px 0; vertical-align: top;">
                            <div class="font-bold">@string.Format("{0:N0}", item.Price)</div>
                        </td>
                    </tr>
                }
                else if (isChild)
                {
                    // === TRƯỜNG HỢP 2: DỊCH VỤ TRONG COMBO (ẨN GIÁ) ===
                    <tr style="border-bottom: 1px dotted #eee;">
                        <td style="padding: 5px 0; padding-left: 15px; vertical-align: top;">
                            <div>- @item.Name</div>
                        </td>
                        <td style="padding: 5px 0; font-size:11px; vertical-align: top;">
                            <div>@item.Tech</div>
                            @if (item.Tip > 0) // Vẫn hiện Tip của KTV làm dịch vụ này
                            {
                                <div style="font-style:italic; margin-top:2px;">
                                    + Tip: @string.Format("{0:N0}", item.Tip)
                                </div>
                            }
                        </td>
                        <td class="text-right" style="padding: 5px 0; vertical-align: top;">
                        </td>
                    </tr>
                }
                else
                {
                    // === TRƯỜNG HỢP 3: DỊCH VỤ LẺ BÌNH THƯỜNG (CODE CŨ) ===
                    <tr style="border-bottom: 1px dotted #ccc;">
                        <td style="padding: 5px 0; vertical-align: top;">
                            <div class="font-bold">@item.Name</div>
                        </td>
                        <td style="padding: 5px 0; font-size:11px; vertical-align: top;">
                            <div style="font-weight:bold;">@item.Tech</div>

                            @if (item.Tip > 0)
                            {
                                <div style="font-style:italic; margin-top:2px;">
                                    + Tip: @string.Format("{0:N0}", item.Tip)
                                </div>
                            }
                        </td>
                        <td class="text-right" style="padding: 5px 0; vertical-align: top;">
                            <div>@string.Format("{0:N0}", item.Price)</div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="dashed-line"></div>

    <table style="width: 100%; margin-top: 5px;">
        <tr>
            <td>Subtotal:</td>
            <td class="text-right">@string.Format("{0:N0}", Model.SubTotal)</td>
        </tr>

        @if (Model.TotalTip > 0)
        {
            <tr>
                <td>Total Tip:</td>
                <td class="text-right">@string.Format("{0:N0}", Model.TotalTip)</td>
            </tr>
        }

        @if (Model.MemberDiscount > 0)
        {
            <tr>
                <td>
                    Member Desc. (@Model.MemberLevel):
                </td>
                <td class="text-right">
                    -@string.Format("{0:N0}", Model.MemberDiscount)
                </td>
            </tr>
        }

        @if (Model.VoucherDiscount > 0)
        {
            <tr>
                <td>
                    Voucher (@Model.VoucherCode):
                </td>
                <td class="text-right">
                    -@string.Format("{0:N0}", Model.VoucherDiscount)
                </td>
            </tr>
        }
        @if (Model.Deposit > 0)
        {
            <tr>
                <td>Less Deposit:</td>
                <td class="text-right">-@string.Format("{0:N0}", Model.Deposit)</td>
            </tr>
        }

        <tr style="font-size: 14px; border-top: 1px solid #000;">
            <td class="font-bold" style="padding-top: 5px;">TOTAL:</td>
            <td class="text-right font-bold" style="padding-top: 5px; font-size: 16px;">
                @string.Format("{0:N0}", Model.TotalAmount)
            </td>
        </tr>
        <tr>
            <td colspan="2" class="text-right" style="font-style:italic; font-size:10px;">
                (Method: @Model.PaymentMethod)
            </td>
        </tr>
    </table>

    <div class="dashed-line"></div>

    <div class="text-center" style="margin-top: 20px;">
        <div class="font-bold">THANK YOU!!</div>
        <div style="font-size: 10px; margin-top:5px">See you again!</div>
        <div style="font-size: 10px;">Pass Wifi: spa123456</div>
    </div>

    <div class="text-center no-print" style="margin-top: 30px; padding-bottom: 30px;">
        <button onclick="window.print()" style="padding: 10px 20px; font-weight:bold; cursor:pointer; background: #000; color: #fff; border: none;">
            🖨️ PRINT INVOICE
        </button>
        <div style="margin-top:10px; color:red; font-size:11px">
            *Select "Save as PDF" in print dialog to save file
        </div>
    </div>

    <script>
        window.onload = function() {
            setTimeout(function(){
                window.print();
            }, 500);
        };
    </script>
</body>
</html>
