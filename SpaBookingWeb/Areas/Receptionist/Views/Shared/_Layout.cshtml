@{
    // Lấy tên Controller và Action hiện tại từ URL
    var currentCtrl = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();

    // Hàm helper nhỏ để check active (giúp code gọn hơn)
    string IsActive(string ctrlName, string actName = null)
    {
        bool isCtrl = string.Equals(currentCtrl, ctrlName, StringComparison.OrdinalIgnoreCase);
        // Nếu truyền cả Action thì check cả 2, nếu không chỉ check Controller
        if (!string.IsNullOrEmpty(actName))
            return isCtrl && string.Equals(currentAction, actName, StringComparison.OrdinalIgnoreCase)
                   ? "bg-cyan-100 text-cyan-700"  // Class khi ĐANG CHỌN (Sáng)
                   : "text-gray-600 hover:bg-gray-50"; // Class khi KHÔNG chọn (Tối)

        return isCtrl ? "bg-cyan-100 text-cyan-700" : "text-gray-600 hover:bg-gray-50";
    }
}
<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <link rel="icon" href="favicon.ico">
    <title>Receptionist layout</title> <!-- Tab name -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="~/js/tailwind-config.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>

<body class="font-display bg-background-light dark:bg-background-dark text-text-light dark:text-text-dark">
    <div class="flex h-screen w-full overflow-hidden">
        <aside class="flex w-64 flex-col border-r border-gray-200/80 bg-white p-4 dark:border-gray-700/50 dark:bg-background-dark flex-shrink-0 hidden lg:flex">
            <div class="flex flex-col gap-4">
                <div class="flex items-center gap-3">
                    <div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuA7d7OINPL18luhXXiIT2YbkGu13QdGssWb7CFj-g7MgKSnO3AAb7Jx0-FbzPgYrXBOTQg6H2DytU_BZmWPkYXxjS3MigW5KOPmgGBGVW68Y-PPEXQ8LENz0mqiECrdjCnaKz3qfKEXE3Ar-Tl2ETZ5dRIDrQYwAmwYmS_ccOTl2bHScF5RRIqG-93JywbsZkPWr5-WCOzB6QGC2hQ9mKBU2Ke_-zlOCnUdyPFQLQhd_i1KP3YDerBKQ94CloQvhMwTkyekpVDB6tQh");'></div>
                    <div class="flex flex-col">
                        <h1 class="text-base font-bold">LushSpa</h1>
                        <p class="text-xs text-subtext-light dark:text-subtext-dark">Quản lý</p>
                    </div>
                </div>
                <div class="flex flex-col gap-2 mt-4">
                    <a class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-white/10 @IsActive("Calendar")" asp-area="Receptionist" asp-controller="Calendar" asp-action="Index"><span class="material-symbols-outlined">calendar_month</span><p class="text-sm font-medium">Dashboard</p></a>
                    <a class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-white/10 @IsActive("Payout")" asp-area="Receptionist" asp-controller="Payout" asp-action="Index"><span class="material-symbols-outlined">fingerprint</span><p class="text-sm font-medium">Technician Tip Payout</p></a>
                    <a class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-white/10 @IsActive("BookingList")" asp-area="Receptionist" asp-controller="BookingList" asp-action="Index"><span class="material-symbols-outlined">event_note</span><p class="text-sm font-medium">Appointment Management</p></a>
                    <a class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-white/10 @IsActive("Attendance")" asp-area="Receptionist" asp-controller="Attendance" asp-action="Index"><span class="material-symbols-outlined">fingerprint</span><p class="text-sm font-medium">Attendance</p></a>
                    <a class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-white/10 @IsActive("Profile")" asp-area="Receptionist" asp-controller="Profile" asp-action="Index"><span class="material-symbols-outlined">credit_card</span><p class="text-sm font-medium">My Profile</p></a>
                </div>
            </div>
        </aside>
        <!-- Sidebar left end-->

        <main role="main" class="flex-1 overflow-hidden">
            <div class="container-fluid">
                @RenderBody()
            </div> <!-- .container-fluid -->
        </main> <!-- main -->
    </div> <!-- .wrapper -->
    <script src="~/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>