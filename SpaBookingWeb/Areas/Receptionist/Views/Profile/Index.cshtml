@using Newtonsoft.Json
@model SpaBookingWeb.ViewModels.Receptionist.ReceptionistProfileVM
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "~/Areas/Receptionist/Views/Shared/_Layout.cshtml";
}

<div class="h-[calc(100vh-80px)] overflow-y-auto bg-gray-50 p-6">
    <div class="max-w-6xl mx-auto bg-white rounded-2xl shadow-xl overflow-hidden min-h-[800px]">

        <div class="h-40 bg-gradient-to-r from-blue-600 to-purple-600 relative"></div>

        <div class="px-8 pb-8">
            <div class="relative flex flex-col md:flex-row justify-between items-end -mt-16 mb-8 gap-4">
                <div class="flex items-end gap-6">
                    <div class="w-32 h-32 rounded-full border-4 border-white shadow-lg overflow-hidden bg-white group relative">
                        <img src="@Model.Avatar" class="w-full h-full object-cover transition transform group-hover:scale-110" onerror="this.src='https://ui-avatars.com/api/?name=@Model.FullName&background=random'" />
                    </div>
                    <div class="self-start md:mt-20 mt-4">
                        <h1 class="text-2xl font-bold text-gray-900">@Model.FullName</h1>
                        <div class="flex flex-wrap items-center gap-3 text-sm mt-1">
                            <span class="text-gray-500 font-bold">@Model.EmployeeCode</span>
                            <span class="hidden md:block w-1 h-1 bg-gray-300 rounded-full"></span>
                            <span class="text-blue-600 font-medium">@Model.JobTitle</span>
                            <span class="hidden md:block w-1 h-1 bg-gray-300 rounded-full"></span>
                            @if (Model.IsActive)
                            {
                                <span class="text-green-600 bg-green-50 px-2 py-0.5 rounded text-xs font-bold border border-green-100 flex items-center gap-1">
                                    <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></span> Đang hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="text-red-600 bg-red-50 px-2 py-0.5 rounded text-xs font-bold border border-red-100">Dừng hoạt động</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="flex bg-gray-100 p-1 rounded-lg self-end md:self-auto">
                    <button onclick="switchTab('overview')" id="btn-overview" class="tab-btn active px-4 py-2 text-sm font-medium rounded-md transition-all text-gray-700 hover:bg-white hover:shadow-sm">
                        Tổng quan hiệu suất
                    </button>
                    <button onclick="switchTab('salary')" id="btn-salary" class="tab-btn px-4 py-2 text-sm font-medium rounded-md transition-all text-gray-500 hover:text-gray-700 hover:bg-white hover:shadow-sm flex items-center gap-2">
                        Lương & Thu nhập
                        @if (Model.SalaryHistory != null && Model.SalaryHistory.Any(s => s.Status == "Pending"))
                        {
                            <span class="flex h-2 w-2 relative">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
                            </span>
                        }
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

                <div class="lg:col-span-1 space-y-6">
                    <div class="bg-gray-50 rounded-xl p-5 border border-gray-100">
                        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Thông tin nhân sự</h3>
                        <div class="space-y-4">
                            <div>
                                <label class="text-xs text-gray-500 block mb-1">Ngày vào làm</label>
                                <div class="font-medium text-gray-800 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-gray-400 text-sm">calendar_today</span>
                                    @Model.HireDate.ToString("dd/MM/yyyy")
                                </div>
                                <div class="text-xs text-blue-600 mt-1 font-medium">Thâm niên: @Model.SeniorityMonths tháng</div>
                            </div>
                            <div class="border-t border-gray-200 my-2"></div>
                            <div>
                                <label class="text-xs text-gray-500 block mb-1">Lương cơ bản</label>
                                <div class="font-bold text-gray-800 text-lg flex items-center gap-2">
                                    <span class="material-symbols-outlined text-gray-400 text-sm">payments</span>
                                    @Model.BaseSalary.ToString("N0") đ
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-gray-50 rounded-xl p-5 border border-gray-100">
                        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Liên hệ</h3>
                        <ul class="space-y-3 text-sm">
                            <li class="flex gap-3">
                                <span class="material-symbols-outlined text-gray-400">phone</span>
                                <span class="text-gray-700">@Model.PhoneNumber</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="material-symbols-outlined text-gray-400">mail</span>
                                <span class="text-gray-700 truncate" title="@Model.Email">@Model.Email</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="material-symbols-outlined text-gray-400">home</span>
                                <span class="text-gray-700">@Model.Address</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="lg:col-span-2">

                    <div id="tab-overview" class="tab-content block animate-fade-in">
                        <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
                            <span class="material-symbols-outlined text-blue-600">bar_chart</span> Hiệu suất tháng @DateTime.Now.Month
                        </h3>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                            <div class="bg-blue-50 p-4 rounded-xl border border-blue-100 hover:shadow-md transition">
                                <div class="text-blue-600 text-xs font-bold uppercase mb-1">Doanh số cá nhân</div>
                                <div class="text-2xl font-bold text-gray-900">@Model.CurrentMonthSales.ToString("N0")</div>
                                <div class="text-[10px] text-blue-400 mt-1">đơn vị: VNĐ</div>
                            </div>
                            <div class="bg-purple-50 p-4 rounded-xl border border-purple-100 hover:shadow-md transition">
                                <div class="text-purple-600 text-xs font-bold uppercase mb-1">Khách đã tiếp</div>
                                <div class="text-2xl font-bold text-gray-900">@Model.CustomersServed</div>
                                <div class="text-[10px] text-purple-400 mt-1">lượt check-in</div>
                            </div>
                            <div class="bg-orange-50 p-4 rounded-xl border border-orange-100 hover:shadow-md transition">
                                <div class="text-orange-600 text-xs font-bold uppercase mb-1">Tỷ lệ hủy lịch</div>
                                <div class="text-2xl font-bold text-gray-900">@Model.CancellationRate%</div>
                                <div class="text-[10px] text-orange-400 mt-1">trên tổng đơn tạo</div>
                            </div>
                        </div>

                        <div class="bg-white border border-gray-100 rounded-xl p-4 shadow-sm h-80 relative mb-6">
                            <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2 absolute top-4 left-4 z-10">
                                Tăng trưởng 6 tháng gần nhất
                            </h4>
                            <div id="growthChart" class="w-full h-full"></div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-6">
                                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                                    <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4 flex items-center gap-2">
                                        <span class="material-symbols-outlined text-sm">diamond</span> Top Dịch vụ & Upsell
                                    </h4>
                                    <div class="flex items-center justify-between mb-4 bg-orange-50 p-3 rounded-lg border border-orange-100">
                                        <div>
                                            <div class="text-sm font-medium text-orange-800">Tỷ lệ Upsell</div>
                                            <div class="text-[10px] text-orange-600 opacity-80">Đơn có >1 dịch vụ</div>
                                        </div>
                                        <span class="font-bold text-orange-600 text-xl">@Model.Quality.UpsellRate%</span>
                                    </div>
                                    <div class="space-y-3">
                                        @if (Model.Quality.TopServices != null && Model.Quality.TopServices.Any())
                                        {
                                            @foreach (var item in Model.Quality.TopServices)
                                            {
                                                <div class="flex justify-between items-center text-sm group hover:bg-gray-50 p-1 rounded transition">
                                                    <span class="text-gray-600 truncate max-w-[150px] font-medium" title="@item.ServiceName">@item.ServiceName</span>
                                                    <div class="flex items-center gap-3">
                                                        <span class="font-bold text-gray-800 bg-gray-100 px-1.5 rounded text-xs">@item.Quantity</span>
                                                        <span class="text-xs text-green-600 font-medium w-16 text-right">@item.TotalRevenue.ToString("#,##0")</span>
                                                    </div>
                                                </div>
                                                <div class="border-b border-gray-50 last:border-0"></div>
                                            }
                                        }
                                        else
                                        {
                                            <p class="text-xs text-gray-400 text-center py-4">Chưa có dữ liệu.</p>
                                        }
                                    </div>
                                </div>

                                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                                    <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4 flex items-center gap-2">
                                        <span class="material-symbols-outlined text-sm">pie_chart</span> Trạng thái T@(DateTime.Now.Month)
                                    </h4>
                                    <div class="grid grid-cols-2 gap-3">
                                        <div class="p-3 bg-blue-50 rounded-lg border border-blue-100 text-center">
                                            <div class="text-xl font-bold text-blue-700">@Model.Quality.StatusStats.Completed</div>
                                            <div class="text-xs text-blue-500 font-medium">Hoàn thành</div>
                                        </div>
                                        <div class="p-3 bg-yellow-50 rounded-lg border border-yellow-100 text-center">
                                            <div class="text-xl font-bold text-yellow-700">@Model.Quality.StatusStats.Pending</div>
                                            <div class="text-xs text-yellow-500 font-medium">Đang chờ</div>
                                        </div>
                                        <div class="p-3 bg-red-50 rounded-lg border border-red-100 text-center">
                                            <div class="text-xl font-bold text-red-700">@Model.Quality.StatusStats.Cancelled</div>
                                            <div class="text-xs text-red-500 font-medium">Đã hủy</div>
                                        </div>
                                        <div class="p-3 bg-gray-50 rounded-lg border border-gray-100 text-center flex flex-col justify-center">
                                            <span class="text-xs text-gray-400">Tổng</span>
                                            <span class="font-bold text-gray-600">@(Model.Quality.StatusStats.Completed + Model.Quality.StatusStats.Pending + Model.Quality.StatusStats.Cancelled + Model.Quality.StatusStats.InProgress)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="space-y-6">
                                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                                    <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4 flex items-center gap-2">
                                        <span class="material-symbols-outlined text-sm">history</span> Hoạt động gần đây
                                    </h4>
                                    <div class="relative pl-4 border-l-2 border-gray-100 space-y-6">
                                        @if (Model.RecentActivities != null && Model.RecentActivities.Any())
                                        {
                                            @foreach (var act in Model.RecentActivities)
                                            {
                                                <div class="relative">
                                                    <div class="absolute -left-[25px] bg-white border-2 border-white rounded-full z-10">
                                                        <div class="w-8 h-8 rounded-full flex items-center justify-center @act.ColorClass shadow-sm">
                                                            <span class="material-symbols-outlined text-sm">@act.Icon</span>
                                                        </div>
                                                    </div>
                                                    <div class="ml-6">
                                                        <div class="flex justify-between items-start">
                                                            <span class="text-sm font-bold text-gray-800">@act.Title</span>
                                                            <span class="text-[10px] text-gray-400 font-mono mt-0.5">@act.Timestamp.ToString("HH:mm dd/MM")</span>
                                                        </div>
                                                        <p class="text-xs text-gray-500 mt-0.5 line-clamp-1">@act.Description</p>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="text-xs text-gray-400 italic pl-6">Chưa có hoạt động.</div>
                                        }
                                    </div>
                                </div>

                                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                                    <div class="flex justify-between items-center mb-4">
                                        <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider flex items-center gap-2">
                                            <span class="material-symbols-outlined text-sm">schedule</span> Chấm công T@(DateTime.Now.Month)
                                        </h4>
                                        <div class="text-[10px] font-bold bg-blue-50 text-blue-700 px-2 py-1 rounded">
                                            @Model.Attendance.WorkDaysActual / @Model.Attendance.WorkDaysStandard ngày
                                        </div>
                                    </div>
                                    <div class="border rounded-lg border-gray-100 overflow-hidden bg-white">
                                        <div class="overflow-y-auto max-h-48 scrollbar-thin scrollbar-thumb-gray-200">
                                            <table class="w-full text-sm text-left relative border-collapse">
                                                <thead class="text-[10px] text-gray-500 uppercase bg-gray-50 sticky top-0 z-10">
                                                    <tr>
                                                        <th class="px-3 py-2">Ngày</th>
                                                        <th class="px-3 py-2">Vào</th>
                                                        <th class="px-3 py-2">Ra</th>
                                                        <th class="px-3 py-2 text-right">TT</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-gray-100">
                                                    @if (Model.Attendance.RecentLogs != null)
                                                    {
                                                        @foreach (var log in Model.Attendance.RecentLogs)
                                                        {
                                                            <tr class="hover:bg-gray-50">
                                                                <td class="px-3 py-2 text-gray-700 text-xs">@log.Date.ToString("dd/MM")</td>
                                                                <td class="px-3 py-2 text-gray-500 font-mono text-xs">@(log.CheckIn?.ToString(@"hh\:mm") ?? "--")</td>
                                                                <td class="px-3 py-2 text-gray-500 font-mono text-xs">@(log.CheckOut?.ToString(@"hh\:mm") ?? "--")</td>
                                                                <td class="px-3 py-2 text-right">
                                                                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold border @log.StatusColor">@log.Status</span>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="tab-salary" class="tab-content hidden animate-fade-in">
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                                <span class="material-symbols-outlined text-green-600">payments</span> Lịch sử nhận lương
                            </h3>
                            <button onclick="window.location.reload()" class="text-xs text-gray-500 hover:text-blue-600 flex items-center gap-1 transition">
                                <span class="material-symbols-outlined text-sm">refresh</span> Cập nhật
                            </button>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                            <div class="bg-gradient-to-br from-green-50 to-emerald-50 border border-green-100 p-5 rounded-xl">
                                <p class="text-xs font-bold text-green-600 uppercase mb-1">Tổng thực lãnh (Năm @DateTime.Now.Year)</p>
                                <p class="text-2xl font-bold text-gray-800">
                                    @((Model.SalaryHistory?.Where(s => s.Year == DateTime.Now.Year).Sum(s => s.TotalSalary) ?? 0).ToString("N0")) đ
                                </p>
                            </div>
                            <div class="bg-white border border-gray-100 p-5 rounded-xl">
                                <p class="text-xs font-bold text-gray-400 uppercase mb-1">Đang chờ nhận</p>
                                <p class="text-2xl font-bold text-orange-500">
                                    @((Model.SalaryHistory?.Where(s => s.Status == "Pending").Sum(s => s.TotalSalary) ?? 0).ToString("N0")) đ
                                </p>
                            </div>
                        </div>

                        <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
                            <div class="overflow-x-auto">
                                <table class="w-full text-sm text-left">
                                    <thead class="bg-gray-50 text-gray-500 uppercase text-xs font-bold">
                                        <tr>
                                            <th class="px-6 py-4">Kỳ lương</th>
                                            <th class="px-6 py-4 text-right">Lương cứng</th>
                                            <th class="px-6 py-4 text-right">Hoa hồng</th>
                                            <th class="px-6 py-4 text-right">Thưởng/Phạt</th>
                                            <th class="px-6 py-4 text-right text-blue-700">Thực lãnh</th>
                                            <th class="px-6 py-4 text-center">Trạng thái</th>
                                            <th class="px-6 py-4 text-center">Hành động</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100">
                                        @if (Model.SalaryHistory != null && Model.SalaryHistory.Any())
                                        {
                                            @foreach (var item in Model.SalaryHistory)
                                            {
                                                <tr class="hover:bg-gray-50 transition">
                                                    <td class="px-6 py-4 font-medium text-gray-900">
                                                        Tháng @item.Month/@item.Year
                                                    </td>
                                                    <td class="px-6 py-4 text-right text-gray-500">@item.BaseSalary.ToString("N0")</td>
                                                    <td class="px-6 py-4 text-right text-gray-600">@item.Commission.ToString("N0")</td>
                                                    <td class="px-6 py-4 text-right">
                                                        <div class="flex flex-col items-end gap-1">
                                                            @if (item.Bonus > 0)
                                                            {
                                                                <span class="text-green-600 text-xs">+@item.Bonus.ToString("N0")</span>
                                                            }
                                                            @if (item.Deduction > 0)
                                                            {
                                                                <span class="text-red-500 text-xs">-@item.Deduction.ToString("N0")</span>
                                                            }
                                                            @if (item.Bonus == 0 && item.Deduction == 0)
                                                            {
                                                                <span class="text-gray-300">-</span>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td class="px-6 py-4 text-right font-bold text-blue-700 text-base">
                                                        @item.TotalSalary.ToString("N0")
                                                    </td>
                                                    <td class="px-6 py-4 text-center">
                                                        @if (item.Status == "Completed")
                                                        {
                                                            <span class="inline-flex items-center gap-1 bg-green-100 text-green-700 px-2.5 py-1 rounded-full text-xs font-bold border border-green-200">
                                                                <span class="material-symbols-outlined text-[14px]">check</span> Đã nhận
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="inline-flex items-center gap-1 bg-yellow-100 text-yellow-700 px-2.5 py-1 rounded-full text-xs font-bold border border-yellow-200 animate-pulse">
                                                                <span class="material-symbols-outlined text-[14px]">hourglass_empty</span> Chờ xác nhận
                                                            </span>
                                                        }
                                                    </td>
                                                    <td class="px-6 py-4 text-center">
                                                        @if (item.Status == "Pending")
                                                        {
                                                            <button onclick="confirmSalary(@item.SalaryId, @item.Month, @item.Year, @item.TotalSalary)"
                                                                    class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-xs font-bold shadow-sm transition transform active:scale-95 flex items-center justify-center gap-1 mx-auto">
                                                                <span class="material-symbols-outlined text-[16px]">signature</span> Xác nhận
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button disabled class="text-gray-300 cursor-not-allowed mx-auto">
                                                                <span class="material-symbols-outlined">lock</span>
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="7" class="px-6 py-12 text-center text-gray-400 bg-gray-50/50 italic">
                                                    <span class="material-symbols-outlined text-4xl mb-2 block text-gray-300">receipt_long</span>
                                                    Chưa có lịch sử lương nào.
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .tab-btn.active {
        background-color: white;
        color: #2563EB; /* Blue-600 */
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        font-weight: 700;
    }

    .animate-fade-in {
        animation: fadeIn 0.3s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

<script>
    // 1. HÀM CHUYỂN TAB
    function switchTab(tabName) {
        // Ẩn tất cả tab content
        document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));

        // Bỏ active class ở buttons
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));

        // Hiện tab được chọn
        document.getElementById(`tab-${tabName}`).classList.remove('hidden');
        document.getElementById(`btn-${tabName}`).classList.add('active');
    }

    // 2. HÀM XÁC NHẬN LƯƠNG
    async function confirmSalary(id, month, year, amount) {
        const formattedAmount = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);

        const result = await Swal.fire({
            title: `Xác nhận lương T${month}/${year}?`,
            html: `Bạn xác nhận đã nhận đủ số tiền: <b style="color:#2563EB; font-size:1.2em">${formattedAmount}</b>?<br><span style="font-size:0.9em; color:#666">Hành động này không thể hoàn tác.</span>`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#2563EB',
            cancelButtonColor: '#9CA3AF',
            confirmButtonText: '✅ Đúng, tôi đã nhận',
            cancelButtonText: 'Hủy bỏ'
        });

        if (result.isConfirmed) {
            try {
                // Hiển thị loading
                Swal.fire({
                    title: 'Đang xử lý...',
                    didOpen: () => { Swal.showLoading() },
                    allowOutsideClick: false
                });

                const res = await fetch(`/Receptionist/Profile/ConfirmSalary?id=${id}`, { method: 'POST' });
                const data = await res.json();

                if (data.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        text: data.message,
                        timer: 2000,
                        showConfirmButton: false
                    });
                    window.location.reload();
                } else {
                    Swal.fire('Lỗi!', data.message, 'error');
                }
            } catch (e) {
                Swal.fire('Lỗi hệ thống!', 'Không thể kết nối đến server.', 'error');
            }
        }
    }

    // 3. VẼ BIỂU ĐỒ (CODE CŨ GIỮ NGUYÊN)
    document.addEventListener('DOMContentLoaded', function () {
        const rawData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthlyStats ?? new List<SpaBookingWeb.ViewModels.Receptionist.MonthlyStat>()));

        if (!rawData || rawData.length === 0) return; // Tránh lỗi nếu không có data

        const labels = rawData.map(x => x.MonthLabel);
        const revenueData = rawData.map(x => x.TotalRevenue);
        const customerData = rawData.map(x => x.CustomerCount);

        var options = {
            series: [{
                name: 'Doanh số (VNĐ)',
                type: 'column',
                data: revenueData
            }, {
                name: 'Lượt khách',
                type: 'line',
                data: customerData
            }],
            chart: {
                height: 300,
                type: 'line',
                toolbar: { show: false },
                fontFamily: 'Inter, sans-serif'
            },
            stroke: {
                width: [0, 4],
                curve: 'smooth'
            },
            plotOptions: {
                bar: {
                    columnWidth: '50%',
                    borderRadius: 4
                }
            },
            dataLabels: { enabled: false },
            labels: labels,
            yaxis: [{
                title: { text: 'Doanh số', style: { color: '#2563EB' } },
                labels: {
                    formatter: function (value) {
                        if(value >= 1000000) return (value/1000000).toFixed(1) + 'M';
                        return value;
                    },
                    style: { colors: '#2563EB' }
                }
            }, {
                opposite: true,
                title: { text: 'Lượt khách', style: { color: '#F59E0B' } },
                labels: { style: { colors: '#F59E0B' } }
            }],
            colors: ['#2563EB', '#F59E0B'],
            tooltip: {
                shared: true,
                intersect: false,
                y: {
                    formatter: function (y, { seriesIndex }) {
                        if (seriesIndex === 0) return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(y);
                        return y + " lượt";
                    }
                }
            },
            legend: {
                position: 'top',
                horizontalAlign: 'right'
            }
        };

        var chart = new ApexCharts(document.querySelector("#growthChart"), options);
        chart.render();
    });
</script>