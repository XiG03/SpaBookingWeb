@model SpaBookingWeb.ViewModels.Receptionist.ReceptionistProfileVM
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "~/Areas/Receptionist/Views/Shared/_Layout.cshtml";
}

<div class="h-[calc(100vh-80px)] overflow-y-auto bg-gray-50 p-6">
    <div class="max-w-5xl mx-auto bg-white rounded-2xl shadow-xl overflow-hidden">

        <div class="h-40 bg-gradient-to-r from-blue-600 to-purple-600 relative">
            
        </div>

        <div class="px-8 pb-8">
            <div class="relative flex justify-between items-end -mt-16 mb-6">
                <div class="flex items-end gap-6">
                    <div class="w-32 h-32 rounded-full border-4 border-white shadow-lg overflow-hidden bg-white">
                        <img src="@Model.Avatar" class="w-full h-full object-cover" onerror="this.src='https://ui-avatars.com/api/?name=@Model.FullName&background=random'" />
                    </div>
                    <div class="self-start mt-20">
                        <h1 class="text-2xl font-bold text-gray-900">@Model.FullName</h1>
                        <div class="flex items-center gap-3 text-sm mt-1">
                            <span class="text-gray-500 font-bold">@Model.EmployeeCode</span>
                            <span class="w-1 h-1 bg-gray-300 rounded-full"></span>
                            <span class="text-blue-600 font-medium">@Model.JobTitle</span>
                            <span class="w-1 h-1 bg-gray-300 rounded-full"></span>
                            @if (Model.IsActive)
                            {
                                <span class="text-green-600 bg-green-50 px-2 py-0.5 rounded text-xs font-bold border border-green-100">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="text-red-600 bg-red-50 px-2 py-0.5 rounded text-xs font-bold border border-red-100">Dừng hoạt động</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

                <div class="lg:col-span-1 space-y-6">
                    <div class="bg-gray-50 rounded-xl p-5 border border-gray-100">
                        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Thông tin nhân sự</h3>

                        <div class="space-y-4">
                            <div>
                                <label class="text-xs text-gray-500 block mb-1">Ngày vào làm</label>
                                <div class="font-medium text-gray-800 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-gray-400 text-sm">calendar_today</span>
                                    @Model.HireDate.ToString("dd/MM/yyyy")
                                </div>
                                <div class="text-xs text-blue-600 mt-1 font-medium">Thâm niên: @Model.SeniorityMonths tháng</div>
                            </div>

                            <div class="border-t border-gray-200 my-2"></div>

                            <div>
                                <label class="text-xs text-gray-500 block mb-1">Lương cơ bản</label>
                                <div class="font-bold text-gray-800 text-lg flex items-center gap-2">
                                    <span class="material-symbols-outlined text-gray-400 text-sm">payments</span>
                                    @Model.BaseSalary.ToString("N0") đ
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-gray-50 rounded-xl p-5 border border-gray-100">
                        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Liên hệ</h3>
                        <ul class="space-y-3 text-sm">
                            <li class="flex gap-3">
                                <span class="material-symbols-outlined text-gray-400">phone</span>
                                <span class="text-gray-700">@Model.PhoneNumber</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="material-symbols-outlined text-gray-400">mail</span>
                                <span class="text-gray-700 truncate">@Model.Email</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="material-symbols-outlined text-gray-400">home</span>
                                <span class="text-gray-700">@Model.Address</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="lg:col-span-2">
                    <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
                        <span class="material-symbols-outlined text-blue-600">bar_chart</span> Hiệu suất tháng @DateTime.Now.Month
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                        <div class="bg-blue-50 p-4 rounded-xl border border-blue-100">
                            <div class="text-blue-600 text-sm font-bold uppercase mb-1">Doanh số cá nhân</div>
                            <div class="text-2xl font-bold text-gray-900">@Model.CurrentMonthSales.ToString("N0")</div>
                            <div class="text-xs text-blue-400 mt-1">đơn vị: VNĐ</div>
                        </div>

                        <div class="bg-purple-50 p-4 rounded-xl border border-purple-100">
                            <div class="text-purple-600 text-sm font-bold uppercase mb-1">Khách đã tiếp</div>
                            <div class="text-2xl font-bold text-gray-900">@Model.CustomersServed</div>
                            <div class="text-xs text-purple-400 mt-1">lượt check-in</div>
                        </div>

                        <div class="bg-orange-50 p-4 rounded-xl border border-orange-100">
                            <div class="text-orange-600 text-sm font-bold uppercase mb-1">Tỷ lệ hủy lịch</div>
                            <div class="text-2xl font-bold text-gray-900">@Model.CancellationRate%</div>
                            <div class="text-xs text-orange-400 mt-1">trên tổng đơn tạo</div>
                        </div>
                    </div>

                    <div class="bg-white border border-gray-100 rounded-xl p-4 shadow-sm h-80 relative">
                        <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2 absolute top-4 left-4 z-10">
                            Tăng trưởng 6 tháng gần nhất
                        </h4>
                        <div id="growthChart" class="w-full h-full"></div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">

                        <div class="space-y-6">

                            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                                <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-sm">diamond</span> Top Dịch vụ & Upsell
                                </h4>

                                <div class="flex items-center justify-between mb-4 bg-orange-50 p-3 rounded-lg border border-orange-100">
                                    <div>
                                        <div class="text-sm font-medium text-orange-800">Tỷ lệ Upsell (Combo)</div>
                                        <div class="text-[10px] text-orange-600 opacity-80">Đơn có >1 dịch vụ</div>
                                    </div>
                                    <span class="font-bold text-orange-600 text-xl">@Model.Quality.UpsellRate%</span>
                                </div>

                                <div class="space-y-3">
                                    @if (Model.Quality.TopServices.Any())
                                    {
                                        @foreach (var item in Model.Quality.TopServices)
                                        {
                                            <div class="flex justify-between items-center text-sm group hover:bg-gray-50 p-1 rounded transition">
                                                <span class="text-gray-600 truncate max-w-[150px] font-medium" title="@item.ServiceName">@item.ServiceName</span>
                                                <div class="flex items-center gap-3">
                                                    <span class="font-bold text-gray-800 bg-gray-100 px-1.5 rounded text-xs">@item.Quantity</span>
                                                    <span class="text-xs text-green-600 font-medium w-16 text-right">@item.TotalRevenue.ToString("#,##0")</span>
                                                </div>
                                            </div>
                                            <div class="border-b border-gray-50 last:border-0"></div>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-xs text-gray-400 text-center py-4">Chưa có dữ liệu.</p>
                                    }
                                </div>
                            </div>

                            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                                <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-sm">pie_chart</span> Trạng thái tháng @DateTime.Now.Month
                                </h4>
                                <div class="grid grid-cols-2 gap-3">
                                    <div class="p-3 bg-blue-50 rounded-lg border border-blue-100 text-center">
                                        <div class="text-xl font-bold text-blue-700">@Model.Quality.StatusStats.Completed</div>
                                        <div class="text-xs text-blue-500 font-medium">Hoàn thành</div>
                                    </div>
                                    <div class="p-3 bg-yellow-50 rounded-lg border border-yellow-100 text-center">
                                        <div class="text-xl font-bold text-yellow-700">@Model.Quality.StatusStats.Pending</div>
                                        <div class="text-xs text-yellow-500 font-medium">Đang chờ/xử lý</div>
                                    </div>
                                    <div class="p-3 bg-red-50 rounded-lg border border-red-100 text-center">
                                        <div class="text-xl font-bold text-red-700">@Model.Quality.StatusStats.Cancelled</div>
                                        <div class="text-xs text-red-500 font-medium">Đã hủy</div>
                                    </div>
                                    <div class="p-3 bg-gray-50 rounded-lg border border-gray-100 text-center flex flex-col justify-center">
                                        <span class="text-xs text-gray-400">Tổng đơn</span>
                                        <span class="font-bold text-gray-600">@(Model.Quality.StatusStats.Completed + Model.Quality.StatusStats.Pending + Model.Quality.StatusStats.Cancelled + Model.Quality.StatusStats.InProgress)</span>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 h-full">
                            <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4 flex items-center gap-2">
                                <span class="material-symbols-outlined text-sm">history</span> Hoạt động gần đây
                            </h4>

                            <div class="relative pl-4 border-l-2 border-gray-100 space-y-6">
                                @if (Model.RecentActivities.Any())
                                {
                                    @foreach (var act in Model.RecentActivities)
                                    {
                                        <div class="relative">
                                            <div class="absolute -left-[25px] bg-white border-2 border-white rounded-full z-10">
                                                <div class="w-8 h-8 rounded-full flex items-center justify-center @act.ColorClass shadow-sm">
                                                    <span class="material-symbols-outlined text-sm">@act.Icon</span>
                                                </div>
                                            </div>

                                            <div class="ml-6">
                                                <div class="flex justify-between items-start">
                                                    <span class="text-sm font-bold text-gray-800">@act.Title</span>
                                                    <span class="text-[10px] text-gray-400 font-mono mt-0.5">@act.Timestamp.ToString("HH:mm dd/MM")</span>
                                                </div>
                                                <p class="text-xs text-gray-500 mt-0.5 line-clamp-1">@act.Description</p>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-xs text-gray-400 italic pl-6">Chưa có hoạt động nào gần đây.</div>
                                }
                            </div>
                        </div>

                        <div class="md:col-span-2 bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4 gap-2">
                                <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider flex items-center gap-2">
                                    <span class="material-symbols-outlined text-sm">schedule</span> Chấm công tháng @DateTime.Now.Month
                                </h4>
                                <div class="text-xs font-medium bg-blue-50 border border-blue-100 px-3 py-1.5 rounded-lg text-blue-700 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-sm">event_available</span>
                                    Công thực tế: <span class="font-bold text-lg">@Model.Attendance.WorkDaysActual</span> / @Model.Attendance.WorkDaysStandard
                                </div>
                            </div>

                            <div class="border rounded-lg border-gray-100 overflow-hidden bg-white">

                                <div class="overflow-y-auto max-h-64 scrollbar-thin scrollbar-thumb-gray-200 scrollbar-track-gray-50">

                                    <table class="w-full text-sm text-left relative border-collapse">
                                        <thead class="text-xs text-gray-500 uppercase bg-gray-50 text-gray-500 sticky top-0 z-10 shadow-sm">
                                            <tr>
                                                <th class="px-4 py-3 font-semibold bg-gray-50">Ngày</th>
                                                <th class="px-4 py-3 font-semibold bg-gray-50">Giờ vào</th>
                                                <th class="px-4 py-3 font-semibold bg-gray-50">Giờ ra</th>
                                                <th class="px-4 py-3 font-semibold text-right bg-gray-50">Trạng thái</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-gray-100 bg-white">
                                            @foreach (var log in Model.Attendance.RecentLogs)
                                            {
                                                <tr class="hover:bg-gray-50 transition-colors">
                                                    <td class="px-4 py-3 font-medium text-gray-700">@log.Date.ToString("dd/MM/yyyy")</td>
                                                    <td class="px-4 py-3 text-gray-500 font-mono">@(log.CheckIn?.ToString(@"hh\:mm") ?? "--:--")</td>
                                                    <td class="px-4 py-3 text-gray-500 font-mono">@(log.CheckOut?.ToString(@"hh\:mm") ?? "--:--")</td>
                                                    <td class="px-4 py-3 text-right">
                                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border @log.StatusColor">
                                                            @log.Status
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            @if (Model.Attendance.LateMinutesTotal > 0)
                            {
                                <div class="mt-3 p-3 bg-red-50 rounded-lg border border-red-100 flex items-center gap-2 text-xs text-red-600">
                                    <span class="material-symbols-outlined text-lg">warning</span>
                                    <span>Bạn có tổng cộng <b>@Model.Attendance.LateMinutesTotal phút</b> đi muộn trong tháng này. Hãy chú ý giờ giấc nhé!</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // 1. Lấy dữ liệu từ Server (Razor -> JS)
        // Serialize dữ liệu C# sang JSON để JS đọc được
        const rawData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthlyStats));

        // Tách mảng dữ liệu
        const labels = rawData.map(x => x.MonthLabel);     // ["T8", "T9", ...]
        const revenueData = rawData.map(x => x.TotalRevenue); // [50tr, 60tr, ...]
        const customerData = rawData.map(x => x.CustomerCount); // [120, 150, ...]

        // 2. Cấu hình Biểu đồ (Mixed Chart: Cột + Đường)
        var options = {
            series: [{
                name: 'Doanh số (VNĐ)',
                type: 'column',
                data: revenueData
            }, {
                name: 'Lượt khách',
                type: 'line',
                data: customerData
            }],
            chart: {
                height: 300, // Chiều cao khớp với container
                type: 'line', // Loại biểu đồ chính
                toolbar: { show: false }, // Ẩn thanh công cụ thừa
                fontFamily: 'Inter, sans-serif'
            },
            stroke: {
                width: [0, 4], // Cột không viền, Đường dày 4px
                curve: 'smooth' // Đường cong mềm mại
            },
            plotOptions: {
                bar: {
                    columnWidth: '50%',
                    borderRadius: 4 // Bo góc cột cho mềm
                }
            },
            dataLabels: {
                enabled: false // Ẩn số trên biểu đồ cho đỡ rối
            },
            labels: labels, // Trục hoành (Tháng)

            // Cấu hình 2 Trục tung (Y-Axis)
            yaxis: [{
                title: { text: 'Doanh số', style: { color: '#2563EB' } },
                labels: {
                    formatter: function (value) {
                        // Format tiền Việt: 1.000.000 -> 1M cho gọn
                        if(value >= 1000000) return (value/1000000).toFixed(1) + 'M';
                        return value;
                    },
                    style: { colors: '#2563EB' } // Màu xanh
                }
            }, {
                opposite: true, // Trục này nằm bên phải
                title: { text: 'Lượt khách', style: { color: '#F59E0B' } },
                labels: {
                    style: { colors: '#F59E0B' } // Màu cam
                }
            }],

            // Màu sắc: Xanh (Doanh số), Cam (Khách)
            colors: ['#2563EB', '#F59E0B'],

            // Tooltip khi rê chuột
            tooltip: {
                shared: true,
                intersect: false,
                y: {
                    formatter: function (y, { seriesIndex }) {
                        if (seriesIndex === 0) { // Doanh số
                            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(y);
                        }
                        return y + " lượt"; // Khách
                    }
                }
            },
            legend: {
                position: 'top',
                horizontalAlign: 'right'
            }
        };

        // 3. Vẽ biểu đồ
        var chart = new ApexCharts(document.querySelector("#growthChart"), options);
        chart.render();
    });
</script>
