@{
    ViewData["Title"] = "Quản lý Đơn hàng";
    Layout = "~/Areas/Receptionist/Views/Shared/_Layout.cshtml";
}

<div class="p-6 bg-gray-50 h-[calc(100vh-80px)] overflow-y-auto">
    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 mb-6">
        <div class="flex flex-col md:flex-row justify-between items-center mb-4 gap-4">
            <h1 class="text-2xl font-bold text-gray-800 flex items-center gap-2">
                <span class="material-symbols-outlined text-blue-600">toc</span> Quản lý Đơn hàng
            </h1>

            <div class="relative w-full md:w-96">
                <input type="text" id="filterKeyword" placeholder="Tìm SĐT, Tên khách, Mã đơn..."
                       class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 transition"
                       onkeydown="if(event.key==='Enter') loadData()">
                <span class="material-symbols-outlined absolute left-3 top-2.5 text-gray-400">search</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
            <div>
                <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Từ ngày</label>
                <input type="date" id="filterFromDate" class="w-full border-gray-300 rounded-lg text-sm font-bold">
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Đến ngày</label>
                <input type="date" id="filterToDate" class="w-full border-gray-300 rounded-lg text-sm font-bold">
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Trạng thái</label>
                <select id="filterStatus" class="w-full border-gray-300 rounded-lg text-sm">
                    <option value="All">-- Tất cả --</option>
                    <option value="Pending">Đang chờ (Pending)</option>
                    <option value="Confirmed">Đã xác nhận</option>
                    <option value="InProgress">Đang làm (In Progress)</option>
                    <option value="Completed">Hoàn thành</option>
                    <option value="Cancelled" class="text-red-600 font-bold">✖ Đã hủy (Cancelled)</option>
                </select>
            </div>
            <button onclick="loadData()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg flex justify-center items-center gap-2">
                <span class="material-symbols-outlined">filter_alt</span> Lọc dữ liệu
            </button>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Mã</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Khách hàng</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dịch vụ</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Thời gian hẹn</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Tổng tiền</th>
                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Trạng thái</th>
                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Thao tác</th>
                </tr>
            </thead>
            <tbody id="tableBody" class="bg-white divide-y divide-gray-200">
            </tbody>
        </table>

        <div id="loadingRow" class="hidden p-10 text-center text-gray-500">
            <span class="material-symbols-outlined animate-spin text-3xl">sync</span>
            <p class="mt-2 text-sm">Đang tải dữ liệu...</p>
        </div>

        <div id="emptyRow" class="hidden p-10 text-center text-gray-400">
            <span class="material-symbols-outlined text-4xl mb-2">inbox</span>
            <p>Không tìm thấy đơn hàng nào.</p>
        </div>
    </div>
</div>

<div id="detailModal" class="fixed inset-0 z-50 hidden" aria-modal="true">
    <div class="fixed inset-0 bg-gray-900 bg-opacity-75 backdrop-blur-sm" onclick="document.getElementById('detailModal').classList.add('hidden')"></div>
    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="relative bg-white rounded-xl shadow-2xl w-full max-w-2xl overflow-hidden animate-fade-in-down">
                <div class="bg-purple-600 px-6 py-4 flex justify-between items-center text-white">
                    <h3 class="text-lg font-bold flex items-center gap-2">
                        <span class="material-symbols-outlined">visibility</span> Chi tiết lịch hẹn
                    </h3>
                    <button onclick="document.getElementById('detailModal').classList.add('hidden')" class="hover:text-purple-200"><span class="material-symbols-outlined">close</span></button>
                </div>

                <div class="p-6 space-y-4">
                    <div class="grid grid-cols-2 gap-4 bg-gray-50 p-4 rounded-lg border">
                        <div>
                            <label class="text-xs text-gray-500 uppercase font-bold">Khách hàng</label>
                            <div class="font-bold text-gray-800 text-lg" id="detailCustomerName">...</div>
                            <div class="text-sm text-gray-600 mb-2" id="detailCustomerPhone">...</div>
                            <span id="detailStatus" class="px-2 py-1 rounded text-xs font-bold bg-gray-200">...</span>
                        </div>
                        <div class="text-right">
                            <label class="text-xs text-blue-600 uppercase font-bold">Thời gian hẹn</label>
                            <div class="text-2xl font-bold text-blue-700" id="detailTimeRange">...</div>
                            <div class="text-sm font-bold text-gray-700" id="detailBookingDate">...</div>
                            <div class="mt-3 text-xs text-gray-500">Tạo: <span id="detailCreatedDate"></span></div>
                        </div>
                    </div>

                    <div>
                        <label class="text-xs text-gray-500 uppercase font-bold">Ghi chú / Yêu cầu</label>
                        <div id="detailNotes" class="p-3 bg-yellow-50 border border-yellow-100 rounded text-sm text-gray-700 italic min-h-[40px]"></div>
                    </div>

                    <div>
                        <label class="text-xs text-gray-500 uppercase font-bold mb-2 block">Chi tiết dịch vụ</label>
                        <div class="border rounded overflow-hidden">
                            <table class="w-full text-sm text-left">
                                <thead class="bg-gray-100 text-gray-600 font-bold border-b">
                                    <tr>
                                        <th class="p-2">Khách</th>
                                        <th class="p-2">Dịch vụ</th>
                                        <th class="p-2">KTV</th>
                                        <th class="p-2 text-right">Giá</th>
                                    </tr>
                                </thead>
                                <tbody id="detailItemsBody" class="divide-y"></tbody>
                                <tfoot class="bg-gray-50 font-bold border-t">
                                    <tr>
                                        <td colspan="3" class="p-2 text-right">Tổng cộng:</td>
                                        <td class="p-2 text-right text-blue-600" id="detailTotal">0 đ</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="bg-gray-50 px-6 py-4 flex justify-end">
                    <button onclick="document.getElementById('detailModal').classList.add('hidden')" class="px-4 py-2 bg-white border border-gray-300 rounded font-bold hover:bg-gray-100 text-gray-700">Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // INIT: Mặc định lọc ngày hôm nay
    document.addEventListener("DOMContentLoaded", function() {
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('filterFromDate').value = today;
        document.getElementById('filterToDate').value = today;
        loadData();
    });

    async function loadData() {
        const from = document.getElementById('filterFromDate').value;
        const to = document.getElementById('filterToDate').value;
        const status = document.getElementById('filterStatus').value;
        const keyword = document.getElementById('filterKeyword').value;

        const tbody = document.getElementById('tableBody');
        const loading = document.getElementById('loadingRow');
        const empty = document.getElementById('emptyRow');

        tbody.innerHTML = '';
        loading.classList.remove('hidden');
        empty.classList.add('hidden');

        try {
            const res = await fetch(`/Receptionist/BookingList/GetBookings?fromDate=${from}&toDate=${to}&status=${status}&keyword=${keyword}`);
            const json = await res.json();

            loading.classList.add('hidden');

            if (json.success && json.data.length > 0) {
                const fmtMoney = new Intl.NumberFormat('vi-VN', {style:'currency', currency:'VND'});

                json.data.forEach(item => {
                    // Xử lý màu sắc trạng thái
                    let statusClass = "bg-gray-100 text-gray-600";
                    let rowClass = "hover:bg-gray-50";

                    if(item.status === 'Cancelled') {
                        statusClass = "bg-red-100 text-red-700";
                        rowClass = "bg-red-50 hover:bg-red-100"; // Làm nổi bật dòng hủy
                    } else if (item.status === 'Completed') statusClass = "bg-green-100 text-green-700";
                    else if (item.status === 'InProgress') statusClass = "bg-purple-100 text-purple-700";
                    else if (item.status === 'Confirmed') statusClass = "bg-blue-100 text-blue-700";
                    else if (item.status === 'Pending') statusClass = "bg-yellow-100 text-yellow-800";

                    // Format giờ
                    const dateObj = new Date(item.bookingTime);
                    const timeStr = `${dateObj.getDate()}/${dateObj.getMonth()+1} ${dateObj.getHours().toString().padStart(2,'0')}:${dateObj.getMinutes().toString().padStart(2,'0')}`;

                    const html = `
                    <tr class="${rowClass} transition border-b last:border-0">
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-500">#${item.appointmentId}</td>
                        <td class="px-6 py-4">
                            <div class="text-sm font-bold text-gray-900">${item.customerName}</div>
                            <div class="text-xs text-gray-500">${item.customerPhone}</div>
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-600 max-w-xs truncate" title="${item.serviceSummary}">
                            ${item.serviceSummary}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-blue-600 font-medium">
                            ${timeStr}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-right font-bold text-gray-700">
                            ${fmtMoney.format(item.totalAmount)}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-center">
                            <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full ${statusClass}">
                                ${item.status}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-center">
                            <button onclick="openDetailModal(${item.appointmentId})" class="text-blue-600 hover:text-blue-900 bg-blue-50 p-2 rounded-full hover:bg-blue-100 transition" title="Xem chi tiết">
                                <span class="material-symbols-outlined text-lg">visibility</span>
                            </button>
                        </td>
                    </tr>`;
                    tbody.insertAdjacentHTML('beforeend', html);
                });
            } else {
                empty.classList.remove('hidden');
            }
        } catch (e) {
            console.error(e);
            loading.classList.add('hidden');
            alert('Lỗi tải dữ liệu');
        }
    }

    // --- REUSE: HÀM MỞ MODAL CHI TIẾT (LẤY TỪ CALENDAR CONTROLLER) ---
    async function openDetailModal(apptId) {
        document.getElementById('detailModal').classList.remove('hidden');
        document.getElementById('detailCustomerName').innerText = "Đang tải...";
        document.getElementById('detailItemsBody').innerHTML = '';

        try {
            // LƯU Ý: Gọi sang CalendarController để lấy chi tiết
            const res = await fetch(`/Receptionist/Calendar/GetAppointmentDetails?id=${apptId}`);
            if (!res.ok) throw new Error('Không tìm thấy');
            const data = await res.json();

            // Fill Data
            document.getElementById('detailCustomerName').innerText = data.customerName;
            document.getElementById('detailCustomerPhone').innerText = data.customerPhone;
            document.getElementById('detailTimeRange').innerText = data.timeRange;
            document.getElementById('detailBookingDate').innerText = data.bookingDate;
            document.getElementById('detailCreatedDate').innerText = data.createdDate;
            document.getElementById('detailNotes').innerText = data.notes || 'Không có ghi chú.';
            document.getElementById('detailStatus').innerText = data.status;

            const fmtMoney = new Intl.NumberFormat('vi-VN', {style:'currency', currency:'VND'});
            document.getElementById('detailTotal').innerText = fmtMoney.format(data.totalAmount);

            // Render Items
            const tbody = document.getElementById('detailItemsBody');
            data.items.forEach(item => {
                let name = item.serviceName;
                if(item.comboId) name = `<span class="pl-4 border-l-2 ml-1 text-gray-500">${item.serviceName}</span>`;

                const row = `
                <tr class="border-b last:border-0">
                    <td class="p-2 font-medium">${item.guestName || 'Khách'}</td>
                    <td class="p-2">${name}</td>
                    <td class="p-2 text-sm text-blue-600">${item.techName}</td>
                    <td class="p-2 text-right font-bold">${item.comboId ? '--' : fmtMoney.format(item.price)}</td>
                </tr>`;
                tbody.insertAdjacentHTML('beforeend', row);
            });

        } catch (e) {
            alert('Lỗi: ' + e.message);
        }
    }
</script>