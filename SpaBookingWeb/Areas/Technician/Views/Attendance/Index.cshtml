@model SpaBookingWeb.Models.WorkSchedule
@{
    ViewData["Title"] = "Điểm danh";
    Layout = "~/Areas/Technician/Views/Shared/_Layout.cshtml";
}

<div class="flex flex-col items-center justify-center min-h-[60vh] space-y-8 p-4">

    <div class="text-center space-y-2">
        <h1 class="text-3xl font-bold text-gray-800 dark:text-white">Today's Attendance</h1>
        <p class="text-gray-500">@DateTime.Now.ToString("dddd, dd/MM/yyyy")</p>
    </div>

    @if (TempData["WarningMessage"] != null)
    {
        <div class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4 rounded shadow-sm max-w-md w-full" role="alert">
            <p class="font-bold">Notice</p>
            <p>@Html.Raw(TempData["WarningMessage"])</p>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative max-w-md w-full">
            @Html.Raw(TempData["ErrorMessage"])
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative max-w-md w-full">
            @Html.Raw(TempData["SuccessMessage"])
        </div>
    }

    <div class="bg-white dark:bg-card-dark p-8 rounded-2xl shadow-xl border border-gray-100 dark:border-gray-700 w-full max-w-sm text-center">
        @if (Model == null)
        {
            <div class="text-black-400 py-8">
                @* <span class="material-symbols-outlined text-6xl mb-2">calendar_off</span> *@
                <p>You have no work schedule today.</p>
            </div>
        }
        else
        {
            <div class="mb-6 space-y-1">
                <p class="text-sm text-gray-500">Current Shift</p>
                <p class="font-bold text-lg">Shift @Model.ShiftId</p>
            </div>

            <form method="post" action="/Technician/Attendance/ToggleAttendance">
                @Html.AntiForgeryToken()

                @if (Model.CheckInTime == null)
                {
                    <button type="submit" class="mx-auto w-48 h-48 rounded-full bg-gradient-to-br from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white shadow-lg hover:shadow-blue-500/50 transition-all transform hover:scale-105 flex flex-col items-center justify-center gap-2 group">
                        <span class="material-symbols-outlined text-5xl group-hover:animate-bounce">fingerprint</span>
                        <span class="text-xl font-bold">CLOCK IN</span>
                        <span class="text-xs opacity-80">Tap to check in</span>
                    </button>
                }
                else if (Model.CheckOutTime == null)
                {
                    <div class="mb-4 text-blue-600 bg-blue-50 px-4 py-2 rounded-lg inline-block">
                        Clocked in at: <strong>@Model.CheckInTime.Value.ToString("HH:mm")</strong>
                    </div>
                    <button type="submit" class="w-full py-4 bg-gray-800 hover:bg-gray-900 text-white rounded-xl font-bold shadow-md transition-all flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined">logout</span>
                        CLOCK OUT
                    </button>
                }
                else
                {
                    <div class="text-green-600 py-4">
                        <span class="material-symbols-outlined text-6xl mb-2">task_alt</span>
                        <p class="font-bold text-lg">Shift Completed</p>
                        <div class="text-sm text-gray-500 mt-2 space-y-1">
                            <p>Clock In: @Model.CheckInTime.Value.ToString("HH:mm")</p>
                            <p>Clock Out: @Model.CheckOutTime.Value.ToString("HH:mm")</p>
                        </div>
                    </div>
                }
            </form>
        }
    </div>
</div>
