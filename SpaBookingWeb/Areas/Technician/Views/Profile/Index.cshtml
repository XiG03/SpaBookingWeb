@model SpaBookingWeb.ViewModels.Technician.TechnicianProfileVM
@{
    ViewData["Title"] = "Hồ sơ của tôi";
    Layout = "~/Areas/Technician/Views/Shared/_Layout.cshtml";
}

<div class="max-w-4xl mx-auto p-4 space-y-6">

    <div class="bg-white dark:bg-card-dark rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 overflow-hidden relative">
        <div class="h-32 bg-gradient-to-r from-blue-600 to-purple-600"></div>

        <div class="px-6 pb-6">
            <div class="relative flex justify-between items-end -mt-12 mb-4">
                <img src="@Model.AvatarUrl" alt="Avatar" class="w-24 h-24 rounded-full border-4 border-white dark:border-gray-800 shadow-md object-cover bg-white">
            </div>

            <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">@Model.FullName</h1>
                <p class="text-gray-500 font-medium">Employee ID: <span class="text-blue-600">#@Model.EmployeeId</span></p>
                <div class="flex gap-2 mt-2">
                    @if (Model.IsActive)
                    {
                        <span class="px-2 py-1 bg-green-100 text-green-700 text-xs rounded-full font-bold">Active</span>
                    }
                    else
                    {
                        <span class="px-2 py-1 bg-red-100 text-red-700 text-xs rounded-full font-bold">Inactive</span>
                    }
                    <span class="px-2 py-1 bg-blue-50 text-blue-600 text-xs rounded-full font-bold">Seniority: @((DateTime.Now - Model.HireDate).Days / 365) years</span>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-card-dark p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-800">
            <div class="flex items-center gap-3 mb-2">
                <div class="p-2 bg-blue-100 text-blue-600 rounded-lg">
                    <span class="material-symbols-outlined">person_check</span>
                </div>
                <span class="text-sm text-gray-500 font-medium">Customers this month</span>
            </div>
            <p class="text-2xl font-bold text-gray-800 dark:text-white">@Model.ServedCustomers</p>
        </div>

        <div class="bg-white dark:bg-card-dark p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-800">
            <div class="flex items-center gap-3 mb-2">
                <div class="p-2 bg-yellow-100 text-yellow-600 rounded-lg">
                    <span class="material-symbols-outlined">savings</span>
                </div>
                <span class="text-sm text-gray-500 font-medium">Total Tip</span>
            </div>
            <p class="text-2xl font-bold text-yellow-600">@Model.TotalTip.ToString("N0") đ</p>
            @if (Model.TodayTip > 0)
            {
                <div class="mt-2 inline-flex items-center px-2 py-1 rounded-md bg-yellow-50 text-yellow-700 border border-yellow-200 text-xs font-bold animate-pulse">
                    <span class="material-symbols-outlined text-[14px] mr-1">trending_up</span>
                    Hôm nay: +@Model.TodayTip.ToString("N0") đ
                </div>
            }
            else
            {
                <div class="mt-2 text-xs text-gray-400">Today: 0 đ</div>
            }
        </div>

        <div class="bg-white dark:bg-card-dark p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-800">
            <div class="flex items-center gap-3 mb-2">
                <div class="p-2 bg-green-100 text-green-600 rounded-lg">
                    <span class="material-symbols-outlined">calendar_month</span>
                </div>
                <span class="text-sm text-gray-500 font-medium">Work Days</span>
            </div>
            <p class="text-2xl font-bold text-gray-800 dark:text-white">@Model.WorkDays <span class="text-sm font-normal text-gray-400">days</span></p>
        </div>

        <div class="bg-white dark:bg-card-dark p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-800">
            <div class="flex items-center gap-3 mb-2">
                <div class="p-2 bg-purple-100 text-purple-600 rounded-lg">
                    <span class="material-symbols-outlined">schedule</span>
                </div>
                <span class="text-sm text-gray-500 font-medium">Total Hours</span>
            </div>
            <p class="text-2xl font-bold text-gray-800 dark:text-white">@Model.TotalWorkHours <span class="text-sm font-normal text-gray-400">h</span></p>
        </div>
    </div>

    <div class="bg-white dark:bg-card-dark rounded-xl shadow-sm border border-gray-100 dark:border-gray-800 p-6">
        <h3 class="text-lg font-bold text-gray-800 dark:text-white mb-4 border-b pb-2 dark:border-gray-700">Details</h3>

        <div class="space-y-4">
            <div class="flex items-start justify-between">
                <span class="text-gray-500">Email</span>
                <span class="font-medium text-gray-900 dark:text-gray-200">@Model.Email</span>
            </div>

            <div class="flex items-start justify-between">
                <span class="text-gray-500">Phone Number</span>
                <span class="font-medium text-gray-900 dark:text-gray-200">@Model.PhoneNumber</span>
            </div>

            <div class="flex items-start justify-between">
                <span class="text-gray-500">Address</span>
                <span class="font-medium text-gray-900 dark:text-gray-200 text-right max-w-[60%]">@Model.Address</span>
            </div>

            <div class="flex items-start justify-between">
                <span class="text-gray-500">Contract Date</span>
                <span class="font-medium text-gray-900 dark:text-gray-200">@Model.HireDate.ToString("dd/MM/yyyy")</span>
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-dashed dark:border-gray-700">
                <span class="text-gray-500 font-medium">Base Salary</span>
                <div class="flex items-center gap-2">
                    <span id="salaryMask" class="font-bold text-lg text-gray-800 dark:text-white tracking-widest">******</span>

                    <span id="salaryValue" class="hidden font-bold text-lg text-green-600">@Model.BaseSalary.ToString("N0") đ</span>

                    <button onclick="toggleSalary()" class="text-gray-400 hover:text-blue-600 p-1">
                        <span id="eyeIcon" class="material-symbols-outlined text-xl">visibility</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleSalary() {
        const mask = document.getElementById('salaryMask');
        const value = document.getElementById('salaryValue');
        const icon = document.getElementById('eyeIcon');

        if (mask.classList.contains('hidden')) {
            // Đang hiện -> Ẩn đi
            mask.classList.remove('hidden');
            value.classList.add('hidden');
            icon.innerText = 'visibility';
        } else {
            // Đang ẩn -> Hiện ra
            mask.classList.add('hidden');
            value.classList.remove('hidden');
            icon.innerText = 'visibility_off';
        }
    }
</script>
