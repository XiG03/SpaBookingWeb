                            <label class="block text-xs font-bold text-yellow-800 dark:text-yellow-500 mb-2 uppercase tracking-wide flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm">payments</span> Tip Received (VND)
                            </label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <span class="text-yellow-600 font-bold text-lg">₫</span>
                                </div>
                                <input type="number" name="tipAmount" value="" placeholder="Nhập số tiền (VD: 50000)" step="1000" min="0"
                                       class="block w-full pl-8 pr-4 py-3 border-yellow-300 rounded-lg leading-5 bg-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500 text-lg font-bold text-gray-700 shadow-sm transition" />
                            </div>
                            <p class="text-[11px] text-yellow-700 mt-2 flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm">info</span> Enter extra amount received from customer (if any).
                            </p>
                        </div>

                        <button type="button" id="btnCheckout" onclick="confirmCheckout()" value="CheckOut"
                                class="w-full bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white font-bold py-4 px-6 rounded-xl flex items-center justify-center gap-3 transition-all shadow-lg hover:shadow-green-500/30 text-lg">
                            <span class="material-symbols-outlined text-2xl">check_circle</span>
                            FINISH (CHECK-OUT)
                        </button>
                    </div>
                }
            </form>
        </div>
    }
    else if (Model.Status == "Completed")
    {
        <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 rounded-xl p-6 text-center shadow-sm">
            <div class="bg-green-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-3 text-green-600">
                <span class="material-symbols-outlined text-4xl">task_alt</span>
            </div>
            <p class="text-green-800 dark:text-green-300 font-bold text-lg">Job Completed</p>
            <p class="text-green-600 text-sm">Job Completed</p>
        </div>
    }
</div>

<script>
    const JOB_ID = @Model.AppointmentDetailId;
    let allProducts = [];

    // --- [1] CẤU HÌNH THÔNG BÁO TỰ ĐỘNG ---
    document.addEventListener('DOMContentLoaded', () => {
        // Hiện thông báo từ Server (nếu có)
        @if (TempData["SuccessMessage"] != null)
        {
                <text>
                Swal.fire({
                        icon: 'success', title: 'Success', text: '@Html.Raw(TempData["SuccessMessage"])',
                    timer: 2000, showConfirmButton: false
                });
                </text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
                <text>
                Swal.fire({
                        icon: 'error', title: 'Error', text: '@Html.Raw(TempData["ErrorMessage"])'
                });
                </text>
        }

        // Load dữ liệu
        if ('@Model.Status' === 'InProgress' || '@Model.Status' === 'Completed') {
            loadProductList();
            loadConsumables();
        }

        // Khóa nút Check-out ban đầu
        const btnCheckout = document.getElementById('btnCheckout');
        if (btnCheckout) {
            btnCheckout.disabled = true;
            btnCheckout.classList.add('opacity-50', 'cursor-not-allowed');
            btnCheckout.title = "Please Save Consumables before checking out!";
        }
    });

    // --- [2] CÁC HÀM XỬ LÝ SỰ KIỆN NÚT BẤM (SweetAlert) ---

    // A. Xử lý Check-in (Không cần hỏi, bấm là chạy)
    function submitAction(type) {
        document.getElementById('actionTypeInput').value = type;
        document.getElementById('actionForm').submit();
    }

    // B. Xử lý Hủy (Cần xác nhận kỹ)
    function confirmCancel() {
        Swal.fire({
            title: 'Cancel Service?',
            text: "Customer not showing up or cancelled? This cannot be undone!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, Cancel now',
            cancelButtonText: 'No'
        }).then((result) => {
            if (result.isConfirmed) {
                submitAction('Cancel');
            }
        });
    }

    // C. Xử lý Hoàn thành (Check-out)
    function confirmCheckout() {
        // Kiểm tra xem đã lưu tiêu hao chưa (nếu cần logic chặn chặt hơn ở đây)
        Swal.fire({
            title: 'Complete Job?',
            text: "Confirm you have finished this service?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#16a34a', // Green
            cancelButtonColor: '#6b7280',
            confirmButtonText: '✅ Confirm',
            cancelButtonText: 'Not yet'
        }).then((result) => {
            if (result.isConfirmed) {
                submitAction('CheckOut');
            }
        });
    }

    // --- [3] LOGIC VẬT TƯ TIÊU HAO (Giữ nguyên logic, chỉ sửa UI Alert) ---

    async function loadProductList() {
        const res = await fetch('/Technician/Job/GetProductList');
        allProducts = await res.json();
    }

    async function loadConsumables() {
        const res = await fetch(`/Technician/Job/GetConsumables?id=${JOB_ID}`);
        const data = await res.json();
        const tbody = document.getElementById('tableBody');
        tbody.innerHTML = '';
        if (data.length === 0) {
            if('@Model.Status' === 'InProgress') addNewRow();
        } else {
            data.forEach(item => renderRow(item));
            unlockCheckout();
        }
    }

    function renderRow(item = null) {
        document.getElementById('emptyState').classList.add('hidden');
        const tbody = document.getElementById('tableBody');
        const isEdit = '@Model.Status' === 'InProgress';
        const row = document.createElement('tr');
        row.className = "hover:bg-gray-50 dark:hover:bg-white/5 transition group";

        let productSelectHtml = `<select class="w-full bg-transparent border-none text-sm font-medium focus:ring-0 p-2 product-select rounded cursor-pointer" ${!isEdit ? 'disabled' : ''}>`;
        if(!item) productSelectHtml += `<option value="">-- Select Item --</option>`;
        allProducts.forEach(p => {
            const selected = (item && item.productId === p.id) ? 'selected' : '';
            productSelectHtml += `<option value="${p.id}" ${selected}>${p.name} (${p.unit})</option>`;
        });
        productSelectHtml += `</select>`;

        const stdQty = item ? item.standardQuantity : 0;
        const actQty = item ? item.actualQuantity : 1;
        const reason = item ? item.reason : '';

        row.innerHTML = `
            <td class="px-2 py-2">${productSelectHtml}</td>
            <td class="px-2 py-2 text-center text-gray-500 font-mono">${stdQty}</td>
            <td class="px-2 py-2 text-center">
                <input type="number" class="w-16 text-center bg-white border border-gray-300 rounded-md p-1.5 text-sm font-bold text-blue-600 focus:ring-2 focus:ring-blue-500 outline-none actual-qty" value="${actQty}" min="0" ${!isEdit ? 'disabled' : ''}>
            </td>
            <td class="px-2 py-2">
                <input type="text" class="w-full bg-transparent border-b border-gray-200 focus:border-blue-500 focus:outline-none text-sm py-1 reason transition-colors" placeholder="Reason..." value="${reason}" ${!isEdit ? 'disabled' : ''}>
            </td>
            <td class="px-2 py-2 text-center">
                ${isEdit ? `<button onclick="this.closest('tr').remove()" class="text-gray-400 hover:text-red-500 transition p-1 rounded-full hover:bg-red-50"><span class="material-symbols-outlined text-lg">delete</span></button>` : ''}
            </td>
        `;
        tbody.appendChild(row);
    }

    function addNewRow() {
        renderRow();
    }

    async function saveConsumables() {
        const rows = document.querySelectorAll('#tableBody tr');
        const data = [];
        rows.forEach(row => {
            const productId = row.querySelector('.product-select').value;
            const actualQty = row.querySelector('.actual-qty').value;
            const reason = row.querySelector('.reason').value;
            const stdQty = row.children[1].innerText;
            if (productId) {
                data.push({
                    productId: parseInt(productId),
                    actualQuantity: parseInt(actualQty),
                    standardQuantity: parseInt(stdQty),
                    reason: reason
                });
            }
        });

        const btnSave = document.getElementById('btnSaveConsumables');
        const oldText = btnSave.innerHTML;
        btnSave.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">sync</span> Saving...';
        btnSave.disabled = true;

        try {
            const res = await fetch(`/Technician/Job/SaveConsumables?id=${JOB_ID}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify(data)
            });
            const result = await res.json();

            if (result.success) {
                // [SWEETALERT] Thay alert thường
                Swal.fire({
                    icon: 'success',
                    title: 'Saved!',
                    text: 'Consumables data has been updated.',
                    timer: 1500,
                    showConfirmButton: false
                });
                unlockCheckout();
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: result.message });
            }
        } catch (err) {
            Swal.fire({ icon: 'error', title: 'Connection Error', text: 'Cannot connect to server.' });
        } finally {
            btnSave.innerHTML = oldText;
            btnSave.disabled = false;
        }
    }

    function unlockCheckout() {
        const btnCheckout = document.getElementById('btnCheckout');
        if (btnCheckout) {
            btnCheckout.disabled = false;
            btnCheckout.classList.remove('opacity-50', 'cursor-not-allowed');
            btnCheckout.classList.add('animate-pulse-slow');
            btnCheckout.title = "";
        }
    }
</script>
