<script>
    const JOB_ID = @Model.AppointmentDetailId;
    let allProducts = []; // Chứa danh sách sản phẩm để chọn

    // 1. Khi trang load -> Gọi API lấy dữ liệu
    document.addEventListener('DOMContentLoaded', () => {

        if ('@Model.Status' === 'InProgress' || '@Model.Status' === 'Completed') {
            loadProductList();
            loadConsumables();
        }

        // Mặc định disable nút Check-out nếu đang làm
        const btnCheckout = document.querySelector('button[value="CheckOut"]');
        if (btnCheckout) {
            btnCheckout.disabled = true;
            btnCheckout.classList.add('opacity-50', 'cursor-not-allowed');
            btnCheckout.title = "Vui lòng Lưu tiêu hao trước khi hoàn thành!";
        }
    });

    // 2. Tải danh sách sản phẩm (Dropdown)
    async function loadProductList() {
        const res = await fetch('/Technician/Job/GetProductList');
        allProducts = await res.json();
    }

    // 3. Tải dữ liệu bảng
    async function loadConsumables() {
        const res = await fetch(`/Technician/Job/GetConsumables?id=${JOB_ID}`);
        const data = await res.json();

        const tbody = document.getElementById('tableBody');
        tbody.innerHTML = '';

        if (data.length === 0) {
            // document.getElementById('emptyState').classList.remove('hidden');
            // Tự động thêm 1 dòng trống nếu không có gì
            if('@Model.Status' === 'InProgress') addNewRow();
        } else {
            data.forEach(item => renderRow(item));

            // Nếu đã có dữ liệu load lên -> Cho phép Check-out luôn
            unlockCheckout();
        }
    }

    // 4. Vẽ 1 dòng vào bảng
    function renderRow(item = null) {
        document.getElementById('emptyState').classList.add('hidden');
        const tbody = document.getElementById('tableBody');
        const isEdit = '@Model.Status' === 'InProgress';

        const row = document.createElement('tr');
        row.className = "border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-white/5 transition";

        // Dropdown Sản phẩm
        let productSelectHtml = `<select class="w-full bg-transparent border-none text-sm font-medium focus:ring-0 p-0 product-select" ${!isEdit ? 'disabled' : ''}>`;
        if(!item) productSelectHtml += `<option value="">-- Chọn vật tư --</option>`;

        allProducts.forEach(p => {
            const selected = (item && item.productId === p.id) ? 'selected' : '';
            productSelectHtml += `<option value="${p.id}" ${selected}>${p.name} (${p.unit})</option>`;
        });
        productSelectHtml += `</select>`;

        // Input số lượng & Lý do
        const stdQty = item ? item.standardQuantity : 0;
        const actQty = item ? item.actualQuantity : 1;
        const reason = item ? item.reason : '';

        row.innerHTML = `
            <td class="px-3 py-2">${productSelectHtml}</td>
            <td class="px-3 py-2 text-center text-gray-500">${stdQty}</td>
            <td class="px-3 py-2">
                <input type="number" class="w-20 text-center bg-gray-50 border border-gray-300 rounded p-1 text-sm actual-qty" value="${actQty}" min="0" ${!isEdit ? 'disabled' : ''}>
            </td>
            <td class="px-3 py-2">
                <input type="text" class="w-full bg-transparent border-b border-gray-200 focus:border-primary focus:outline-none text-sm reason" placeholder="Nhập lý do..." value="${reason}" ${!isEdit ? 'disabled' : ''}>
            </td>
            <td class="px-3 py-2 text-center">
                ${isEdit ? `<button onclick="this.closest('tr').remove()" class="text-red-500 hover:text-red-700"><span class="material-symbols-outlined text-lg">delete</span></button>` : ''}
            </td>
        `;
        tbody.appendChild(row);
    }

    // 5. Thêm dòng mới
    function addNewRow() {
        renderRow();
    }

    // 6. Lưu dữ liệu
    async function saveConsumables() {
        const rows = document.querySelectorAll('#tableBody tr');
        const data = [];

        rows.forEach(row => {
            const productId = row.querySelector('.product-select').value;
            const actualQty = row.querySelector('.actual-qty').value;
            const reason = row.querySelector('.reason').value;

            // Lấy định mức (text)
            const stdQty = row.children[1].innerText;

            if (productId) {
                data.push({
                    productId: parseInt(productId),
                    actualQuantity: parseInt(actualQty),
                    standardQuantity: parseInt(stdQty),
                    reason: reason
                });
            }
        });

        // Gửi lên Server
        const btnSave = document.getElementById('btnSaveConsumables');
        btnSave.innerText = "Đang lưu...";
        btnSave.disabled = true;

        try {
            const res = await fetch(`/Technician/Job/SaveConsumables?id=${JOB_ID}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    // Quan trọng: Thêm Token chống CSRF nếu project bật bảo mật kỹ
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify(data)
            });

            const result = await res.json();
            if (result.success) {
                alert('Đã lưu tiêu hao thành công!');
                unlockCheckout(); // Mở khóa nút Check-out
            } else {
                alert('Lỗi: ' + result.message);
            }
        } catch (err) {
            alert('Lỗi kết nối server!');
        } finally {
            btnSave.innerHTML = '<span class="material-symbols-outlined text-sm">save</span> Lưu tiêu hao';
            btnSave.disabled = false;
        }
    }

    function unlockCheckout() {
        const btnCheckout = document.querySelector('button[value="CheckOut"]');
        if (btnCheckout) {
            btnCheckout.disabled = false;
            btnCheckout.classList.remove('opacity-50', 'cursor-not-allowed');
            btnCheckout.classList.add('animate-pulse-slow'); // Thêm hiệu ứng nhắc nhở
            btnCheckout.title = "";
        }
    }
</script> *@



