@{
    ViewData["Title"] = "Lịch làm việc";
    Layout = "~/Areas/Technician/Views/Shared/_Layout.cshtml";
}

<div class="flex flex-1 flex-col h-full overflow-hidden">
    <header class="flex flex-wrap items-center justify-between gap-4 border-b border-gray-200/80 bg-white p-6 dark:border-gray-700/50 dark:bg-background-dark flex-shrink-0">
        <p class="text-3xl font-bold tracking-tight">Appointment Overview</p>
    </header>

    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-gray-200/80 bg-white p-4 dark:border-gray-700/50 dark:bg-background-dark flex-shrink-0">
        <div class="flex items-center gap-4">
            <div class="flex items-center gap-1">
                <button id="btn-today" class="flex h-10 items-center justify-center rounded-lg border border-gray-300 dark:border-gray-700 px-3 text-sm font-medium hover:bg-gray-50 dark:hover:bg-white/10">Hôm nay</button>
                <div class="flex items-center rounded-lg border border-gray-300 dark:border-gray-700">
                    <button id="btn-prev" class="p-2 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-white/10 rounded-l-md"><span class="material-symbols-outlined">chevron_left</span></button>
                    <button id="btn-next" class="p-2 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-white/10 rounded-r-md border-l dark:border-gray-700"><span class="material-symbols-outlined">chevron_right</span></button>
                </div>
            </div>
            <p id="current-date-label" class="text-lg font-semibold capitalize">...</p>
        </div>

        <div class="flex items-center gap-2">
            <div class="flex h-10 items-center justify-center rounded-lg bg-gray-100 p-1 dark:bg-white/10">
                <label class="flex h-full cursor-pointer grow items-center justify-center px-3 has-[:checked]:bg-white has-[:checked]:shadow-sm rounded-md text-sm font-medium transition-all text-gray-500 has-[:checked]:text-black dark:has-[:checked]:bg-gray-700 dark:has-[:checked]:text-white">
                    <span>Ngày</span><input class="invisible w-0 view-radio" name="view-switcher" type="radio" value="day" />
                </label>
                <label class="flex h-full cursor-pointer grow items-center justify-center px-3 has-[:checked]:bg-white has-[:checked]:shadow-sm rounded-md text-sm font-medium transition-all text-gray-500 has-[:checked]:text-black dark:has-[:checked]:bg-gray-700 dark:has-[:checked]:text-white">
                    <span>Tuần</span><input class="invisible w-0 view-radio" name="view-switcher" type="radio" value="week" />
                </label>
                <label class="flex h-full cursor-pointer grow items-center justify-center px-3 has-[:checked]:bg-white has-[:checked]:shadow-sm rounded-md text-sm font-medium transition-all text-gray-500 has-[:checked]:text-black dark:has-[:checked]:bg-gray-700 dark:has-[:checked]:text-white">
                    <span>Tháng</span><input checked class="invisible w-0 view-radio" name="view-switcher" type="radio" value="month" />
                </label>
            </div>
        </div>
    </div>

    @* <div class="flex-1 overflow-auto bg-background-light dark:bg-background-dark p-6">
        <div id="calendar-header" class="grid grid-cols-7 gap-px mb-px bg-transparent">
        </div>

        <div id="calendar-grid" class="grid gap-px bg-gray-200 dark:bg-gray-700 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden min-h-[600px]">
        </div>
    </div> *@
    <div class="flex-1 overflow-hidden bg-background-light dark:bg-background-dark p-4">
        <div class="relative flex h-[calc(100vh-220px)] flex-col rounded-lg border border-gray-200 shadow-sm dark:border-gray-700 bg-white dark:bg-gray-800 overflow-y-auto custom-scrollbar">

            <div class="flex min-w-[800px] flex-1 flex-col">

                <div id="calendar-header" class="sticky top-0 z-20 grid grid-cols-7 border-b border-gray-200 bg-gray-50 shadow-sm dark:border-gray-700 dark:bg-gray-800">
                </div>

                <div id="calendar-grid" class="flex-1 grid gap-px bg-gray-200 dark:bg-gray-700">
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* <script>
        // --- 1. CONFIG & STATE ---
        const state = {
            currentDate: new Date(),
            view: 'month' // 'month', 'week', 'day'
        };

        // Dữ liệu mẫu (Mô phỏng Database)
        const appointments = [
            { id: 1, title: "Nguyễn Thị An", service: "Chăm sóc da mặt", start: "2025-10-03T09:00:00", colorClass: "bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-200", subColor: "text-green-700 dark:text-green-300" },
            { id: 2, title: "Trần Văn Bình", service: "Massage toàn thân", start: "2025-10-05T10:00:00", colorClass: "bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-200", subColor: "text-blue-700 dark:text-blue-300" },
            { id: 3, title: "Lê Thị Hoa", service: "Triệt lông", start: "2025-10-05T14:00:00", colorClass: "bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-200", subColor: "text-green-700 dark:text-green-300" },
            { id: 4, title: "Phạm Minh Tuấn", service: "Chăm sóc da sâu", start: "2025-10-09T11:00:00", colorClass: "bg-orange-100 text-orange-800 dark:bg-orange-900/50 dark:text-orange-200", subColor: "text-orange-700 dark:text-orange-300" },
            { id: 5, title: "Đặng Thuỳ Trang", service: "Massage đá nóng", start: "2025-10-12T15:00:00", colorClass: "bg-red-100 text-red-800 dark:bg-red-900/50 dark:text-red-200", subColor: "text-red-700 dark:text-red-300" },
            // Thêm dữ liệu mẫu cho ngày hiện tại để test
            { id: 6, title: "Test Hôm Nay", service: "Gội đầu", start: new Date().toISOString(), colorClass: "bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-200", subColor: "text-blue-700 dark:text-blue-300" }
        ];

        // CSS Classes giữ nguyên thiết kế
        const CSS = {
            gridMonth: "grid-cols-7 grid-rows-5", // Cấu trúc lưới tháng
            gridWeek: "grid-cols-7 grid-rows-1 h-full", // Cấu trúc lưới tuần
            gridDay: "grid-cols-1 grid-rows-1 h-full",  // Cấu trúc lưới ngày
            headerCell: "text-center py-2 text-sm font-semibold text-gray-600 dark:text-gray-300 bg-white dark:bg-background-dark",
            dayCell: "relative bg-white p-2 dark:bg-background-dark group hover:bg-gray-50 dark:hover:bg-white/5 transition min-h-[120px]",
            dayCellInactive: "relative bg-gray-50 p-2 dark:bg-gray-900/50 min-h-[120px]",
            dateNumber: "text-sm text-gray-600 dark:text-gray-300",
            dateNumberToday: "text-sm font-bold text-white bg-primary w-6 h-6 rounded-full flex items-center justify-center shadow-md"
        };

        // --- 2. HELPER FUNCTIONS ---

        // Lấy ngày đầu tuần
        function getStartOfWeek(date) {
            const d = new Date(date);
            const day = d.getDay();
            const diff = d.getDate() - day; // Chủ nhật là 0
            return new Date(d.setDate(diff));
        }

        // Format ngày thành chuỗi so sánh (YYYY-MM-DD)
        function formatDateKey(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        // Lọc appointment theo ngày
        function getEventsForDate(date) {
            const key = formatDateKey(date);
            return appointments.filter(app => app.start.startsWith(key));
        }

        // --- 3. RENDER LOGIC ---

        function renderCalendar() {
            const grid = document.getElementById('calendar-grid');
            const header = document.getElementById('calendar-header');
            const label = document.getElementById('current-date-label');

            grid.innerHTML = '';
            header.innerHTML = '';

            // Update Label
            const options = { year: 'numeric', month: 'long' };
            if (state.view === 'day') options.day = 'numeric';
            label.innerText = state.currentDate.toLocaleDateString('vi-VN', options);

            // Render Header (T2...CN)
            const days = ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'];
            if (state.view !== 'day') {
                days.forEach(d => {
                    header.innerHTML += `<div class="${CSS.headerCell}">${d}</div>`;
                });
            }

            // Render Body
            if (state.view === 'month') renderMonthView(grid);
            else if (state.view === 'week') renderWeekView(grid);
            else renderDayView(grid);
        }

        function renderCell(date, isCurrentMonth = true) {
            const isToday = formatDateKey(date) === formatDateKey(new Date());
            const events = getEventsForDate(date);

            // Build Events HTML
            let eventsHtml = '';
            if (events.length > 0) {
                eventsHtml = `<div class="mt-2 space-y-1">` +
                    events.map(e => `
                        <a href="#" class="block cursor-pointer rounded-md p-1 hover:opacity-80 ${e.colorClass}">
                            <p class="text-xs font-semibold">${new Date(e.start).getHours()}:00 - ${e.title}</p>
                            <p class="text-xs truncate ${e.subColor}">${e.service}</p>
                        </a>
                    `).join('') +
                `</div>`;
            }

            const dateClass = isToday ? CSS.dateNumberToday : CSS.dateNumber;
            const cellClass = isCurrentMonth ? CSS.dayCell : CSS.dayCellInactive;

            return `
                <div class="${cellClass}">
                    <span class="${dateClass}">${date.getDate()}</span>
                    ${eventsHtml}
                </div>
            `;
        }

        function renderMonthView(grid) {
            grid.className = `grid gap-px bg-gray-200 dark:bg-gray-700 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden ${CSS.gridMonth}`;

            const year = state.currentDate.getFullYear();
            const month = state.currentDate.getMonth();

            const firstDayOfMonth = new Date(year, month, 1).getDay(); // 0-6
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const daysInPrevMonth = new Date(year, month, 0).getDate();

            // Previous Month Padding
            for (let i = firstDayOfMonth; i > 0; i--) {
                const d = new Date(year, month - 1, daysInPrevMonth - i + 1);
                grid.innerHTML += renderCell(d, false);
            }

            // Current Month
            for (let i = 1; i <= daysInMonth; i++) {
                const d = new Date(year, month, i);
                grid.innerHTML += renderCell(d, true);
            }

            // Next Month Padding (to fill 35 or 42 cells)
            const totalCells = grid.children.length;
            const remaining = (totalCells <= 35 ? 35 : 42) - totalCells;
            for (let i = 1; i <= remaining; i++) {
                 const d = new Date(year, month + 1, i);
                 grid.innerHTML += renderCell(d, false);
            }
        }

        function renderWeekView(grid) {
            grid.className = `grid gap-px bg-gray-200 dark:bg-gray-700 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden ${CSS.gridWeek}`;

            const start = getStartOfWeek(state.currentDate);
            for (let i = 0; i < 7; i++) {
                const d = new Date(start);
                d.setDate(start.getDate() + i);
                grid.innerHTML += renderCell(d, true);
            }
        }

        function renderDayView(grid) {
            grid.className = `grid gap-px bg-gray-200 dark:bg-gray-700 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden ${CSS.gridDay}`;
            grid.innerHTML = renderCell(state.currentDate, true);
        }

        // --- 4. EVENT HANDLERS ---

        document.getElementById('btn-prev').addEventListener('click', () => {
            if (state.view === 'month') state.currentDate.setMonth(state.currentDate.getMonth() - 1);
            else if (state.view === 'week') state.currentDate.setDate(state.currentDate.getDate() - 7);
            else state.currentDate.setDate(state.currentDate.getDate() - 1);
            renderCalendar();
        });

        document.getElementById('btn-next').addEventListener('click', () => {
            if (state.view === 'month') state.currentDate.setMonth(state.currentDate.getMonth() + 1);
            else if (state.view === 'week') state.currentDate.setDate(state.currentDate.getDate() + 7);
            else state.currentDate.setDate(state.currentDate.getDate() + 1);
            renderCalendar();
        });

        document.getElementById('btn-today').addEventListener('click', () => {
            state.currentDate = new Date();
            renderCalendar();
        });

        document.querySelectorAll('.view-radio').forEach(radio => {
            radio.addEventListener('change', (e) => {
                state.view = e.target.value;
                renderCalendar();
            });
        });

        // --- 5. INIT ---
        renderCalendar();

    </script> *@
    <script>
        // 1. Nhận dữ liệu từ Controller (Dòng quan trọng nhất)
        const appointments = @Html.Raw(ViewBag.EventsJson ?? "[]");
        console.log("Dữ liệu lịch:", appointments);

        const state = { currentDate: new Date(), view: 'month' };
        const CSS = {
            gridMonth: "grid-cols-7 grid-rows-5",
            gridWeek: "grid-cols-7 grid-rows-1 h-full",
            gridDay: "grid-cols-1 grid-rows-1 h-full",
            // headerCell: "text-center py-2 text-sm font-semibold text-gray-600 dark:text-gray-300 bg-white dark:bg-background-dark",
            headerCell: "text-center py-3 text-sm font-bold text-gray-700 dark:text-gray-200 bg-gray-100 dark:bg-gray-800",
            dayCell: "relative bg-white p-2 dark:bg-background-dark group hover:bg-gray-50 dark:hover:bg-white/5 transition min-h-[120px]",
            dayCellInactive: "relative bg-gray-50 p-2 dark:bg-gray-900/50 min-h-[120px]",
            dateNumber: "text-sm text-gray-600 dark:text-gray-300",
            dateNumberToday: "text-sm font-bold text-white bg-primary w-6 h-6 rounded-full flex items-center justify-center shadow-md"
        };

        function getStartOfWeek(date) {
            const d = new Date(date);
            const day = d.getDay();
            const diff = d.getDate() - day;
            return new Date(d.setDate(diff));
        }

        // Fix lỗi lệch ngày (Dùng chuỗi YYYY-MM-DD địa phương)
        function formatDateKey(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function getEventsForDate(date) {
            const key = formatDateKey(date);
            return appointments.filter(app => app.Start && app.Start.startsWith(key));
        }

        function renderCalendar() {
            const grid = document.getElementById('calendar-grid');
            const header = document.getElementById('calendar-header');
            const label = document.getElementById('current-date-label');

            grid.innerHTML = ''; header.innerHTML = '';
            const options = { year: 'numeric', month: 'long' };
            if (state.view === 'day') options.day = 'numeric';
            label.innerText = state.currentDate.toLocaleDateString('vi-VN', options);

            const days = ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'];
            if (state.view !== 'day') {
                days.forEach(d => { header.innerHTML += `<div class="${CSS.headerCell}">${d}</div>`; });
            }

            if (state.view === 'month') renderMonthView(grid);
            else if (state.view === 'week') renderWeekView(grid);
            else renderDayView(grid);
        }

        function renderCell(date, isCurrentMonth = true) {
            const isToday = formatDateKey(date) === formatDateKey(new Date());
            const events = getEventsForDate(date);

            let eventsHtml = '';
            if (events.length > 0) {
                eventsHtml = `<div class="mt-2 space-y-1">` +
                    events.map(e => {
                        const timeString = e.Start.split('T')[1].substring(0, 5);
                        return `
                        <a href="/Technician/Job/Detail/${e.Id}" class="block cursor-pointer rounded-md p-1 hover:opacity-80 ${e.ColorClass}">
                            <p class="text-xs font-semibold">${timeString} - ${e.Title}</p>
                            <p class="text-xs truncate ${e.SubColor}">${e.ServiceName}</p>
                        </a>
                    `}).join('') +
                `</div>`;
            }
            return `<div class="${isCurrentMonth ? CSS.dayCell : CSS.dayCellInactive}">
                    <span class="${isToday ? CSS.dateNumberToday : CSS.dateNumber}">${date.getDate()}</span>
                    ${eventsHtml}</div>`;
        }

        function renderMonthView(grid) {
            // grid.className = `grid gap-px bg-gray-200 dark:bg-gray-700 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden ${CSS.gridMonth}`;
            grid.className = `grid gap-px bg-gray-200 dark:bg-gray-700 ${CSS.gridMonth}`;
            const year = state.currentDate.getFullYear();
            const month = state.currentDate.getMonth();
            const firstDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const prevMonthDays = new Date(year, month, 0).getDate();

            for (let i = firstDay; i > 0; i--) grid.innerHTML += renderCell(new Date(year, month - 1, prevMonthDays - i + 1), false);
            for (let i = 1; i <= daysInMonth; i++) grid.innerHTML += renderCell(new Date(year, month, i), true);

            const remaining = (grid.children.length <= 35 ? 35 : 42) - grid.children.length;
            for (let i = 1; i <= remaining; i++) grid.innerHTML += renderCell(new Date(year, month + 1, i), false);
        }

        function renderWeekView(grid) {
            grid.className = `grid gap-px bg-gray-200 dark:bg-gray-700 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden ${CSS.gridWeek}`;
            const start = getStartOfWeek(state.currentDate);
            for (let i = 0; i < 7; i++) {
                const d = new Date(start); d.setDate(start.getDate() + i);
                grid.innerHTML += renderCell(d, true);
            }
        }

        function renderDayView(grid) {
            grid.className = `grid gap-px bg-gray-200 dark:bg-gray-700 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden ${CSS.gridDay}`;
            grid.innerHTML = renderCell(state.currentDate, true);
        }

        document.getElementById('btn-prev').addEventListener('click', () => {
            if (state.view === 'month') state.currentDate.setMonth(state.currentDate.getMonth() - 1);
            else if (state.view === 'week') state.currentDate.setDate(state.currentDate.getDate() - 7);
            else state.currentDate.setDate(state.currentDate.getDate() - 1);
            renderCalendar();
        });
        document.getElementById('btn-next').addEventListener('click', () => {
            if (state.view === 'month') state.currentDate.setMonth(state.currentDate.getMonth() + 1);
            else if (state.view === 'week') state.currentDate.setDate(state.currentDate.getDate() + 7);
            else state.currentDate.setDate(state.currentDate.getDate() + 1);
            renderCalendar();
        });
        document.getElementById('btn-today').addEventListener('click', () => { state.currentDate = new Date(); renderCalendar(); });
        document.querySelectorAll('.view-radio').forEach(r => r.addEventListener('change', (e) => { state.view = e.target.value; renderCalendar(); }));

        renderCalendar();
    </script>
}