@{
    ViewData["Title"] = "Import Products from Excel";
    Layout = "~/Areas/Manager/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8">
            <h2 class="h3 mb-4 page-title">Import Products from Excel</h2>
            
            <div class="card shadow mb-4">
                <div class="card-header">
                    <strong class="card-title">Upload File</strong>
                </div>
                <div class="card-body">
                    
                    <!-- Show Errors if any -->
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Form Upload -->
                    <form asp-action="Import" method="post" enctype="multipart/form-data">
                        
                        <div class="form-group">
                            <label>Select Excel File (.xlsx)</label>
                            <div class="custom-file">
                                <input type="file" name="file" class="custom-file-input" id="customFile" accept=".xlsx" required>
                                <label class="custom-file-label" for="customFile">Choose file...</label>
                            </div>
                            <small class="form-text text-muted mt-2">
                                Note: The Excel file must follow the standard format. 
                                <a asp-action="DownloadTemplate" class="btn btn-sm btn-outline-primary"> <i class="fas fa-download"></i>
                                Download template here</a>
                            </small>
                        </div>

                        <div class="alert alert-info mt-3" role="alert">
                            <strong>Required Column Structure:</strong>
                            <ul class="mb-0 pl-3">
                                <li>Column A: Product Name</li>
                                <li>Column B: Category ID</li>
                                <li>Column C: Unit</li>
                                <li>Column D: Purchase Price</li>
                                <li>Column E: Sale Price</li>
                                <li>Column F: Stock Quantity</li>
                            </ul>
                        </div>

                        <div class="mt-4 d-flex justify-content-end">
                            <a asp-controller="Products" asp-action="Index" class="btn btn-secondary mr-2">Back</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-upload mr-1"></i> Upload and Process
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Helper script to show file name on selection
        $(".custom-file-input").on("change", function() {
            var fileName = $(this).val().split("\\").pop();
            $(this).siblings(".custom-file-label").addClass("selected").html(fileName);
        });
    </script>
}