@model SpaBookingWeb.ViewModels.Manager.RevenueReportViewModel

@{
    ViewData["Title"] = "Revenue Report";
    Layout = "~/Areas/Manager/Views/Shared/_Layout.cshtml";
}

    <!-- Tiêu đề và nút Xuất Excel -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Revenue Report for Month @(Model.FilterFromDate.HasValue ? Model.FilterFromDate.Value.Month : DateTime.Now.Month)</h1>
        <a href="@Url.Action("ExportRevenueReport", new { fromDate = Model.FilterFromDate, toDate = Model.FilterToDate })" class="d-none d-sm-inline-block btn btn-sm btn-success shadow-sm">
            <i class="fas fa-file-excel fa-sm text-white-50 mr-1"></i> Export Excel Report (Full)
        </a>
    </div>

    <!-- Filter & Chart Section -->
    <div class="row">
        <div class="col-xl-12 col-lg-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Revenue Overview Chart</h6>
                    <form asp-action="Index" method="get" class="form-inline" id="filterForm">
                        <select name="filterType" class="form-control form-control-sm mr-2" onchange="this.form.submit()">
                            @if(Model.FilterType == "Date"){<option value="Date" selected>By Date/Shift</option>}else{<option value="Date">By Date/Shift</option>}
                            @if(Model.FilterType == "Service"){<option value="Service" selected>By Service</option>}else{<option value="Service">By Service</option>}
                            @if(Model.FilterType == "Employee"){<option value="Employee" selected>By Employee</option>}else{<option value="Employee">By Employee</option>}
                            @if(Model.FilterType == "Customer"){<option value="Customer" selected>By Customer</option>}else{<option value="Customer">By Customer</option>}
                        </select>
                        <input type="date" id="fromDate" name="fromDate" value="@(Model.FilterFromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm mr-2" onchange="this.form.submit()" />
                        <span class="mr-2">-</span>
                        <input type="date" id="toDate" name="toDate" value="@(Model.FilterToDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm mr-2" onchange="this.form.submit()" />
                        
                        <div class="btn-group mr-2" role="group">
                            <button type="button" class="btn btn-sm btn-secondary" onclick="setFilter('today')">Today</button>
                            <button type="button" class="btn btn-sm btn-secondary" onclick="setFilter('week')">This Week</button>
                            <button type="button" class="btn btn-sm btn-secondary" onclick="setFilter('month')">This Month</button>
                        </div>
                    </form>
                </div>
                <div class="card-body">
                    <div class="chart-area" style="height: 400px;">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hàng thống kê tổng quan -->
    <div class="row">

        <!-- Doanh Thu Tháng Này -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Revenue This Month</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.CurrentRevenue.ToString("#,##0") VNĐ</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                        </div>
                    </div>
                    <!-- So sánh -->
                    <div class="mt-2 text-xs">
                        @if (Model.RevenueGrowth >= 0)
                        {
                            <span class="text-success mr-2"><i class="fas fa-arrow-up"></i> @Model.RevenueGrowth.ToString("0.0")%</span>
                        }
                        else
                        {
                            <span class="text-danger mr-2"><i class="fas fa-arrow-down"></i> @Model.RevenueGrowth.ToString("0.0")%</span>
                        }
                        <span>Compared to last month</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Số Đơn Hàng -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total Orders</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.CurrentOrders</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-shopping-cart fa-2x text-gray-300"></i>
                        </div>
                    </div>
                     <div class="mt-2 text-xs">
                         <span class="@(Model.OrderGrowth >= 0 ? "text-success" : "text-danger") mr-2">
                             @(Model.OrderGrowth >= 0 ? "+" : "")@Model.OrderGrowth.ToString("0.0")%
                         </span>
                         <span>So với tháng trước (@Model.LastMonthOrders đơn)</span>
                     </div>
                </div>
            </div>
        </div>

        <!-- Giá Trị Trung Bình Đơn (AOV) -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Avg Order Value</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.AverageOrderValue.ToString("#,##0") VNĐ</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clipboard-list fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sản Phẩm Bán Ra -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Products Sold</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.ProductsSold</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-box-open fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Sản Phẩm (Ví dụ thêm) -->
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Top Selling Products</h6>
                </div>
                <div class="card-body">
                    @foreach (var item in Model.TopProducts)
                    {
                        <div class="mb-3">
                            <h4 class="small font-weight-bold">@item.ProductName <span class="float-right">@item.Quantity sold</span></h4>
                            <div class="progress mb-4">
                                <!-- Thanh progress bar giả lập % -->
                                <div class="progress-bar bg-info" role="progressbar" style="width: @(item.Quantity)%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    </div>

    <!-- Báo Cáo Voucher -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Voucher Performance Report</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Voucher Code</th>
                                    <th>Program Name</th>
                                    <th class="text-center">Usage Count</th>
                                    <th class="text-right">Original Revenue</th>
                                    <th class="text-right">Discount</th>
                                    <th class="text-right">Net Revenue</th>
                                    <th class="text-right">Actual % Discount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.VoucherStats.Any())
                                {
                                    @foreach (var v in Model.VoucherStats)
                                    {
                                        <tr>
                                            <td class="font-weight-bold text-primary">@v.VoucherCode</td>
                                            <td>@v.VoucherName</td>
                                            <td class="text-center">@v.UsageCount</td>
                                            <td class="text-right">@v.TotalOriginalAmount.ToString("#,##0")</td>
                                            <td class="text-right text-danger">-@v.TotalDiscountAmount.ToString("#,##0")</td>
                                            <td class="text-right font-weight-bold text-success">@v.TotalFinalAmount.ToString("#,##0")</td>
                                            <td class="text-right">
                                                @{
                                                    var percent = v.TotalOriginalAmount > 0 ? (v.TotalDiscountAmount / v.TotalOriginalAmount) * 100 : 0;
                                                }
                                                @percent.ToString("0.0")%
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted">No voucher data for this period.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    <!-- Báo Cáo Chi Phí Tip -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Tip Expense Report</h6>
                    <span class="font-weight-bold text-danger">Total Tip: @Model.TotalTipAmount.ToString("#,##0") VNĐ</span>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Description</th>
                                    <th class="text-right">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.TipStats.Any())
                                {
                                    @foreach (var t in Model.TipStats)
                                    {
                                        <tr>
                                            <td>@t.Date.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@t.Description</td>
                                            <td class="text-right font-weight-bold">@t.Amount.ToString("#,##0")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted">No Tip data for this period.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function setFilter(type) {
            var today = new Date();
            var fromDate, toDate;
            
            if (type === 'today') {
                fromDate = today;
                toDate = today;
            } else if (type === 'week') {
                // First day of week (Monday)
                var day = today.getDay() || 7; // Get current day number, converting Sun 0 to 7
                if(day !== 1) today.setHours(-24 * (day - 1)); 
                fromDate = today;
                toDate = new Date(today);
                toDate.setDate(today.getDate() + 6);
            } else if (type === 'month') {
                fromDate = new Date(today.getFullYear(), today.getMonth(), 1);
                toDate = new Date(today.getFullYear(), today.getMonth() + 1, 0); // Last day of month
            }

            // Format YYYY-MM-DD
            document.getElementById('fromDate').value = fromDate.toISOString().split('T')[0];
            document.getElementById('toDate').value = toDate.toISOString().split('T')[0];
            
            // Auto-submit form
            document.getElementById('filterForm').submit();
        }

        var ctx = document.getElementById("revenueChart").getContext('2d');
        var myChart = new Chart(ctx, {
            type: '@(Model.FilterType == "Date" ? "line" : "bar")',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.ChartLabels)),
                datasets: [{
                    label: 'Revenue (VND)',
                    data: @Html.Raw(Json.Serialize(Model.ChartData)),
                    backgroundColor: 'rgba(78, 115, 223, 0.5)',
                    borderColor: 'rgba(78, 115, 223, 1)',
                    borderWidth: 1,
                    fill: @(Model.FilterType == "Date" ? "true" : "false")
                }]
            },
            options: {
                maintainAspectRatio: false,
                layout: {
                    padding: {
                        left: 10,
                        right: 25,
                        top: 25,
                        bottom: 0
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false,
                            drawBorder: false
                        },
                        ticks: {
                            maxTicksLimit: 20
                        }
                    },
                    y: {
                        ticks: {
                            maxTicksLimit: 5,
                            padding: 10,
                            callback: function(value, index, values) {
                                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(value);
                            }
                        },
                        grid: {
                            color: "rgb(234, 236, 244)",
                            zeroLineColor: "rgb(234, 236, 244)",
                            drawBorder: false,
                            borderDash: [2],
                            zeroLineBorderDash: [2]
                        }
                    }
                },
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                         callbacks: {
                            label: function(context) {
                                var label = context.dataset.label || '';
                                if (label) {
                                    label += ': ';
                                }
                                if (context.parsed.y !== null) {
                                    label += new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.parsed.y);
                                }
                                return label;
                            }
                        }
                    }
                }
            }
        });
    </script>
}
