@model SpaBookingWeb.ViewModels.Manager.VoucherDashboardViewModel

@{
    ViewData["Title"] = "Voucher Management";
    Layout = "~/Areas/Manager/Views/Shared/_Layout.cshtml";
}


    <div class="row justify-content-center">
        <div class="col-12">
            <div class="row align-items-center mb-4">
                <div class="col">
                    <h2 class="h3 page-title">Voucher Management</h2>
                    <p class="text-muted">Manage discount codes and promotions.</p>
                </div>
                <div class="col-auto">
                    <a asp-action="Create" class="btn btn-primary">
                        <span class="fe fe-plus fe-16 mr-2"></span>Add New Voucher
                    </a>
                </div>
            </div>

            <!-- Dashboard Stats -->
            <div class="row mb-4">
                <div class="col-md-6 col-xl-3 mb-4">
                    <div class="card shadow border-0">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-3 text-center">
                                    <span class="circle circle-sm bg-primary-light">
                                        <i class="fe fe-16 fe-tag text-white mb-0"></i>
                                    </span>
                                </div>
                                <div class="col pr-0">
                                    <p class="small text-muted mb-0">Active Vouchers</p>
                                    <span class="h3 mb-0">@Model.ActiveCount</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3 mb-4">
                    <div class="card shadow border-0">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-3 text-center">
                                    <span class="circle circle-sm bg-success-light">
                                        <i class="fe fe-16 fe-shopping-bag text-white mb-0"></i>
                                    </span>
                                </div>
                                <div class="col pr-0">
                                    <p class="small text-muted mb-0">Total Uses</p>
                                    <span class="h3 mb-0">@Model.TotalUsed</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if(TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            <div class="card shadow">
                <div class="card-body">
                    <table class="table datatables" id="dataTable-voucher">
                        <thead class="thead-dark">
                            <tr>
                                <th>Name / Code</th>
                                <th>Discount</th>
                                <th>Min Spend</th>
                                <th>Usage (Used/Total)</th>
                                <th>Validity</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Vouchers)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.Name</strong><br/>
                                        <span class="badge badge-light text-uppercase border">@item.Code</span>
                                    </td>
                                    <td class="text-primary font-weight-bold">@item.ValueDisplay</td>
                                    <td>@item.MinSpendDisplay</td>
                                    <td>@item.UsageStatus</td>
                                    <td><small>@item.DateRange</small></td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="dot dot-lg bg-success mr-1"></span> <span>Active</span>
                                        }
                                        else
                                        {
                                            <span class="dot dot-lg bg-secondary mr-1"></span> <span>Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="dropdown">
                                            <button class="btn btn-sm dropdown-toggle" type="button" data-toggle="dropdown">
                                                <i class="fe fe-more-vertical"></i>
                                            </button>
                                            <div class="dropdown-menu dropdown-menu-right">
                                                <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.VoucherId">Edit</a>
                                                <a class="dropdown-item" asp-action="Details" asp-route-id="@item.VoucherId">Details</a>
                                                <form asp-action="Delete" asp-route-id="@item.VoucherId" method="post" onsubmit="return confirm('Are you sure you want to delete this voucher?');">
                                                    <button type="submit" class="dropdown-item text-danger">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
