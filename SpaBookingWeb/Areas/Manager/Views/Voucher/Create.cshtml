@model SpaBookingWeb.ViewModels.Manager.CreateVoucherViewModel

@{
    ViewData["Title"] = "Add New Voucher";
    Layout = "~/Areas/Manager/Views/Shared/_Layout.cshtml";
}


    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <h2 class="h3 mb-4 page-title">Add New Voucher</h2>
            <div class="card shadow mb-4">
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        
                        <!-- Basic Info -->
                        <h5 class="mb-3">1. Voucher Information</h5>
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="Name">Voucher Name <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="Ex: Tet Promotion 2025" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Code">Code <span class="text-danger">*</span></label>
                                <input asp-for="Code" class="form-control text-uppercase" placeholder="Ex: TET2025" />
                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="Description">Description / Notes</label>
                            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        </div>

                        <hr />

                        <!-- Value & Limits -->
                        <h5 class="mb-3">2. Value & Conditions</h5>
                        <div class="form-row">
                            <div class="form-group col-md-4">
                                <label asp-for="DiscountType">Discount Type</label>
                                <select asp-for="DiscountType" class="form-control" id="discountType">
                                    <option value="Percent">Percentage (%)</option>
                                    <option value="Amount">Fixed Amount (VND)</option>
                                </select>
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="DiscountValue">Discount Value</label>
                                <input asp-for="DiscountValue" class="form-control" type="number" min="0" />
                                <span asp-validation-for="DiscountValue" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-4" id="maxDiscountGroup">
                                <label asp-for="MaxDiscountAmount">Maximum Discount (VND)</label>
                                <input asp-for="MaxDiscountAmount" class="form-control" type="number" placeholder="Leave empty if unlimited" min="0" />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="MinSpend">Minimum Order (VND)</label>
                                <input asp-for="MinSpend" class="form-control" type="number" value="0" min="0" />
                                <small class="text-muted">Minimum order value to apply this code.</small>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="UsageLimit">Usage Limit</label>
                                <input asp-for="UsageLimit" class="form-control" type="number" value="100" min="0" />
                                <small class="text-muted">Enter 0 for unlimited usage.</small>
                            </div>
                        </div>

                        <hr />

                        <!-- Time -->
                        <h5 class="mb-3">3. Validity Period</h5>
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="StartDate">Start Date</label>
                                <input asp-for="StartDate" class="form-control" type="date" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="EndDate">End Date</label>
                                <input asp-for="EndDate" class="form-control" type="date" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group mt-3">
                            <div class="custom-control custom-switch">
                                <input type="checkbox" class="custom-control-input" asp-for="IsActive">
                                <label class="custom-control-label font-weight-bold" asp-for="IsActive">Activate immediately after creation</label>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary px-4">Save Voucher</button>
                            <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


@section Scripts {
    <script>
        $(document).ready(function () {
            // Ẩn hiện ô MaxDiscountAmount dựa trên loại giảm giá
            function toggleMaxDiscount() {
                var type = $("#discountType").val();
                if (type == "Percent") { 
                    $("#maxDiscountGroup").slideDown();
                } else {
                    $("#maxDiscountGroup").slideUp();
                    $("#MaxDiscountAmount").val(''); // Reset giá trị
                }
            }
            $("#discountType").change(toggleMaxDiscount);
            toggleMaxDiscount(); // Chạy khi tải trang

            // Validate on Submit
            $("form").on("submit", function(e) {
                var today = new Date();
                today.setHours(0, 0, 0, 0);

                var startDateStr = $("#StartDate").val();
                var endDateStr = $("#EndDate").val();
                
                var isValid = true;
                
                // Validate StartDate >= Today
                if(startDateStr) {
                    var startDate = new Date(startDateStr);
                     if(startDate < today) {
                        alert("Start date cannot be earlier than today.");
                        $("#StartDate").focus();
                        isValid = false;
                        return false; 
                    }
                }

                // Validate EndDate >= StartDate
                if(startDateStr && endDateStr) {
                    var startDate = new Date(startDateStr);
                    var endDate = new Date(endDateStr);

                     if(endDate < startDate) {
                        alert("End date must be greater than or equal to start date.");
                        $("#EndDate").focus();
                        isValid = false;
                        return false;
                    }
                }
                
                return isValid;
            });
        });
    </script>
}
