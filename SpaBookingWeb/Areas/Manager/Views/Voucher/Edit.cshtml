@model SpaBookingWeb.ViewModels.Manager.CreateVoucherViewModel

@{
    ViewData["Title"] = "Update Voucher";
    Layout = "~/Areas/Manager/Views/Shared/_Layout.cshtml";
}


    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <h2 class="h3 mb-4 page-title">Update Voucher: @Model.Code</h2>
            <div class="card shadow mb-4">
                <div class="card-body">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="VoucherId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <h5 class="mb-3">Voucher Information</h5>
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="Name">Voucher Name <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Code">Code <span class="text-danger">*</span></label>
                                <input asp-for="Code" class="form-control text-uppercase" />
                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="Description">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        </div>

                        <hr />
                        <h5 class="mb-3">Value & Conditions</h5>
                        <div class="form-row">
                            <div class="form-group col-md-4">
                                <label asp-for="DiscountType">Discount Type</label>
                                <select asp-for="DiscountType" class="form-control" id="discountType">
                                    <option value="Percent">Percentage (%)</option>
                                    <option value="Amount">Fixed Amount (VND)</option>
                                </select>
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="DiscountValue">Discount Value</label>
                                <input asp-for="DiscountValue" class="form-control" type="number" />
                                <span asp-validation-for="DiscountValue" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-4" id="maxDiscountGroup">
                                <label asp-for="MaxDiscountAmount">Maximum Discount (VND)</label>
                                <input asp-for="MaxDiscountAmount" class="form-control" type="number" />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="MinSpend">Minimum Order (VND)</label>
                                <input asp-for="MinSpend" class="form-control" type="number" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="UsageLimit">Usage Limit</label>
                                <input asp-for="UsageLimit" class="form-control" type="number" />
                                <small class="text-muted">Enter 0 for unlimited.</small>
                            </div>
                        </div>

                        <hr />
                        <h5 class="mb-3">Validity Period</h5>
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="StartDate">Start Date</label>
                                <input asp-for="StartDate" class="form-control" type="date" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="EndDate">End Date</label>
                                <input asp-for="EndDate" class="form-control" type="date" />
                            </div>
                        </div>

                        <div class="form-group mt-3">
                            <div class="custom-control custom-switch">
                                <input type="checkbox" class="custom-control-input" asp-for="IsActive">
                                <label class="custom-control-label font-weight-bold" asp-for="IsActive">Active</label>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                            <a asp-action="Index" class="btn btn-secondary px-4">Back</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


@section Scripts {
    <script>
        $(document).ready(function () {
            function toggleMaxDiscount() {
                var type = $("#discountType").val();
                if (type == "Percent") {
                    $("#maxDiscountGroup").show();
                } else {
                    $("#maxDiscountGroup").hide();
                }
            }
            $("#discountType").change(toggleMaxDiscount);
            toggleMaxDiscount();
        });
    </script>
}
