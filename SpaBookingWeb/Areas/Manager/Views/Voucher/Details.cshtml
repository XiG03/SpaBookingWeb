@model SpaBookingWeb.Models.Voucher

@{
    ViewData["Title"] = "Voucher Details";
    Layout = "~/Areas/Manager/Views/Shared/_Layout.cshtml";
}


    <div class="row justify-content-center">
        <div class="col-12 col-md-10">
            <h2 class="h3 mb-4 page-title">Details: @Model.Code</h2>
            <div class="card shadow mb-4">
                <div class="card-header">
                    <strong class="card-title">Detailed Information</strong>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Voucher Name</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Code</dt>
                        <dd class="col-sm-8"><span class="badge badge-light border text-uppercase">@Model.Code</span>
                        </dd>

                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">@Model.Description</dd>

                        <dt class="col-sm-4">Discount</dt>
                        <dd class="col-sm-8">
                            @if (Model.DiscountType == "Percent")
                            {
                                <span class="text-primary font-weight-bold">Discount
                                    @Model.DiscountValue.ToString("0.#")%</span>
                                @if (Model.MaxDiscountAmount.HasValue)
                                {
                                    <div class="small text-muted">(Max Discount @Model.MaxDiscountAmount.Value.ToString("N0")
                                        VND)</div>
                                }
                            }
                            else
                            {
                                <span class="text-primary font-weight-bold">Discount @Model.DiscountValue.ToString("N0")
                                    VND</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Conditions</dt>
                        <dd class="col-sm-8">
                            Min Order: <strong>@Model.MinSpend.ToString("N0") VND</strong>
                        </dd>

                        <dt class="col-sm-4">Usage Status</dt>
                        <dd class="col-sm-8">
                            Used: <strong>@Model.UsageCount</strong> /
                            @(Model.UsageLimit > 0 ? Model.UsageLimit.ToString() : "Unlimited") times
                        </dd>

                        <dt class="col-sm-4">Validity Period</dt>
                        <dd class="col-sm-8">
                            From @Model.StartDate.ToString("dd/MM/yyyy") to @Model.EndDate.ToString("dd/MM/yyyy")
                        </dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Inactive</span>
                            }
                        </dd>
                    </dl>
                    <div class="mt-4 border-top pt-3">
                        <a asp-action="Edit" asp-route-id="@Model.VoucherId" class="btn btn-primary">Edit</a>
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
