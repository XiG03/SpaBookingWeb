@model SpaBookingWeb.ViewModels.Manager.ComboViewModel

@{
    ViewData["Title"] = "Update Combo";
    Layout = "~/Areas/Manager/Views/Shared/_Layout.cshtml";
}


    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-10">
            <h2 class="h3 mb-4 page-title">Update Combo</h2>
            <div class="card shadow mb-4">
                <div class="card-header">
                    <strong class="card-title">Combo Information #@Model.ComboId</strong>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Hidden Fields: Quan trọng để giữ ID và ảnh cũ nếu không thay đổi -->
                        <input type="hidden" asp-for="ComboId" />
                        <input type="hidden" asp-for="ExistingImage" />

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="ComboName" class="control-label">Combo Name <span
                                        class="text-danger">*</span></label>
                                <input asp-for="ComboName" class="form-control" />
                                <span asp-validation-for="ComboName" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Price" class="control-label">Price (VND) <span
                                        class="text-danger">*</span></label>
                                <input asp-for="Price" class="form-control" type="number" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Dropdown Multi-Select -->
                        <div class="form-group">
                            <label asp-for="SelectedServiceIds" class="control-label">Included Services (Editable) <span class="text-danger">*</span></label>
                            <select asp-for="SelectedServiceIds" asp-items="Model.AvailableServices"
                                class="form-control select2-multi" multiple="multiple" style="width: 100%;">
                            </select>
                            <span asp-validation-for="SelectedServiceIds" class="text-danger"></span>
                            <small class="form-text text-muted">Add or remove services from this list.</small>
                        </div>

                        <div class="form-group">
                            <label class="control-label">Image</label>

                            <!-- Hiển thị ảnh hiện tại -->
                            <div class="mb-2 ">
                                @if (!string.IsNullOrEmpty(Model.ExistingImage))
                                {
                                    <div class="p-2 border rounded d-inline-block bg-light">
                                        <img src="@Model.ExistingImage" class="img-fluid"
                                            style="max-height: 300px; object-fit: contain;" alt="Current Image" />
                                        <div class="small text-muted mt-1 text-center">Current Image</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted font-italic p-2 border rounded d-inline-block">No Image</div>
                                }
                            </div>

                            <!-- Input chọn ảnh mới -->
                            <div class="custom-file mt-2">
                                <input asp-for="ImageFile" class="custom-file-input" id="customFile" accept="image/*">
                                <label class="custom-file-label" for="customFile">Choose new image (optional)...</label>
                            </div>
                            <span asp-validation-for="ImageFile" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Description" class="control-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <hr />
                        <h5 class="mb-3">Estimated Material Usage (Automatic from Services)</h5>
                        <div id="consumables-display-area" class="alert alert-secondary">
                            <p class="text-muted mb-0 font-italic">Calculating...</p>
                        </div>
                        <hr />

                        <div class="mt-4 d-flex justify-content-end">
                            <a asp-action="Index" class="btn btn-secondary mr-2">Cancel</a>
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            // Hiển thị tên file khi chọn ảnh mới
            $('.custom-file-input').on('change', function () {
                var fileName = $(this).val().split('\\').pop();
                $(this).next('.custom-file-label').addClass("selected").html(fileName);
            });

            // Select2 tự động nhận diện các giá trị đã chọn (selected) từ Model.SelectedServiceIds
            // nhờ Tag Helper asp-for bind dữ liệu vào thẻ <select>
            var $select = $('.select2-multi').select2({
                theme: 'bootstrap4',
                placeholder: "--- Select Services ---",
                allowClear: true,
                width: '100%'
            });

            // --- Logic Nguyên Liệu Display Only ---
            var serviceConsumablesMap = @Html.Raw(Json.Serialize(Model.ServiceConsumablesMap));

             $select.on('change', function () {
                var selectedServiceIds = $(this).val(); 
                updateConsumablesDisplay(selectedServiceIds);
            });

            function updateConsumablesDisplay(ids) {
                var $container = $("#consumables-display-area");
                if (!ids || ids.length === 0) {
                    $container.html('<p class="text-muted mb-0 font-italic">No services selected.</p>');
                    return;
                }

                var summary = {};
                ids.forEach(function(sidStr) {
                    var sid = parseInt(sidStr);
                    if (serviceConsumablesMap[sid]) {
                        var list = serviceConsumablesMap[sid];
                        list.forEach(function(item) {
                            if (!summary[item.productId]) {
                                summary[item.productId] = {
                                    name: item.productName,
                                    unit: item.unitName,
                                    qty: 0
                                };
                            }
                            summary[item.productId].qty += item.quantity;
                        });
                    }
                });

                var keys = Object.keys(summary);
                if (keys.length === 0) {
                    $container.html('<p class="text-muted mb-0 font-italic">Selected services do not consume materials.</p>');
                } else {
                     var html = '<ul class="list-group list-group-flush" style="background: transparent;">';
                    keys.forEach(function(pid) {
                        var data = summary[pid];
                        html += `<li class="list-group-item d-flex justify-content-between align-items-center" style="background: transparent; padding: 0.5rem 0;">
                                    <span>${data.name}</span>
                                    <span class="badge badge-info badge-pill" style="font-size: 1rem;">${data.qty} ${data.unit || ''}</span>
                                 </li>`;
                    });
                    html += '</ul>';
                    $container.html(html);
                }
            }

            // Trigger initial calculation
            updateConsumablesDisplay($select.val());
        });
    </script>
}