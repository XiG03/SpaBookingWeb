@model SpaBookingWeb.ViewModels.Manager.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Manager/Views/Shared/_Layout.cshtml";
}

<!-- CSS FullCalendar -->
<link href='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css' rel='stylesheet' />

<div class="container-fluid">
    <!-- Header -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Today's Overview (@DateTime.Today.ToString("dd/MM/yyyy"))</h1>
        <a asp-controller="Appointments" asp-action="Create" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Create New Appointment
        </a>
    </div>

    <!-- 1. Thống kê Cards -->
    <div class="row">
        <!-- Tổng số lịch hẹn -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Appointments Today</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalAppointmentsToday</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Doanh thu ước tính -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Estimated Revenue</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.EstimatedRevenueToday.ToString("N0") VND</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chờ xử lý -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Pending</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.PendingAppointments</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Đã hủy -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Cancelled</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.CancelledAppointments</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-ban fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- 2. Cột trái: Calendar & Danh sách chi tiết -->
        <div class="col-xl-8 col-lg-7">
            <!-- FullCalendar -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">General Schedule</h6>
                </div>
                <div class="card-body">
                    <div id='calendar'></div>
                </div>
            </div>

            <!-- Danh sách chi tiết hôm nay -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Today's Appointment Details</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>Customer</th>
                                    <th>Service</th>
                                    <th>Staff</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if(Model.TodayAppointments.Any())
                                {
                                    @foreach (var item in Model.TodayAppointments)
                                    {
                                        <tr>
                                            <td>@item.StartTime.ToString("HH:mm")</td>
                                            <td>@item.CustomerName</td>
                                            <td><small>@item.ServiceNames</small></td>
                                            <td>@item.EmployeeName</td>
                                            <td>
                                                <span class="badge badge-@item.StatusColor">@item.Status</span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">No appointments today.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Cột phải: Danh sách điểm danh -->
        <div class="col-xl-4 col-lg-5">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Shift Staff</h6>
                    <a asp-controller="Employee" asp-action="Schedule" class="btn btn-sm btn-info">
                        <i class="fas fa-edit"></i> Manage
                    </a>
                </div>
                <div class="card-body">
                    @foreach (var shift in Model.ShiftAttendances)
                    {
                        <div class="mb-4">
                            <h6 class="font-weight-bold text-secondary border-bottom pb-2">
                                @shift.ShiftName <small class="float-right">@shift.TimeRange</small>
                            </h6>
                            @if(shift.Employees.Any())
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var emp in shift.Employees)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                            <div class="d-flex align-items-center">
                                                <img src="@emp.Avatar" class="rounded-circle mr-2" style="width:30px;height:30px; object-fit:cover;">
                                                <span>@emp.FullName</span>
                                            </div>
                                            @if (emp.IsPresent)
                                            {
                                                <span class="badge badge-success">
                                                    <i class="fas fa-check"></i> @(emp.CheckInTime?.ToString("HH:mm") ?? "Arrived")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">Not Arrived</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted small font-italic">No staff assigned to this shift.</p>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Appointment Details -->
<div class="modal fade" id="appointmentDetailModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Appointment Details #<span id="modalAppId"></span></h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Customer:</strong> <span id="modalCustomerName"></span></p>
                        <p><strong>Phone:</strong> <span id="modalCustomerPhone"></span></p>
                    </div>
                    <div class="col-md-6 text-right">
                        <p><strong>Time:</strong> <span id="modalTime"></span></p>
                        <p><strong>Status:</strong> <span id="modalStatus" class="badge"></span></p>
                    </div>
                </div>
                
                <div class="alert alert-info d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Deposit: </strong> <span id="modalDepositStatus"></span>
                    </div>
                    <div>
                        <strong>Remaining: </strong> <span id="modalRemaining" class="font-weight-bold text-danger" style="font-size: 1.1em"></span>
                    </div>
                </div>
                
                <div id="paymentStatusAlert" class="alert alert-success d-none">
                    <i class="fas fa-check-double"></i> <strong>Fully Paid.</strong>
                </div>
                
                <h6 class="font-weight-bold border-bottom pb-2">Service Details</h6>
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Service</th>
                            <th>Staff</th>
                            <th class="text-right">Price</th>
                        </tr>
                    </thead>
                    <tbody id="modalServicesBody">
                        <!-- JS fill -->
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="2" class="text-right font-weight-bold">Total:</td>
                            <td class="text-right font-weight-bold text-primary" id="modalTotal"></td>
                        </tr>
                    </tfoot>
                </table>
                
                <div class="mt-3">
                    <p><strong>Note:</strong> <span id="modalNote" class="font-italic text-muted"></span></p>
                </div>
            </div>
            <div class="modal-footer">
                <a href="#" id="modalLinkDetail" class="btn btn-info">View/Edit Full</a>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- FullCalendar JS -->
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js'></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth', 
                locale: 'en',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                events: '/Manager/Home/GetCalendarEvents',
                eventClick: function(info) {
                    // Ngăn chuyển trang mặc định
                    info.jsEvent.preventDefault();
                    
                    // Lấy ID sự kiện
                    var appId = info.event.id;
                    
                    // Gọi API lấy chi tiết để hiện Modal
                    fetch('/Manager/Home/GetAppointmentDetails/' + appId)
                        .then(response => response.json())
                        .then(data => {
                            // Điền dữ liệu vào Modal
                            document.getElementById('modalAppId').textContent = data.appointmentId;
                            document.getElementById('modalCustomerName').textContent = data.customerName;
                            document.getElementById('modalCustomerPhone').textContent = data.customerPhone;
                            
                            // Format thời gian
                            var start = new Date(data.startTime).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' });
                            var end = new Date(data.endTime).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit' });
                            document.getElementById('modalTime').textContent = start + ' - ' + end;
                            
                            // Status Badge
                            var statusBadge = document.getElementById('modalStatus');
                            statusBadge.textContent = data.status;
                            statusBadge.className = 'badge badge-' + getStatusColor(data.status);
                            
                            // Note
                            document.getElementById('modalNote').textContent = data.note || "No notes";
                            
                            // Services Table
                            var tbody = document.getElementById('modalServicesBody');
                            tbody.innerHTML = ''; // Clear cũ
                            data.services.forEach(s => {
                                var row = `<tr>
                                    <td>${s.serviceName}</td>
                                    <td>${s.technicianName}</td>
                                    <td class="text-right">${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(s.price)}</td>
                                </tr>`;
                                tbody.insertAdjacentHTML('beforeend', row);
                            });
                            
                            // Format tiền tệ
                            const fmt = (n) => new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n);

                            // Logic tính toán
                            var total = data.totalAmount;
                            var deposit = data.depositAmount;
                            var isPaid = data.isDepositPaid;
                            
                            // Số tiền còn lại phải trả tại quầy
                            var remaining = total - (isPaid ? deposit : 0);

                            document.getElementById('modalTotal').textContent = fmt(total);
                            document.getElementById('modalRemaining').textContent = fmt(remaining);
                            
                            var depositStatusEl = document.getElementById('modalDepositStatus');
                            var paymentAlert = document.getElementById('paymentStatusAlert');
                            var remainingEl = document.getElementById('modalRemaining');

                            // Reset state
                            paymentAlert.classList.add('d-none');
                            remainingEl.parentElement.parentElement.classList.remove('d-none'); // Hiện lại box info cọc/remaining mặc định

                            // Nếu đã thanh toán hết HOẶC số tiền còn lại <= 0
                            if (data.isPaidFull || remaining <= 0) {
                                paymentAlert.classList.remove('d-none');
                                // Ẩn box cọc/remaining
                                remainingEl.parentElement.parentElement.classList.add('d-none');
                            } 
                            else {
                                // Logic cũ cho các trường hợp chưa thanh toán hết
                                if (isPaid) {
                                    // Đã cọc
                                    depositStatusEl.innerHTML = `<span class="text-success font-weight-bold">
                                        <i class="fas fa-check-circle"></i> Paid (${fmt(deposit)})
                                    </span>`;
                                } else {
                                    if (deposit > 0) {
                                        // Có yêu cầu cọc nhưng chưa đóng
                                        depositStatusEl.innerHTML = `<span class="text-danger font-weight-bold">
                                            <i class="fas fa-times-circle"></i> Not Paid
                                        </span> 
                                        <span class="small text-muted d-block">(Req: ${fmt(deposit)})</span>`;
                                    } else {
                                        // Không yêu cầu cọc
                                        depositStatusEl.innerHTML = `<span class="text-secondary">
                                            <i class="fas fa-minus-circle"></i> Not Required
                                        </span>`;
                                    }
                                }
                                document.getElementById('modalRemaining').textContent = fmt(remaining);
                            }
                            
                            // Link chi tiết
                            document.getElementById('modalLinkDetail').href = '/Manager/Appointments/Details/' + data.appointmentId;
                            
                            // Show Modal (Dùng jQuery theo Bootstrap 4)
                            $('#appointmentDetailModal').modal('show');
                        })
                        .catch(err => console.error('Error loading details:', err));
                },
                eventDidMount: function(info) {
                    info.el.title = info.event.extendedProps.description.replace(/<br\/>/g, '\n'); 
                }
            });
            calendar.render();
        });

        function getStatusColor(status) {
            switch(status) {
                case 'Pending': return 'warning';
                case 'Confirmed': return 'primary';
                case 'Completed': return 'success';
                case 'Cancelled': return 'danger';
                default: return 'secondary';
            }
        }
    </script>
}