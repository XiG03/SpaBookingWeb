@model SpaBookingWeb.Models.Service

@{
    ViewData["Title"] = "Confirm Delete Service";
    Layout = "~/Areas/Manager/Views/Shared/_Layout.cshtml";
}

    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="row align-items-center my-4">
                <div class="col">
                    <h2 class="h3 mb-0 page-title text-danger">Deactivate Service?</h2>
                    <p class="text-muted">Are you sure you want to deactivate this service? This service will no longer be visible to customers for booking.</p>
                </div>
            </div>

            <div class="card shadow mb-4">
                <div class="card-header">
                    <strong class="card-title">Service Details</strong>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 text-center">
                            @if (!string.IsNullOrEmpty(Model.Image))
                            {
                                <img src="@Model.Image" alt="@Model.ServiceName" class="img-fluid rounded shadow-sm" style="max-height: 250px;" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                    <span class="text-muted">No Image</span>
                                </div>
                            }
                        </div>
                        <div class="col-md-8">
                            <dl class="row">
                                <dt class="col-sm-3">Service Name</dt>
                                <dd class="col-sm-9"><h3>@Model.ServiceName</h3></dd>

                                <dt class="col-sm-3">Price</dt>
                                <dd class="col-sm-9 text-success font-weight-bold">@Model.Price.ToString("N0") VNĐ</dd>

                                <dt class="col-sm-3">Duration</dt>
                                <dd class="col-sm-9">@Model.DurationMinutes minutes</dd>

                                <dt class="col-sm-3">Status</dt>
                                <dd class="col-sm-9">
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge badge-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Inactive</span>
                                    }
                                </dd>

                                <dt class="col-sm-3">Deposit Required</dt>
                                <dd class="col-sm-9">@(Model.RequiresDeposit ? "Yes" : "No")</dd>

                                <dt class="col-sm-3">Description</dt>
                                <dd class="col-sm-9">@Model.Description</dd>
                            </dl>

                            <hr />
                            
                            <form asp-action="Delete" method="post">
                                <input type="hidden" name="id" value="@Model.ServiceId" />
                                <button type="submit" class="btn btn-danger">
                                    <i class="fe fe-trash-2 mr-2"></i>Confirm Deactivate
                                </button>
                                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
