@model SpaBookingWeb.ViewModels.Manager.ServiceDashboardViewModel

@{
    ViewData["Title"] = "Service Management & Statistics";
    Layout = "~/Areas/Manager/Views/Shared/_Layout.cshtml";
}


    <div class="row justify-content-center">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="page-title">Service Management</h2>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fe fe-plus-circle mr-2"></i>Add Service
                </a>
            </div>
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }

            <!-- ... (Phần thống kê và biểu đồ giữ nguyên) ... -->
            <div class="row my-4">
                <div class="col-md-6 col-xl-3 mb-4">
                    <div class="card shadow border-0">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-3 text-center">
                                    <span class="circle circle-md bg-primary-light">
                                        <i class="fe fe-16 fe-layers text-white mb-0"></i>
                                    </span>
                                </div>
                                <div class="col pr-0">
                                    <p class="small text-muted mb-0">Total Services</p>
                                    <span class="h3 mb-0">@Model.TotalServices</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3 mb-4">
                    <div class="card shadow border-0">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-3 text-center">
                                    <span class="circle circle-md bg-success-light">
                                        <i class="fe fe-16 fe-check-circle text-white mb-0"></i>
                                    </span>
                                </div>
                                <div class="col pr-0">
                                    <p class="small text-muted mb-0">Active Services</p>
                                    <span class="h3 mb-0">@Model.TotalActiveServices</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row my-4">
                <div class="col-md-6 mb-4">
                    <div class="card shadow">
                        <div class="card-header"><strong class="card-title">Service Usage (Top 10)</strong></div>
                        <div class="card-body"><div id="usageChart"></div></div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="card shadow">
                        <div class="card-header"><strong class="card-title">Revenue by Service (Top 10)</strong></div>
                        <div class="card-body"><div id="revenueChart"></div></div>
                    </div>
                </div>
            </div>

            <!-- Bảng danh sách -->
            <div class="row my-4">
                <div class="col-md-12">
                    <div class="card shadow">
                        <div class="card-body">
                            <h5 class="card-title mb-3">Detailed List</h5>
                            <table class="table datatables" id="dataTable-1">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>
                                            Service Name
                                            <div class="mt-1">
                                                <input type="text" id="searchServiceInput" class="form-control form-control-sm" 
                                                       placeholder="Filter..." value="@ViewData["CurrentFilter"]" 
                                                       oninput="filterServices(this)">
                                            </div>
                                        </th>
                                        <th>Base Price</th>
                                        <th>Status</th>
                                        <th>Usage Count</th>
                                        <th>Total Revenue</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="serviceTableBody">
                                    <partial name="_ServiceTableRows" model="Model.Services" />
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


@section Scripts {
    <script src="~/ManagerAssets/js/apexcharts.min.js"></script>
    <script>
        var labels = @Html.Raw(Json.Serialize(Model.ChartLabels));
        var usageData = @Html.Raw(Json.Serialize(Model.ChartUsageCount));
        var revenueData = @Html.Raw(Json.Serialize(Model.ChartRevenue));

        var usageOptions = {
            series: [{ name: 'Usage Count', data: usageData }],
            chart: { type: 'bar', height: 350 },
            plotOptions: { bar: { borderRadius: 4, horizontal: true } },
            dataLabels: { enabled: true },
            xaxis: { categories: labels },
            colors: ['#3ad29f']
        };
        new ApexCharts(document.querySelector("#usageChart"), usageOptions).render();

        var revenueOptions = {
            series: [{ name: 'Revenue (VND)', data: revenueData }],
            chart: { type: 'bar', height: 350 },
            plotOptions: { bar: { borderRadius: 4, columnWidth: '50%' } },
            dataLabels: { enabled: false },
            xaxis: { categories: labels },
            yaxis: { labels: { formatter: function (value) { return value.toLocaleString('vi-VN') + " đ"; } } },
            colors: ['#1b68ff'],
            tooltip: { y: { formatter: function (val) { return val.toLocaleString('vi-VN') + " đ"; } } }
        };
        new ApexCharts(document.querySelector("#revenueChart"), revenueOptions).render();

        // --- Live Search Script ---
        let timeout = null;
        function filterServices(input) {
            clearTimeout(timeout);
            timeout = setTimeout(function () {
                var searchName = input.value;
                var url = '@Url.Action("Filter", "Service")?searchName=' + encodeURIComponent(searchName);
                
                fetch(url)
                    .then(response => response.text())
                    .then(html => {
                        document.getElementById('serviceTableBody').innerHTML = html;
                    })
                    .catch(error => console.error('Error:', error));
            }, 300); // Debounce 300ms
        }
    </script>
}
