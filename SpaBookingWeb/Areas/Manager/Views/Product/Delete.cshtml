@model SpaBookingWeb.Models.Product

@{
    ViewData["Title"] = "Delete Product";
    Layout = "~/Areas/Manager/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-6">
            
            <div class="alert alert-warning" role="alert">
                <h4 class="alert-heading"><i class="fe fe-alert-triangle mr-2"></i>Warning!</h4>
                <p>You are about to delete product <strong>@Model.ProductName</strong>. This action cannot be undone.</p>
            </div>

            <div class="card shadow mb-4">
                <div class="card-header">
                    <strong class="card-title text-danger">Product Details to Delete</strong>
                </div>
                <div class="card-body">
                    <h4 class="mb-3">@Model.ProductName</h4>
                    
                    <dl class="row">
                        <dt class="col-sm-4">Product ID</dt>
                        <dd class="col-sm-8">#@Model.ProductId</dd>

                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@(Model.Category?.CategoryName ?? "None")</dd>

                        <dt class="col-sm-4">Unit</dt>
                        <dd class="col-sm-8">@(Model.Unit?.UnitName ?? "Item")</dd>

                        <dt class="col-sm-4">Purchase Price</dt>
                        <dd class="col-sm-8">@Model.PurchasePrice.ToString("N0") VND</dd>

                        <dt class="col-sm-4">Sale Price</dt>
                        <dd class="col-sm-8 text-success font-weight-bold">@Model.SalePrice.ToString("N0") VND</dd>

                        <dt class="col-sm-4">Current Stock</dt>
                        <dd class="col-sm-8">@Model.StockQuantity</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsForSale)
                            {
                                <span class="badge badge-success">For Sale</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Internal Use Only</span>
                            }
                        </dd>
                    </dl>

                    <hr />

                    <form asp-action="Delete" method="post" class="d-flex justify-content-end">
                        <input type="hidden" name="id" value="@Model.ProductId" />
                        
                        <a asp-action="Index" class="btn btn-secondary mr-2">
                            <i class="fe fe-x mr-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="fe fe-trash-2 mr-1"></i>Confirm Permanently Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
