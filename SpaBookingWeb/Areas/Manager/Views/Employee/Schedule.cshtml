@model SpaBookingWeb.ViewModels.Manager.DailyScheduleViewModel

@{
    ViewData["Title"] = "Lịch làm việc & Điểm danh";
    Layout = "~/Areas/Manager/Views/Shared/_Layout.cshtml";
    var currentDate = Model.Date;
}

    <style>
        /* Tùy chỉnh FullCalendar cho đẹp hơn */
        #calendar {
            max-width: 100%;
            margin: 0 auto;
            background: #fff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
        }
        .fc-event {
            cursor: pointer;
        }
        .fc-daygrid-day {
            cursor: pointer;
        }
        .fc-daygrid-day:hover {
            background-color: #f8f9fc;
        }
    </style>

    <!-- Header & Buttons -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Lịch làm việc</h1>
        <div>
             <button class="btn btn-primary shadow-sm ml-2" data-toggle="modal" data-target="#manageShiftsModal">
                <i class="fas fa-cog"></i> Quản lý Ca
            </button>
            <button class="btn btn-success shadow-sm ml-2" data-toggle="modal" data-target="#assignShiftModal">
                <i class="fas fa-plus"></i> Xếp lịch
            </button>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- Calendar Container -->
    <div id='calendar'></div>

</div>

@section Scripts 
{
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js'></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'timeGridWeek', // Chế độ mặc định: Tuần
                initialDate: '@currentDate.ToString("yyyy-MM-dd")',
                height: 600, // Chiều cao cố định để lịch nhỏ gọn hơn
                // aspect Ratio: 1.5, // Hoặc dùng cái này để chỉnh tỷ lệ
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                locale: 'vi',
                slotMinTime: '06:00:00', // Giờ bắt đầu hiển thị (6h sáng)
                slotMaxTime: '22:00:00', // Giờ kết thúc hiển thị (10h tối)
                allDaySlot: false, // Ẩn dòng all-day nếu không cần thiết
                buttonText: {
                    today: 'Hôm nay',
                    month: 'Tháng',
                    week: 'Tuần',
                    day: 'Ngày'
                },
                events: '/Manager/Employee/GetCalendarEvents', 
                
                // Khi click vào ngày trống -> Mở modal xếp lịch
                dateClick: function(info) {
                    // Set ngày cho modal
                    document.querySelector('#assignShiftModal input[name="date"]').value = info.dateStr;
                    // Mở modal
                    $('#assignShiftModal').modal('show');
                },


                // Khi click vào sự kiện -> Mở modal chi tiết (Điểm danh / Xóa)
                eventClick: function(info) {
                    var eventObj = info.event;
                    var props = eventObj.extendedProps;
                    
                    // Điền thông tin vào Modal
                    var titleParts = eventObj.title.split(' ('); 
                    var empName = titleParts[0];
                    var shiftName = titleParts.length > 1 ? titleParts[1].replace(')', '') : '';
                    var start = eventObj.start ? eventObj.start : '';
                    var end = eventObj.end ? eventObj.end : '';
                    
                    // Format giờ hiển thị (HH:mm)
                    var formatTime = function(date) {
                         if(!date) return '';
                         var h = date.getHours().toString().padStart(2, '0');
                         var m = date.getMinutes().toString().padStart(2, '0');
                         return h + ':' + m;
                    };

                    // Format ngày hiển thị (dd/MM/yyyy)
                    var formatDate = function(date) {
                         if(!date) return '';
                         var d = date.getDate().toString().padStart(2, '0');
                         var mo = (date.getMonth() + 1).toString().padStart(2, '0'); // Month is 0-indexed
                         var y = date.getFullYear();
                         return d + '/' + mo + '/' + y;
                    };
                    
                    $('#eventEmployeeName').text(empName);
                    $('#eventDate').text(formatDate(start)); // Hiển thị ngày
                    $('#eventShiftName').text(shiftName);
                    $('#eventTimeRange').text(formatTime(start) + ' - ' + formatTime(end));
                    
                    var statusBadge = $('#eventStatusBadge');
                    var noteField = $('#attendanceNote');
                    var breakTimeField = $('#breakStartTime');
                    var breakGroup = $('#breakTimeGroup');
                    
                    // Reset UI states
                    $('#statusNotCheckedIn').prop('checked', false);
                    $('#statusPresent').prop('checked', false);
                    $('#statusAbsent').prop('checked', false);
                    $('#statusBreak').prop('checked', false);
                    $('#statusBreak').prop('checked', false);
                    breakGroup.hide();

                    // Set min/max for Break Time based on Shift
                    if (start && end) {
                        var minTime = formatTime(start);
                        var maxTime = formatTime(end);
                        breakTimeField.attr('min', minTime);
                        breakTimeField.attr('max', maxTime);
                        // Optional: Add helper text
                        breakTimeField.attr('title', 'Giờ nghỉ phải từ ' + minTime + ' đến ' + maxTime);
                    }

                    noteField.val(props.note || ''); 

                    if (props.isOnBreak) {
                        statusBadge.html('<span class="badge badge-warning">Đang nghỉ giữa ca</span>');
                        $('#statusBreak').prop('checked', true);
                        breakGroup.show();
                        
                        // Parse TimeSpan string (hh:mm:ss) to HH:mm for input type=time
                        if(props.breakStartTime) {
                            var t = props.breakStartTime.split(':');
                            if(t.length >= 2) breakTimeField.val(t[0] + ':' + t[1]);
                        }
                    } 
                    else if (props.isPresent) {
                        statusBadge.html('<span class="badge badge-success">Đã đi làm</span>');
                        $('#statusPresent').prop('checked', true);
                    } 
                    else {
                        if (props.note && props.note.trim() !== '') {
                             statusBadge.html('<span class="badge badge-warning">Xin vắng/Nghỉ</span>');
                             $('#statusAbsent').prop('checked', true);
                        } else {
                             statusBadge.html('<span class="badge badge-secondary">Chưa điểm danh</span>');
                             $('#statusNotCheckedIn').prop('checked', true);
                        }
                    }

                    // Handle Radio Buttons Logic
                    // We treat 4 radios as a single logical group: NotCheckedIn, Present, Absent, Break
                    // But they span two 'name' attributes: isPresent and isOnBreak
                    
                    $('input[name="isPresent"]').on('change', function() {
                        // If any isPresent radio (Present/Absent/NotChecked) is selected
                        // We must UNCHECK the Break radio and hide Break Time
                        $('#statusBreak').prop('checked', false); 
                        $('#breakTimeGroup').hide();
                        $('#isOnBreakInput').val('false');
                        
                        // Clear note if "Not Checked In" is selected
                        if ($('#statusNotCheckedIn').is(':checked')) {
                            noteField.val('');
                        }
                    });

                    $('input[name="isOnBreak"]').on('change', function() {
                        // If Break radio is selected
                        if ($(this).is(':checked')) {
                             $('#breakTimeGroup').show();
                             $('#isOnBreakInput').val('true');
                             
                             // Visually uncheck the isPresent radios
                             $('input[name="isPresent"]').prop('checked', false);
                             
                             // However, logically "On Break" implies "Present" for attendance calculation?
                             // The backend needs `isPresent` bool. 
                             // If `isPresent` radio is unchecked, what value is sent?
                             // Radios with no selection sent nothing? 
                             // We should force set the hidden logic or ensure one `isPresent` radio is checked?
                             // Or we relying on a hidden input trick.
                             // Let's force check "Present" but maybe hide it? No confusing.
                             // Let's just assume `isPresent = true` when Break is On.
                             // We need to ensure `isPresent` value is sent as True.
                             // Solution: Check #statusPresent but maybe visual is tricky.
                             // Better: Just check #statusPresent.
                             $('#statusPresent').prop('checked', true);
                        }
                    });

                    // Validation on Change/Submit for Break Time
                    breakTimeField.on('change', function() {
                         var val = $(this).val();
                         var min = $(this).attr('min');
                         var max = $(this).attr('max');
                         if (val && (val < min || val > max)) {
                             alert('Giờ nghỉ phải nằm trong ca làm việc (' + min + ' - ' + max + ')');
                             $(this).val(''); // Reset invalid value
                         }
                    });

                    // Set ID cho các form hidden input
                    $('#attendanceScheduleId').val(eventObj.id);
                    $('#deleteScheduleId').val(eventObj.id);

                    // Mở Modal
                    $('#eventDetailModal').modal('show');
                }
            });
            calendar.render();
        });
    </script>
}

<!-- Modal Xếp lịch -->
<div class="modal fade" id="assignShiftModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm nhân viên vào ca</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="AssignShift" method="post">
                <div class="modal-body">
                    <input type="hidden" name="date" value="@currentDate.ToString("yyyy-MM-dd")" />
                    
                    <div class="form-group">
                        <label>Chọn Nhân viên</label>
                        <select name="employeeId" class="form-control" asp-items="ViewBag.Employees"></select>
                    </div>
                    
                    <div class="form-group">
                        <label>Chọn Ca làm việc</label>
                        <select name="shiftId" class="form-control" asp-items="ViewBag.Shifts"></select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Lưu lịch</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Chi tiết Lịch làm việc (Điểm danh / Hủy) -->
<div class="modal fade" id="eventDetailModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold" id="eventTitle">Chi tiết ca làm</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p><strong>Nhân viên: </strong> <span id="eventEmployeeName"></span></p>
                <p><strong>Ngày: </strong> <span id="eventDate"></span></p>
                <p><strong>Ca làm: </strong> <span id="eventShiftName"></span></p>
                <p><strong>Thời gian: </strong> <span id="eventTimeRange"></span></p>
                <p><strong>Trạng thái: </strong> <span id="eventStatusBadge"></span></p>
                
                <hr/>
                
                <!-- Option 1: Form Điểm danh & Ghi chú -->
                <form asp-action="UpdateAttendance" method="post" id="attendanceForm" class="mb-3">
                    <input type="hidden" name="scheduleId" id="attendanceScheduleId" />
                    <input type="hidden" name="returnDate" value="@currentDate.ToString("yyyy-MM-dd")" />
                    
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="isPresent" id="statusNotCheckedIn" value="false">
                        <label class="form-check-label text-secondary font-weight-bold" for="statusNotCheckedIn">
                            <i class="fas fa-history"></i> Chưa điểm danh / Reset
                        </label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="isPresent" id="statusPresent" value="true">
                        <label class="form-check-label text-success font-weight-bold" for="statusPresent">
                            <i class="fas fa-check-circle"></i> Đã có mặt
                        </label>
                    </div>
                    
                    <div class="form-check mb-2">
                         <input class="form-check-input" type="radio" name="isPresent" id="statusAbsent" value="false">
                        <label class="form-check-label text-danger font-weight-bold" for="statusAbsent">
                            <i class="fas fa-times-circle"></i> Vắng mặt / Xin nghỉ
                        </label>
                    </div>

                    <!-- Option 3: Nghỉ giữa ca -->
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="isOnBreak" id="statusBreak" value="true">
                        <label class="form-check-label text-warning font-weight-bold" for="statusBreak">
                            <i class="fas fa-coffee"></i> Nghỉ giữa ca
                        </label>
                    </div>

                    <!-- Giờ bắt đầu nghỉ (ẩn mặc định) -->
                    <div class="form-group ml-4" id="breakTimeGroup" style="display:none;">
                        <label class="small font-weight-bold">Giờ bắt đầu nghỉ:</label>
                        <input type="time" class="form-control form-control-sm" name="breakStartTime" id="breakStartTime">
                    </div>

                    <!-- Hidden input to handle IsOnBreak when radio is not checked, handled by JS -->
                    <input type="hidden" name="isOnBreakInput" id="isOnBreakInput" value="false">

                    <!-- Lý do vắng / Ghi chú -->
                    <div class="form-group mt-2" id="attendanceNoteGroup">
                        <label for="attendanceNote" class="small font-weight-bold">Lý do nghỉ / Ghi chú:</label>
                        <textarea class="form-control form-control-sm" name="note" id="attendanceNote" rows="2" placeholder="Nhập lý do vắng hoặc ghi chú..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block">Cập nhật trạng thái</button>
                </form>

                <!-- Option 2: Form Hủy Lịch -->
                <form asp-action="DeleteSchedule" method="post" style="border-top: 1px dashed #ccc; padding-top: 15px;">
                    <input type="hidden" name="scheduleId" id="deleteScheduleId" />
                    <input type="hidden" name="returnDate" value="@currentDate.ToString("yyyy-MM-dd")" />
                    <button type="submit" class="btn btn-outline-danger btn-sm float-right" onclick="return confirm('Bạn chắc chắn muốn hủy lịch làm việc này?');">
                        <i class="fas fa-trash"></i> Hủy lịch làm việc
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Quản lý Ca (Tạo & Xóa Ca) -->
<div class="modal fade" id="manageShiftsModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Quản lý Ca làm việc</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Form Tạo Ca Mới -->
                <h6 class="font-weight-bold">Tạo ca mới</h6>
                <form asp-action="CreateShift" method="post" class="form-inline mb-4">
                    <input type="hidden" name="returnDate" value="@currentDate.ToString("yyyy-MM-dd")" />
                    <input type="text" name="shiftName" class="form-control mr-2" placeholder="Tên ca (VD: Ca Sáng)" required />
                    <input type="time" name="startTime" class="form-control mr-2" required />
                    <span class="mr-2">-</span>
                    <input type="time" name="endTime" class="form-control mr-2" required />
                    <button type="submit" class="btn btn-success">Lưu mới</button>
                </form>

                <hr />

                <!-- Danh sách ca hiện có (để xóa) -->
                <h6 class="font-weight-bold">Danh sách ca hiện tại</h6>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Tên Ca</th>
                            <th>Giờ</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var shift in Model.Shifts)
                        {
                            <tr>
                                <td>@shift.ShiftName</td>
                                <td>@shift.TimeRange</td>
                                <td>
                                    <form asp-action="DeleteShift" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa ca này? (Chỉ xóa được nếu chưa có lịch làm việc)');">
                                        <input type="hidden" name="shiftId" value="@shift.ShiftId" />
                                        <input type="hidden" name="returnDate" value="@currentDate.ToString("yyyy-MM-dd")" />
                                        <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                 <p class="small text-muted font-italic">* Lưu ý: Chỉ có thể xóa ca khi không có nhân viên nào được xếp vào ca đó (trong bất kỳ ngày nào).</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>