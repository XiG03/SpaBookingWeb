# ==========================================
# SpaBookingWeb Environment Variables
# Hướng dẫn: Copy file này thành .env và điền thông tin thực tế
# ==========================================

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Production

# ==========================================
# SQL SERVER CONFIGURATION
# ==========================================
#DB_SERVER=sqlserver
#DB_PORT=1433
#DB_NAME=SpaBookingDb
#DB_USER=sa
#DB_PASSWORD=YourStrong@Password123!

# ==========================================
# DATABASE CONNECTION STRING (tự động tạo từ các biến trên)
# Format: Server=<DB_SERVER>,<DB_PORT>;Database=<DB_NAME>;User Id=<DB_USER>;Password=<DB_PASSWORD>;TrustServerCertificate=True;
# ==========================================
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=SpaBookingDb;User Id=sa;Password=YourStrong@Password123!;TrustServerCertificate=True;

# ==========================================
# GOOGLE OAUTH CONFIGURATION
# Hướng dẫn:
# 1. Vào https://console.cloud.google.com
# 2. Tạo OAuth 2.0 credentials (Web Application)
# 3. Thêm Authorized redirect URIs: https://yourdomain.com/signin-google
# ==========================================
Authentication__Google__ClientId=YOUR_GOOGLE_CLIENT_ID_HERE
Authentication__Google__ClientSecret=YOUR_GOOGLE_CLIENT_SECRET_HERE

# ==========================================
# EMAIL CONFIGURATION (Gmail)
# Hướng dẫn:
# 1. Bật 2FA trên Gmail
# 2. Tạo App Password: https://myaccount.google.com/apppasswords
# 3. Sử dụng App Password (16 ký tự) thay vì mật khẩu Gmail
# ==========================================
EmailSettings__MailServer=smtp.gmail.com
EmailSettings__MailPort=587
EmailSettings__SenderName=Spa Booking Website
EmailSettings__SenderEmail=your-email@gmail.com
EmailSettings__Password=xxxx xxxx xxxx xxxx

# ==========================================
# ATTENDANCE SETTINGS
# ==========================================
AttendanceSettings__AllowedIPs=::1;127.0.0.1;192.168.1.0/24

# ==========================================
# CORS & SECURITY (cho Production)
# ==========================================
AllowedHosts=yourdomain.com,www.yourdomain.com,api.yourdomain.com

# ==========================================
# LOGGING
# ==========================================
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# ==========================================
# OPTIONAL: HTTPS/SSL
# ==========================================
# ASPNETCORE_URLS=https://+:8443;http://+:8080
# ASPNETCORE_Kestrel__Certificates__Default__Path=/app/certs/certificate.pfx
# ASPNETCORE_Kestrel__Certificates__Default__Password=cert_password
